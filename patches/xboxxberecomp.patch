+    std::vector<PsoKey> pso_loaded(hdr.pso_count);
+    if (hdr.src_count && std::fread(src_loaded.data(), sizeof(SrcMetaEntry), hdr.src_count, f) != hdr.src_count) ok = false;
+    if (ok && hdr.pso_count && std::fread(pso_loaded.data(), sizeof(PsoKey), hdr.pso_count, f) != hdr.pso_count) ok = false;
+    std::fclose(f);
+    if (!ok) return;
