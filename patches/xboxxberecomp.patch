+bool D3D12Backend::CreateOrLoadPso(const wchar_t* name, const D3D12_GRAPHICS_PIPELINE_STATE_DESC& d,
+                                   ComPtr<ID3D12PipelineState>& out) {
+    if (cache_enabled_ && pso_lib_) {
+        std::lock_guard<std::mutex> lock(cache_lock_);
+        if (SUCCEEDED(pso_lib_->LoadGraphicsPipeline(name, &d, IID_PPV_ARGS(&out)))) {
+            if (perf::Enabled()) perf::RecordPsoCacheHit();
+            return true;
+        }
+    }
+    auto pt0 = perf::Enabled() ? PerfClock::now() : PerfClock::time_point{};
+    HRESULT hr = dev_->CreateGraphicsPipelineState(&d, IID_PPV_ARGS(&out));
+    if (perf::Enabled()) perf::RecordPsoCreate(PerfMs(pt0));
+    if (FAILED(hr)) return false;
+    if (cache_enabled_ && pso_lib_) {
+        std::lock_guard<std::mutex> lock(cache_lock_);
+        HRESULT shr = pso_lib_->StorePipeline(name, out.Get());
+        if (SUCCEEDED(shr)) {
+            pso_dirty_ = true;
+            cache_dirty_frame_ = presents_;
+        }
+    }
+    return true;
+}
