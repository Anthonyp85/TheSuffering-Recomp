+    const wchar_t* p = cmd;
+    while (*p) {
+        while (*p && std::iswspace(*p)) ++p;
+        if (!*p) break;
+        std::wstring arg;
+        bool in_quotes = false;
+        while (*p && (in_quotes || !std::iswspace(*p))) {
+            if (*p == L'"') in_quotes = !in_quotes;
+            else arg.push_back(*p);
+            ++p;
+        }
+        args.push_back(std::move(arg));
+    }
