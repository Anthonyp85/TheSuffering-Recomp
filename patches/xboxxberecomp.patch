+        pk.quad = ps.quad ? 1u : 0u;
+        uint64_t key = Hash(&pk, sizeof(pk)) ^ pixel_key_salt;
+        if (seen.insert(key).second) {
+            out.push_back(ShaderPrewarmItem{key, true, PixelHlsl(pk)});
+        }
+    }
+    return out;
+}
