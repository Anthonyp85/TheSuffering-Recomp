+    std::map<std::string, uint32_t> functions = cfg.symbols;
+    functions.insert(cfg.names.begin(), cfg.names.end());
+    std::map<uint32_t, std::string> named;
+    std::set<std::string> export_funcs;
+    uint32_t absent_idx = 0;
+    std::string ids;
+    for (auto& [name, va] : functions) {
+        uint32_t a = va ? va : 0xFFFF0000u + absent_idx++;
+        syms += fmt("#define SYM_%s %08X\n#define HAS_%s %d\n", name.c_str(), a, name.c_str(), va ? 1 : 0);
+        if (cfg.named) {
+            auto [at, fresh] = named.emplace(a, name);
+            if (!fresh) {
+                std::fprintf(stderr, "[xbe] named: %s and %s are one function, %08X\n", at->second.c_str(), name.c_str(), a);
+                return false;
+            }
+            ids += " \\\n\tX(" + name + ")";
+            export_funcs.insert("sub_" + name);
+        } else {
+            export_funcs.insert(fmt("sub_%08X", a));
+        }
+    }
+    for (auto& [va, _] : cfg.functions) {
+        if (!cfg.named) export_funcs.insert(fmt("sub_%08X", va));
+    }
+    for (auto& [name, va] : cfg.data) {
+        syms += fmt("#define SYM_%s %08X\n#define HAS_%s %d\n", name.c_str(), va, name.c_str(), va ? 1 : 0);
+        ids += " \\\n\tX(" + name + ")";
+    }
+    if (cfg.named) syms += "#define IMAGE_NAMED 1\n#define IMAGE_SYMBOLS(X)" + ids + "\n";
+    for (auto& [name, v] : cfg.layout) syms += fmt("#define XDK_%s 0x%X\n", name.c_str(), v);
+    if (!cfg.abi.empty()) {
+        syms += "#define IMAGE_ABI(X)";
+        for (auto& [name, locs] : cfg.abi) {
+            syms += " \\\n\tX(" + name;
+            for (auto& l : locs) syms += ", " + l;
+            syms += ")";
+        }
+        syms += "\n";
+    }
+    WriteIfChangedFile(out_dir / "image_symbols.h", syms);
+
+    std::map<std::string, bool> hooks;
+    for (auto& [va, h] : cfg.hooks) hooks.emplace(h.call, h.Returns());
+    std::string hook_exports = "#pragma once\n";
+    if (!hooks.empty()) {
+        hook_exports += "#ifdef _WIN32\n";
+        for (auto& [name, returns] : hooks) {
+            const char* result = returns ? "_N" : "X";
+            hook_exports += fmt("#pragma comment(linker, \"/EXPORT:?%s@@YA%sAEAUX86Context@@PEAE@Z\")\n", name.c_str(), result);
+        }
+        hook_exports += "#endif\n";
+    }
+    WriteIfChangedFile(out_dir / "hook_exports.h", hook_exports);
+
+    // Scan src/ for explicit X86_EXTERN_FUNC(__imp__sub_... / sub_...) references so Windows code.lib links without an XBE
+    std::error_code ec;
+    fs::path src_dir = root / "src";
+    if (fs::is_directory(src_dir, ec)) {
+        for (auto& entry : fs::recursive_directory_iterator(src_dir, ec)) {
+            if (!entry.is_regular_file(ec)) continue;
+            std::string ext = entry.path().extension().string();
+            if (ext != ".cpp" && ext != ".h" && ext != ".hpp") continue;
+            std::ifstream f(entry.path(), std::ios::binary);
+            if (!f) continue;
+            std::string text((std::istreambuf_iterator<char>(f)), {});
+            const std::string needle = "X86_EXTERN_FUNC(";
+            for (size_t pos = 0; (pos = text.find(needle, pos)) != std::string::npos; pos += needle.size()) {
+                size_t start = pos + needle.size();
+                while (start < text.size() && std::isspace(static_cast<unsigned char>(text[start]))) ++start;
+                size_t end = text.find(')', start);
+                if (end == std::string::npos) break;
+                std::string tok = text.substr(start, end - start);
+                while (!tok.empty() && std::isspace(static_cast<unsigned char>(tok.back()))) tok.pop_back();
+                if (tok.rfind("__imp__", 0) == 0) tok = tok.substr(7);
