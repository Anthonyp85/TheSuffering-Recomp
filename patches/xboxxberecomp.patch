+#ifdef _WIN32
+void ApplyWinPriority(uint32_t host_tid, uint32_t guest_id, int prio) {
+    if (!host_tid) return;
+    int win_prio = THREAD_PRIORITY_NORMAL;
+    if (app::kGame.single_core_guest) {
+        // Strict monotonic Xbox priority hierarchy on the pinned single guest core:
+        //   prio >= +2 (+2 HIGHEST, +16 TIME_CRITICAL) -> TIME_CRITICAL (15)
+        //   prio == +1 (e.g. Surreal SRSC streaming worker) -> HIGHEST (10)
+        //   prio ==  0 main guest thread (active frame progress) -> ABOVE_NORMAL (9)
+        //   prio ==  0 unboosted main / background guest worker -> NORMAL (8)
+        //   prio == -1 -> BELOW_NORMAL (7), <= -2 -> LOWEST (6), <= -15 -> IDLE (1)
+        // Keep NT dynamic priority boost disabled on all single-core guest threads so wait
+        // completions on the main thread never temporarily boost it above +1 streaming workers.
+        if (prio >= 2) {
+            win_prio = THREAD_PRIORITY_TIME_CRITICAL;
+        } else if (prio == 1) {
+            win_prio = THREAD_PRIORITY_HIGHEST;
+        } else if (prio == 0) {
+            bool is_main = (guest_id != 0 && guest_id == g_main_guest_tid.load(std::memory_order_acquire));
+            bool boosted = is_main && g_main_boosted.load(std::memory_order_acquire);
+            win_prio = boosted ? THREAD_PRIORITY_ABOVE_NORMAL : THREAD_PRIORITY_NORMAL;
+        } else if (prio == -1) {
+            win_prio = THREAD_PRIORITY_BELOW_NORMAL;
+        } else if (prio <= -15) {
+            win_prio = THREAD_PRIORITY_IDLE;
+        } else {
+            win_prio = THREAD_PRIORITY_LOWEST;
+        }
+    } else {
+        if (prio >= 2) win_prio = THREAD_PRIORITY_TIME_CRITICAL;
+        else if (prio == 1) win_prio = THREAD_PRIORITY_HIGHEST;
+        else if (prio == -1) win_prio = THREAD_PRIORITY_BELOW_NORMAL;
+        else if (prio <= -15) win_prio = THREAD_PRIORITY_IDLE;
+        else if (prio <= -2) win_prio = THREAD_PRIORITY_LOWEST;
+    }
+    if (HANDLE h = OpenThread(THREAD_SET_INFORMATION, FALSE, host_tid)) {
+        SetThreadPriority(h, win_prio);
+        if (app::kGame.single_core_guest) SetThreadPriorityBoost(h, TRUE);
+        ::CloseHandle(h);
+    }
+}
+#else
+std::atomic<int> g_linux_nice_shift{0};
+
+int LinuxNiceForPrio(int prio, int shift, bool is_main, bool main_boosted) {
+    if (app::kGame.single_core_guest) {
+        if (shift > 0) {
+            // Unprivileged Linux (no CAP_SYS_NICE): keep prio >= +1 workers and the main thread
+            // at nice 0 (never penalize +1 streaming workers behind main, and keep main at nice 0
+            // so child pthreads spawned by main do not inherit a raised nice ceiling).
+            if (prio >= 1 || is_main) return 0;
+            if (prio == 0) return std::min(shift, 19);
+            if (prio == -1) return std::min(shift * 2, 19);
+            if (prio <= -15) return 19;
+            return std::min(shift * 3, 19);
+        }
+        // Privileged Linux: strict Xbox ordering (-8 < -5 < -2 < 0 < 5 < 10 < 19)
+        if (prio >= 2) return -8;
+        if (prio == 1) return -5;
+        if (prio == 0) return (is_main && main_boosted) ? -2 : 0;
+        if (prio == -1) return 5;
+        if (prio <= -15) return 19;
+        return 10;
+    }
+    if (shift > 0) {
+        if (prio >= 1) return 0;
+        if (prio == 0) return shift;
+        if (prio == -1) return shift + 5;
+        if (prio <= -15) return 19;
+        return std::min(shift + 10, 19);
+    }
