+void D3D12Backend::DrainAsyncPrewarm(bool wait) {
+    if (!async_pw_running_.load(std::memory_order_acquire)) return;
+    if (wait && async_pw_thread_.joinable()) async_pw_thread_.join();
+
+    std::vector<AsyncReadyShader> ready;
+    {
+        std::lock_guard<std::mutex> lock(async_pw_mtx_);
+        ready.swap(async_pw_ready_);
+    }
+    for (auto& r : ready) {
+        if (!r.blob) continue;
+        bool new_blob = !blobs_.count(r.blob_hash) || !blobs_[r.blob_hash];
+        if (new_blob) blobs_[r.blob_hash] = r.blob;
+        shader_src_[r.src_key] = r.blob_hash;
+        if (new_blob) {
+            ++async_pw_compiled_;
+            g_warmup_compiled_new.fetch_add(1u, std::memory_order_relaxed);
+        }
+        if (cache_enabled_) {
+            std::lock_guard<std::mutex> lock(cache_lock_);
+            if (new_blob) {
+                const uint8_t* ptr = static_cast<const uint8_t*>(r.blob->GetBufferPointer());
+                shader_cache_entries_.emplace_back(r.blob_hash, std::vector<uint8_t>(ptr, ptr + r.blob->GetBufferSize()));
+                shaders_dirty_ = true;
+            }
+            if (known_src_keys_.insert(r.src_key).second) {
+                src_meta_entries_.push_back(SrcMetaEntry{r.src_key, r.blob_hash});
+                meta_dirty_ = true;
+            }
+            cache_dirty_frame_ = presents_;
+        }
+    }
+
+    if (wait || async_pw_done_flag_.load(std::memory_order_acquire)) {
+        if (async_pw_thread_.joinable()) async_pw_thread_.join();
+        std::vector<AsyncReadyShader> tail;
+        {
+            std::lock_guard<std::mutex> lock(async_pw_mtx_);
+            tail.swap(async_pw_ready_);
+        }
+        for (auto& r : tail) {
+            if (!r.blob) continue;
+            bool new_blob = !blobs_.count(r.blob_hash) || !blobs_[r.blob_hash];
+            if (new_blob) blobs_[r.blob_hash] = r.blob;
+            shader_src_[r.src_key] = r.blob_hash;
+            if (new_blob) {
+                ++async_pw_compiled_;
+                g_warmup_compiled_new.fetch_add(1u, std::memory_order_relaxed);
+            }
+            if (cache_enabled_) {
+                std::lock_guard<std::mutex> lock(cache_lock_);
+                if (new_blob) {
+                    const uint8_t* ptr = static_cast<const uint8_t*>(r.blob->GetBufferPointer());
+                    shader_cache_entries_.emplace_back(r.blob_hash,
+                                                       std::vector<uint8_t>(ptr, ptr + r.blob->GetBufferSize()));
+                    shaders_dirty_ = true;
+                }
+                if (known_src_keys_.insert(r.src_key).second) {
+                    src_meta_entries_.push_back(SrcMetaEntry{r.src_key, r.blob_hash});
+                    meta_dirty_ = true;
+                }
+                cache_dirty_frame_ = presents_;
+            }
+        }
+        for (const auto& [skey, bhash] : async_pw_links_) {
+            auto bit = blobs_.find(bhash);
+            if (bit != blobs_.end() && bit->second && !shader_src_.count(skey)) {
+                shader_src_[skey] = bhash;
+                if (cache_enabled_) {
+                    std::lock_guard<std::mutex> lock(cache_lock_);
+                    if (known_src_keys_.insert(skey).second) {
+                        src_meta_entries_.push_back(SrcMetaEntry{skey, bhash});
+                        meta_dirty_ = true;
+                    }
+                }
+            }
+        }
+        async_pw_links_.clear();
+        async_pw_running_.store(false, std::memory_order_release);
+        size_t deferred_built = BuildDeferredPsos();
+        double ms = PerfMs(async_pw_t0_);
+        g_warmup_elapsed_us.fetch_add(uint64_t(ms * 1000.0), std::memory_order_relaxed);
+        g_warmup_active.store(false, std::memory_order_release);
+        g_warmup_completed.store(true, std::memory_order_release);
+        g_warmup_completed_ms.store(NowMonoMs(), std::memory_order_release);
+        if (async_pw_compiled_ > 0 || deferred_built > 0) {
+            LOGR("d3d12: guest shader prewarm done in %.1f ms (async, vs_in=%zu, ps_in=%zu, compiled_new=%zu, deferred_psos=%zu, total_shaders=%zu)",
+                 ms, async_pw_vs_in_, async_pw_ps_in_, async_pw_compiled_, deferred_built,
+                 shader_cache_entries_.size());
+            SaveCaches(false, !frame_camera_.is_3d_gameplay);
+        }
+        PublishCacheStats();
+    }
+}
+
+void D3D12Backend::StopAsyncPrewarm() {
+    if (!async_pw_running_.load(std::memory_order_acquire) && !async_pw_thread_.joinable()) return;
+    async_pw_stop_.store(true, std::memory_order_release);
+    DrainAsyncPrewarm(true);
+    async_pw_stop_.store(false, std::memory_order_release);
+}
+
+void D3D12Backend::PrewarmGuestShaders(const std::vector<VertexShader>& vs_list,
+                                       const std::vector<PixelShader>& ps_list) {
+    if (vs_list.empty() && ps_list.empty()) return;
+    if (async_pw_running_.load(std::memory_order_acquire)) DrainAsyncPrewarm(true);
+    constexpr uint64_t kSalt = 0x9E3779B97F4A7C15ull;
+    auto t0 = PerfClock::now();
+    auto batch = BuildGuestShaderPrewarmBatch(vs_list, ps_list, kSalt);
+
+    // Check how many shaders actually need compilation vs already cached in blobs_
+    struct AsyncWorkItem {
+        uint64_t src_key = 0;
+        uint64_t blob_hash = 0;
+        bool is_pixel = false;
+        std::string hlsl;
+    };
+    std::vector<AsyncWorkItem> work;
+    std::unordered_set<uint64_t> queued_blobs;
+    std::vector<std::pair<uint64_t, uint64_t>> cached_links;
+    std::vector<std::pair<uint64_t, uint64_t>> secondary_links;
+
+    for (auto& item : batch) {
+        if (shader_src_.count(item.src_key)) continue;
+        const char* profile = item.is_pixel ? "ps_5_0" : "vs_5_0";
+        uint64_t pseed = Hash(profile, std::strlen(profile));
+        uint64_t eseed = Hash("main", 4, pseed);
+        uint64_t bhash = Hash(item.hlsl.data(), item.hlsl.size(), eseed);
+        auto bit = blobs_.find(bhash);
+        if (bit != blobs_.end() && bit->second) {
+            cached_links.emplace_back(item.src_key, bhash);
+            continue;
+        }
+        if (queued_blobs.insert(bhash).second) {
+            work.push_back(AsyncWorkItem{item.src_key, bhash, item.is_pixel, std::move(item.hlsl)});
+        } else {
+            secondary_links.emplace_back(item.src_key, bhash);
+        }
+    }
+
+    for (const auto& [skey, bhash] : cached_links) {
+        shader_src_[skey] = bhash;
+        if (cache_enabled_) {
+            std::lock_guard<std::mutex> lock(cache_lock_);
+            if (known_src_keys_.insert(skey).second) {
+                src_meta_entries_.push_back(SrcMetaEntry{skey, bhash});
+                meta_dirty_ = true;
+                cache_dirty_frame_ = presents_;
+            }
+        }
+    }
+
+    bool sync_mode = !cli_cap_bmp_.empty() || app::IsReplayOrAutotestActive() || work.size() <= 32;
+    if (!work.empty() && !sync_mode) {
+        g_warmup_active.store(true, std::memory_order_release);
+        g_warmup_total.fetch_add(uint32_t(work.size()), std::memory_order_relaxed);
+        async_pw_t0_ = t0;
+        async_pw_vs_in_ = vs_list.size();
+        async_pw_ps_in_ = ps_list.size();
+        async_pw_compiled_ = 0;
+        async_pw_links_ = std::move(secondary_links);
+        async_pw_done_flag_.store(false, std::memory_order_release);
+        async_pw_stop_.store(false, std::memory_order_release);
+        async_pw_running_.store(true, std::memory_order_release);
+
+        uint32_t max_jobs = std::max<uint32_t>(1u, app::RecommendedCompileJobs());
+        uint32_t n_threads = std::min<uint32_t>({10u, max_jobs, uint32_t(work.size())});
+        async_pw_thread_ = std::thread([this, wlist = std::move(work), n_threads]() {
+            std::atomic<size_t> cursor{0};
+            auto worker = [&] {
+                for (;;) {
+                    if (async_pw_stop_.load(std::memory_order_relaxed)) break;
+                    size_t idx = cursor.fetch_add(1, std::memory_order_relaxed);
+                    if (idx >= wlist.size()) break;
+                    const auto& w = wlist[idx];
+                    const char* profile = w.is_pixel ? "ps_5_0" : "vs_5_0";
+                    ComPtr<ID3DBlob> code;
+                    ComPtr<ID3DBlob> err;
+                    HRESULT hr = D3DCompile(w.hlsl.data(), w.hlsl.size(), nullptr, nullptr, nullptr, "main", profile,
+                                            D3DCOMPILE_OPTIMIZATION_LEVEL1, 0, &code, &err);
+                    if (SUCCEEDED(hr) && code && code->GetBufferSize() > 0) {
+                        std::lock_guard<std::mutex> lock(async_pw_mtx_);
+                        async_pw_ready_.push_back(AsyncReadyShader{w.src_key, w.blob_hash, std::move(code)});
+                    }
+                    g_warmup_done.fetch_add(1u, std::memory_order_relaxed);
+                }
+            };
+            std::vector<std::thread> pool;
+            pool.reserve(n_threads > 1 ? n_threads - 1 : 0);
+            for (uint32_t t = 1; t < n_threads; ++t) pool.emplace_back(worker);
+            worker();
+            for (auto& th : pool) th.join();
+            async_pw_done_flag_.store(true, std::memory_order_release);
+        });
+        return;
+    }
+
+    size_t compiled = 0;
+    if (!work.empty()) {
