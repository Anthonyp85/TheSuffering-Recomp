+VkImageView VulkanBackend::CreateImageView(VkImage img, VkImageViewType view_type, VkFormat fmt,
+                                           VkImageAspectFlags aspect, uint32_t mips, uint32_t layers) {
+    VkImageViewCreateInfo vi{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    vi.image = img;
+    vi.viewType = view_type;
+    vi.format = fmt;
+    vi.subresourceRange = {aspect, 0, mips, 0, layers};
+    VkImageView v = VK_NULL_HANDLE;
+    vk_.create_img_view(dev_, &vi, nullptr, &v);
+    return v;
+}
+
+void VulkanBackend::FreeDeferred(std::vector<DeferredDestroy>& list) {
+    for (auto& d : list) {
+        if (d.fb != VK_NULL_HANDLE) vk_.destroy_fb(dev_, d.fb, nullptr);
+        if (d.view != VK_NULL_HANDLE) vk_.destroy_img_view(dev_, d.view, nullptr);
+        if (d.img != VK_NULL_HANDLE) vk_.destroy_img(dev_, d.img, nullptr);
+        if (d.buf != VK_NULL_HANDLE) vk_.destroy_buf(dev_, d.buf, nullptr);
+        if (d.mem != VK_NULL_HANDLE) vk_.free_mem(dev_, d.mem, nullptr);
+        if (d.slab_id != UINT32_MAX) FreeSlabRange(d.slab_id, d.slab_off, d.slab_size);
+    }
+    list.clear();
+}
+
+bool VulkanBackend::CreateFrames() {
+    VkSemaphoreTypeCreateInfo tci{VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO};
+    tci.semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE;
+    tci.initialValue = 0;
+    VkSemaphoreCreateInfo sci{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO, &tci};
+    if (vk_.create_sem(dev_, &sci, nullptr, &timeline_sem_) != VK_SUCCESS) return false;
+
+    for (int i = 0; i < kFrames; ++i) {
+        VkSemaphoreCreateInfo bsi{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+        if (vk_.create_sem(dev_, &bsi, nullptr, &img_avail_sems_[i]) != VK_SUCCESS) return false;
+    }
+
+    static constexpr uint64_t kSizes[] = {64ull << 20, 32ull << 20, 16ull << 20, 8ull << 20};
+    VkBufferUsageFlags up_usage = VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_VERTEX_BUFFER_BIT |
+                                  VK_BUFFER_USAGE_INDEX_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    VkMemoryPropertyFlags up_props = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+
+    bool allocated = false;
+    for (uint64_t try_sz : kSizes) {
+        if (try_sz > upload_size_) continue;
+        bool ok = true;
+        for (auto& f : frames_) {
+            if (f.upload_buf != VK_NULL_HANDLE) { vk_.destroy_buf(dev_, f.upload_buf, nullptr); f.upload_buf = VK_NULL_HANDLE; }
+            if (f.upload_mem != VK_NULL_HANDLE) { vk_.free_mem(dev_, f.upload_mem, nullptr); f.upload_mem = VK_NULL_HANDLE; }
+            f.map = nullptr;
+            if (!CreateBuffer(try_sz, up_usage, up_props, f.upload_buf, f.upload_mem, &f.map)) {
+                ok = false;
+                break;
+            }
+        }
+        if (ok) {
+            upload_size_ = try_sz;
+            upload_reserve_ = std::max<uint64_t>(1ull << 20, try_sz / 8);
+            caps_.upload_ring_bytes = upload_size_;
+            {
+                std::lock_guard<std::mutex> lock(g_caps_lock);
+                g_gpu_caps.upload_ring_bytes = upload_size_;
+            }
+            allocated = true;
+            break;
+        }
+    }
+    if (!allocated) return false;
+
+    VkDescriptorPoolSize psizes[3] = {
+        {VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC, kDescSetsPerFrame * 2},
+        {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, kDescSetsPerFrame * 4},
+        {VK_DESCRIPTOR_TYPE_SAMPLER, kDescSetsPerFrame * 4},
+    };
+    for (auto& f : frames_) {
+        VkCommandPoolCreateInfo cpci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+        cpci.flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT;
+        cpci.queueFamilyIndex = queue_family_;
+        if (vk_.create_cmd_pool(dev_, &cpci, nullptr, &f.cmd_pool) != VK_SUCCESS) return false;
+        VkCommandBufferAllocateInfo cbai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+        cbai.commandPool = f.cmd_pool;
+        cbai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        cbai.commandBufferCount = 1;
+        if (vk_.alloc_cmd_bufs(dev_, &cbai, &f.cmd) != VK_SUCCESS) return false;
+
+        VkDescriptorPoolCreateInfo dpci{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+        dpci.maxSets = kDescSetsPerFrame;
+        dpci.poolSizeCount = 3;
+        dpci.pPoolSizes = psizes;
+        if (vk_.create_desc_pool(dev_, &dpci, nullptr, &f.desc_pool) != VK_SUCCESS) return false;
+    }
+    cmd_ = frames_[0].cmd;
+    return true;
+}
+
+bool VulkanBackend::CreateDummyTextures() {
+    auto make = [&](DummyTex& d, VkImageType type, VkImageViewType vtype, VkFormat fmt, uint32_t layers,
+                    VkImageCreateFlags flags, VkImageAspectFlags aspect, VkImageUsageFlags usage) -> bool {
+        if (!CreateImage(1, 1, 1, layers, 1, fmt, type, flags, usage, d.img, d.mem)) return false;
+        d.view = CreateImageView(d.img, vtype, fmt, aspect, 1, layers);
+        return d.view != VK_NULL_HANDLE;
+    };
+    return make(dummy_2d_, VK_IMAGE_TYPE_2D, VK_IMAGE_VIEW_TYPE_2D, VK_FORMAT_B8G8R8A8_UNORM, 1, 0,
+                VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT) &&
+           make(dummy_3d_, VK_IMAGE_TYPE_3D, VK_IMAGE_VIEW_TYPE_3D, VK_FORMAT_B8G8R8A8_UNORM, 1, 0,
+                VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT) &&
+           make(dummy_cube_, VK_IMAGE_TYPE_2D, VK_IMAGE_VIEW_TYPE_CUBE, VK_FORMAT_B8G8R8A8_UNORM, 6,
+                VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT, VK_IMAGE_ASPECT_COLOR_BIT,
+                VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT) &&
+           make(dummy_depth_2d_, VK_IMAGE_TYPE_2D, VK_IMAGE_VIEW_TYPE_2D, depth_fmt_, 1, 0, VK_IMAGE_ASPECT_DEPTH_BIT,
+                VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT);
+}
+
+bool VulkanBackend::CreateGammaLut() {
+    if (!CreateImage(256, 1, 1, 1, 1, VK_FORMAT_B8G8R8A8_UNORM, VK_IMAGE_TYPE_2D, 0,
+                     VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT, lut_img_, lut_mem_)) {
+        return false;
+    }
+    lut_view_ = CreateImageView(lut_img_, VK_IMAGE_VIEW_TYPE_2D, VK_FORMAT_B8G8R8A8_UNORM, VK_IMAGE_ASPECT_COLOR_BIT);
+    lut_layout_ = VK_IMAGE_LAYOUT_UNDEFINED;
+    return lut_view_ != VK_NULL_HANDLE;
+}
+
+bool VulkanBackend::CreateQueries() {
+    VkQueryPoolCreateInfo oci{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+    oci.queryType = VK_QUERY_TYPE_OCCLUSION;
+    oci.queryCount = kQueries;
+    if (vk_.create_query_pool(dev_, &oci, nullptr, &occ_pool_) == VK_SUCCESS) {
+        uint8_t* mapped = nullptr;
+        if (CreateBuffer(uint64_t(kQueries) * sizeof(uint64_t), VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                         VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT |
+                             VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+                         occ_rb_, occ_rb_mem_, &mapped, &occ_coherent_)) {
+            occ_counts_ = reinterpret_cast<const uint64_t*>(mapped);
+        }
+    }
+    if (phys_props_.limits.timestampComputeAndGraphics && phys_props_.limits.timestampPeriod > 0.0f) {
+        VkQueryPoolCreateInfo tci{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+        tci.queryType = VK_QUERY_TYPE_TIMESTAMP;
+        tci.queryCount = uint32_t(kFrames * 2);
+        vk_.create_query_pool(dev_, &tci, nullptr, &ts_pool_);
+    }
+    return true;
+}
+
+bool VulkanBackend::InitImGui() {
+    VkDescriptorPoolSize pool_sizes[] = {
+        {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 64},
+    };
+    VkDescriptorPoolCreateInfo pci{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    pci.flags = VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT;
+    pci.maxSets = 64;
+    pci.poolSizeCount = 1;
+    pci.pPoolSizes = pool_sizes;
+    if (vk_.create_desc_pool(dev_, &pci, nullptr, &ui_pool_) != VK_SUCCESS) return false;
+
+    g_imgui_vk_loader = {vk_.get_inst_proc, instance_};
+    if (!ImGui_ImplVulkan_LoadFunctions(ImGuiVkLoadFunc, nullptr)) {
+        LOGE("vulkan: ImGui_ImplVulkan_LoadFunctions failed");
+        return false;
+    }
+
+    ImGui_ImplVulkan_InitInfo ii{};
+    ii.Instance = instance_;
+    ii.PhysicalDevice = phys_;
+    ii.Device = dev_;
+    ii.QueueFamily = queue_family_;
+    ii.Queue = queue_;
+    ii.DescriptorPool = ui_pool_;
+    ii.RenderPass = present_rp_;
+    ii.MinImageCount = uint32_t(std::max<size_t>(2, swap_images_.size()));
+    ii.ImageCount = uint32_t(std::max<size_t>(2, swap_images_.size()));
+    ii.MSAASamples = VK_SAMPLE_COUNT_1_BIT;
+    ii.PipelineCache = pipe_cache_;
+    if (!ImGui_ImplVulkan_Init(&ii)) {
+        LOGE("vulkan: ImGui_ImplVulkan_Init failed");
+        return false;
+    }
+    imgui_inited_ = true;
+    return true;
+}
+
+void VulkanBackend::ParseCaptureCli() {
+    auto args = ReadProcCmdline();
+    for (size_t i = 1; i < args.size(); ++i) {
+        const std::string& a = args[i];
+        auto take = [&](const char* flag, std::string& val) -> bool {
+            size_t n = std::strlen(flag);
+            if (a == flag && i + 1 < args.size()) {
+                val = args[++i];
+                return true;
+            }
+            if (a.size() > n + 1 && a.compare(0, n, flag) == 0 && a[n] == '=') {
+                val = a.substr(n + 1);
+                return true;
+            }
+            return false;
+        };
+        std::string v;
+        if (take("--capture-bmp", v)) cli_cap_bmp_ = std::filesystem::path(v);
+        else if (take("--capture-at-gframe", v)) cli_cap_at_gframe_ = uint32_t(std::max(0, std::atoi(v.c_str())));
+        else if (take("--capture-after-frames", v)) cli_cap_after_frames_ = uint64_t(std::max(0, std::atoi(v.c_str())));
+        else if (take("--capture-after-3d-frames", v))
+            cli_cap_after_3d_frames_ = uint64_t(std::max(0, std::atoi(v.c_str())));
+        else if (take("--capture-min-3d-ms", v))
+            cli_cap_min_3d_ms_ = double(std::max(0, std::atoi(v.c_str())));
+        else if (a == "--capture-exit") cli_cap_exit_ = true;
+    }
+}
+
+void VulkanBackend::ComputeRenderExtents(uint32_t& out_rw, uint32_t& out_rh, uint32_t& out_vpx, uint32_t& out_vpy,
+                                         uint32_t& out_vpw, uint32_t& out_vph) const {
+    bool wide = app::Widescreen();
+    float aspect = wide ? 16.0f / 9.0f : 4.0f / 3.0f;
+    float w = float(std::max(bb_w_, 1u));
+    float h = float(std::max(bb_h_, 1u));
+    float vw = std::min(w, h * aspect);
+    float vh = vw / aspect;
+    out_vpw = std::max(1u, uint32_t(std::lround(vw)));
+    out_vph = std::max(1u, uint32_t(std::lround(vh)));
+    out_vpx = (bb_w_ > out_vpw) ? (bb_w_ - out_vpw) / 2u : 0u;
+    out_vpy = (bb_h_ > out_vph) ? (bb_h_ - out_vph) / 2u : 0u;
+
+    const app::Settings& s = app::Get();
+    if (Upscaler* u = g_upscaler.load(std::memory_order_acquire); u && upscaler_inited_) {
+        u->ResolveRenderSize(out_vpw, out_vph, guest_w_, guest_h_, wide, out_rw, out_rh);
+    } else {
+        float factor = std::clamp(float(s.render_percent) / 100.0f, 0.33f, 2.0f);
+        if (s.aspect_correct_render) {
+            out_rw = std::max(320u, uint32_t(std::lround(out_vpw * factor)) & ~1u);
+            out_rh = std::max(240u, uint32_t(std::lround(out_vph * factor)) & ~1u);
+        } else {
+            float sc = std::max((out_vph * factor) / float(guest_h_), 0.5f);
+            out_rw = std::max(320u, uint32_t(std::lround(guest_w_ * sc)) & ~1u);
+            out_rh = std::max(240u, uint32_t(std::lround(guest_h_ * sc)) & ~1u);
+        }
+    }
+    out_rw = std::max(320u, out_rw & ~1u);
+    out_rh = std::max(240u, out_rh & ~1u);
+}
+
+void VulkanBackend::InitUpscaler() {
+    Upscaler* u = g_upscaler.load(std::memory_order_acquire);
+    if (!u) return;
+    UpscalerInitDesc desc{};
+    desc.device = reinterpret_cast<void*>(dev_);
+    desc.queue = reinterpret_cast<void*>(phys_);
+    desc.cmd_list = reinterpret_cast<void*>(cmd_);
+    desc.caps = caps_;
+    desc.host.ctx = this;
+    desc.host.transition = [](void* ctx, void* res, uint32_t* cur_state, uint32_t want_state) {
+        auto* self = static_cast<VulkanBackend*>(ctx);
+        if (!res || !cur_state) return;
+        VkImageLayout st = static_cast<VkImageLayout>(*cur_state);
+        self->TransitionImage(reinterpret_cast<VkImage>(res), st, static_cast<VkImageLayout>(want_state),
+                              VK_IMAGE_ASPECT_COLOR_BIT);
+        *cur_state = uint32_t(st);
+    };
+    desc.host.compile = [](void* ctx, const std::string& src, const char* entry, const char* profile,
+                           uint64_t* out_hash) -> void* {
+        auto* self = static_cast<VulkanBackend*>(ctx);
+        uint64_t h = 0;
+        VkShaderModule mod = self->Compile(src, entry, profile, h);
+        if (out_hash) *out_hash = h;
+        return reinterpret_cast<void*>(mod);
+    };
+    desc.host.create_or_load_compute_pso = [](void* ctx, const wchar_t* /*name*/, const void* d, void** out_pso) -> bool {
+        auto* self = static_cast<VulkanBackend*>(ctx);
+        if (!d || !out_pso) return false;
+        VkPipeline pipe = VK_NULL_HANDLE;
+        auto pt0 = perf::Enabled() ? PerfClock::now() : PerfClock::time_point{};
+        VkResult r = self->vk_.create_comp_pipes(self->dev_, self->pipe_cache_, 1,
+                                                 static_cast<const VkComputePipelineCreateInfo*>(d), nullptr, &pipe);
+        if (perf::Enabled()) perf::RecordPsoCreate(PerfMs(pt0));
+        if (r != VK_SUCCESS) return false;
+        self->pso_dirty_ = true;
+        self->cache_dirty_frame_ = self->presents_;
+        *out_pso = reinterpret_cast<void*>(pipe);
+        return true;
+    };
+    desc.host.create_or_load_graphics_pso = [](void* ctx, const wchar_t* name, const void* d, void** out_pso) -> bool {
+        auto* self = static_cast<VulkanBackend*>(ctx);
+        if (!out_pso) return false;
+        // Special query: name == nullptr && desc == nullptr returns swapchain present VkRenderPass
+        if (!name && !d) {
+            *out_pso = reinterpret_cast<void*>(self->present_rp_);
+            return self->present_rp_ != VK_NULL_HANDLE;
+        }
+        if (!d) return false;
+        VkGraphicsPipelineCreateInfo ci = *static_cast<const VkGraphicsPipelineCreateInfo*>(d);
+        if (ci.renderPass == VK_NULL_HANDLE) ci.renderPass = self->present_rp_;
+        VkPipeline pipe = VK_NULL_HANDLE;
+        auto pt0 = perf::Enabled() ? PerfClock::now() : PerfClock::time_point{};
+        VkResult r = self->vk_.create_gfx_pipes(self->dev_, self->pipe_cache_, 1, &ci, nullptr, &pipe);
+        if (perf::Enabled()) perf::RecordPsoCreate(PerfMs(pt0));
+        if (r != VK_SUCCESS) return false;
+        self->pso_dirty_ = true;
+        self->cache_dirty_frame_ = self->presents_;
+        *out_pso = reinterpret_cast<void*>(pipe);
+        return true;
+    };
+    desc.host.flush = [](void* ctx) { static_cast<VulkanBackend*>(ctx)->Flush(); };
+    desc.host.upload = [](void* ctx, uint64_t size, uint64_t align, void** out_res, uint64_t* out_off, uint8_t** out_cpu,
+                          uint64_t* out_gpu) -> bool {
+        auto* self = static_cast<VulkanBackend*>(ctx);
+        Alloc a = self->Upload(size, align);
+        if (a.buf == VK_NULL_HANDLE || !a.cpu) return false;
+        if (out_res) *out_res = reinterpret_cast<void*>(a.buf);
+        if (out_off) *out_off = a.off;
+        if (out_cpu) *out_cpu = a.cpu;
+        if (out_gpu) *out_gpu = a.off;
+        return true;
+    };
+    desc.host.get_pipeline_library = [](void* ctx) -> void* {
+        return reinterpret_cast<void*>(static_cast<VulkanBackend*>(ctx)->instance_);
+    };
+    upscaler_inited_ = u->Init(desc);
+}
+
+void VulkanBackend::LoadSettings() {
+    ComputeRenderExtents(render_w_, render_h_, vp_x_, vp_y_, vp_w_, vp_h_);
+    scale_x_ = float(render_w_) / float(guest_w_);
+    scale_y_ = float(render_h_) / float(guest_h_);
+    scale_ = scale_y_;
+    const app::Settings& s = app::Get();
+    last_upscaler_mode_ = s.upscaler;
+    last_upscale_quality_ = s.upscale_quality;
+    last_aspect_correct_ = s.aspect_correct_render;
+    texturedumper::Update();
+}
+
+// --- Synchronization, Recording, RenderPasses & Barriers ---
+
+uint64_t VulkanBackend::GetCompletedValue() const {
+    uint64_t v = 0;
+    if (timeline_sem_ != VK_NULL_HANDLE) vk_.get_sem_val(dev_, timeline_sem_, &v);
+    return v;
+}
+
+void VulkanBackend::WaitTimeline(uint64_t value) {
+    if (value == 0 || GetCompletedValue() >= value) return;
+    VkSemaphoreWaitInfo wi{VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO};
+    wi.semaphoreCount = 1;
+    wi.pSemaphores = &timeline_sem_;
+    wi.pValues = &value;
+    vk_.wait_sems(dev_, &wi, UINT64_MAX);
+}
+
+void VulkanBackend::WaitGpuFrame(uint64_t n) {
+    uint64_t fence = present_fence_[n % (kFrames + 1)].load();
+    if (fence) WaitTimeline(fence);
+}
+
+void VulkanBackend::Begin() {
+    Frame& f = CurrentFrame();
+    cmd_ = f.cmd;
+    VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vk_.begin_cmd_buf(cmd_, &bi);
+    if (ts_pool_ != VK_NULL_HANDLE && !ts_started_) {
+        uint32_t slot = uint32_t(frame_ % kFrames);
+        vk_.cmd_reset_qp(cmd_, ts_pool_, slot * 2u, 2u);
+        vk_.cmd_write_ts(cmd_, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, ts_pool_, slot * 2u);
+        ts_started_ = true;
+    }
+    if (!f.queries_used.empty() && occ_pool_ != VK_NULL_HANDLE) {
+        for (uint32_t q : f.queries_used) vk_.cmd_reset_qp(cmd_, occ_pool_, q, 1);
+        f.queries_used.clear();
+    }
+    bound_rt_ = bound_ds_ = nullptr;
+    in_render_pass_ = false;
+    rp_rt_ = rp_ds_ = nullptr;
+    binds_ = {};
+}
+
+void VulkanBackend::Submit(bool wait) {
+    EndRenderPass();
+    FlushPendingQueryResolves();
+    last_vsc_buf_ = VK_NULL_HANDLE;
+    last_dc_buf_ = VK_NULL_HANDLE;
+    vk_.end_cmd_buf(cmd_);
+
+    uint64_t sig_val = ++fence_value_;
+    uint32_t slot = uint32_t(frame_ % kFrames);
+    uint64_t wait_val = 0;
+    VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+
+    VkTimelineSemaphoreSubmitInfo tsi{VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO};
+    tsi.signalSemaphoreValueCount = 1;
+    tsi.pSignalSemaphoreValues = &sig_val;
+
+    VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO, &tsi};
+    if (swap_acquired_) {
+        tsi.waitSemaphoreValueCount = 1;
+        tsi.pWaitSemaphoreValues = &wait_val;
+        si.waitSemaphoreCount = 1;
+        si.pWaitSemaphores = &img_avail_sems_[slot];
+        si.pWaitDstStageMask = &wait_stage;
+        swap_acquired_ = false;
+    }
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cmd_;
+    si.signalSemaphoreCount = 1;
+    si.pSignalSemaphores = &timeline_sem_;
+    vk_.queue_submit(queue_, 1, &si, VK_NULL_HANDLE);
+
+    Frame& f = CurrentFrame();
+    f.fence = sig_val;
+    if (wait) {
+        WaitTimeline(sig_val);
+        vk_.reset_cmd_pool(dev_, f.cmd_pool, 0);
+        vk_.reset_desc_pool(dev_, f.desc_pool, 0);
+        for (VkDescriptorPool ep : f.extra_desc_pools) vk_.reset_desc_pool(dev_, ep, 0);
+        f.desc_cache.clear();
+        FreeDeferred(f.garbage);
+        f.used = 0;
+        Begin();
+    }
+}
+
+void VulkanBackend::SubmitPresent(uint32_t bi) {
+    EndRenderPass();
+    FlushPendingQueryResolves();
+    last_vsc_buf_ = VK_NULL_HANDLE;
+    last_dc_buf_ = VK_NULL_HANDLE;
+    vk_.end_cmd_buf(cmd_);
+
+    uint64_t sig_val = ++fence_value_;
+    uint32_t slot = uint32_t(frame_ % kFrames);
+
+    uint64_t wait_vals[1] = {0};
+    uint64_t sig_vals[2] = {0, sig_val};
+    VkTimelineSemaphoreSubmitInfo tsi{VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO};
+    tsi.signalSemaphoreValueCount = 2;
+    tsi.pSignalSemaphoreValues = sig_vals;
+
+    VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+    VkSemaphore sig_sems[2] = {render_done_sems_[bi], timeline_sem_};
+
+    VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO, &tsi};
+    if (swap_acquired_) {
+        tsi.waitSemaphoreValueCount = 1;
+        tsi.pWaitSemaphoreValues = wait_vals;
+        si.waitSemaphoreCount = 1;
+        si.pWaitSemaphores = &img_avail_sems_[slot];
+        si.pWaitDstStageMask = &wait_stage;
+        swap_acquired_ = false;
+    }
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &cmd_;
+    si.signalSemaphoreCount = 2;
+    si.pSignalSemaphores = sig_sems;
+    vk_.queue_submit(queue_, 1, &si, VK_NULL_HANDLE);
+
+    CurrentFrame().fence = sig_val;
+}
+
+void VulkanBackend::ResetFrame() {
+    Frame& f = CurrentFrame();
+    if (f.fence && GetCompletedValue() < f.fence) {
+        auto perf_wait = PerfClock::now();
+        WaitTimeline(f.fence);
+        g_perf.wait += PerfMs(perf_wait);
+    }
+    if (f.ts_valid && ts_pool_ != VK_NULL_HANDLE) {
+        uint32_t slot = uint32_t(frame_ % kFrames);
+        uint64_t ts[2] = {};
+        if (vk_.get_query_results(dev_, ts_pool_, slot * 2u, 2, sizeof(ts), ts, sizeof(uint64_t),
+                                  VK_QUERY_RESULT_64_BIT) == VK_SUCCESS &&
+            ts[1] >= ts[0]) {
+            last_gpu_ms_ = double(ts[1] - ts[0]) * double(phys_props_.limits.timestampPeriod) / 1e6;
+        }
+        f.ts_valid = false;
+    }
+    vk_.reset_cmd_pool(dev_, f.cmd_pool, 0);
+    vk_.reset_desc_pool(dev_, f.desc_pool, 0);
+    for (VkDescriptorPool ep : f.extra_desc_pools) vk_.reset_desc_pool(dev_, ep, 0);
+    f.desc_cache.clear();
+    FreeDeferred(f.garbage);
+    f.used = 0;
+    Begin();
+}
+
+VulkanBackend::Alloc VulkanBackend::Upload(uint64_t size, uint64_t align) {
+    align = std::max<uint64_t>(align, 16);
+    Frame& f = CurrentFrame();
+    g_perf.upload += size;
+    uint64_t o = (f.used + align - 1) & ~(align - 1);
+    if (o + size <= upload_size_) {
+        f.used = o + size;
+        return {f.upload_buf, o, f.map + o};
+    }
+    g_perf.overflow++;
+    constexpr uint64_t kOwnAlign = 0x10000;
+    uint64_t alloc_sz = (std::max<uint64_t>(size, sizeof(DrawConstants)) + kOwnAlign - 1) & ~(kOwnAlign - 1);
+    VkBuffer buf = VK_NULL_HANDLE;
+    VkDeviceMemory mem = VK_NULL_HANDLE;
+    uint8_t* p = nullptr;
+    VkBufferUsageFlags usage = VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_VERTEX_BUFFER_BIT |
+                               VK_BUFFER_USAGE_INDEX_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    if (CreateBuffer(alloc_sz, usage, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, buf,
+                     mem, &p) &&
+        p) {
+        f.garbage.push_back({VK_NULL_HANDLE, VK_NULL_HANDLE, buf, mem, VK_NULL_HANDLE});
+        return {buf, 0, p};
+    }
+    if (size <= upload_size_) {
+        Submit(true);
+        Frame& f2 = CurrentFrame();
+        f2.used = size;
+        return {f2.upload_buf, 0, f2.map};
+    }
+    LOGE("vulkan: upload allocation failed (%llu bytes)", (unsigned long long)size);
+    return {};
+}
+
+VkRenderPass VulkanBackend::GetRenderPass(VkFormat color_fmt, VkFormat depth_fmt) {
+    uint64_t key = (uint64_t(color_fmt) << 32) | uint64_t(depth_fmt);
+    auto it = rp_cache_.find(key);
+    if (it != rp_cache_.end()) return it->second;
+
+    VkAttachmentDescription atts[2]{};
+    uint32_t att_count = 0;
+    VkAttachmentReference color_ref{}, depth_ref{};
+    bool has_c = (color_fmt != VK_FORMAT_UNDEFINED);
+    bool has_d = (depth_fmt != VK_FORMAT_UNDEFINED);
+
+    if (has_c) {
+        auto& a = atts[att_count];
+        a.format = color_fmt;
+        a.samples = VK_SAMPLE_COUNT_1_BIT;
+        a.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        a.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        a.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        a.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+        a.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        a.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        color_ref = {att_count++, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+    }
+    if (has_d) {
+        auto& a = atts[att_count];
+        a.format = depth_fmt;
+        a.samples = VK_SAMPLE_COUNT_1_BIT;
+        a.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        a.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        a.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        a.stencilStoreOp = VK_ATTACHMENT_STORE_OP_STORE;
+        a.initialLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+        a.finalLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+        depth_ref = {att_count++, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL};
+    }
+
+    VkSubpassDescription sub{};
+    sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    sub.colorAttachmentCount = has_c ? 1u : 0u;
+    sub.pColorAttachments = has_c ? &color_ref : nullptr;
+    sub.pDepthStencilAttachment = has_d ? &depth_ref : nullptr;
+
+    // Re-entering a pass with LOAD still needs a memory dependency when the
+    // previous pass left the color/depth attachment in exactly the same layout.
+    VkSubpassDependency dep{};
+    dep.srcSubpass = VK_SUBPASS_EXTERNAL;
+    dep.dstSubpass = 0;
+    if (has_c) {
+        dep.srcStageMask |= VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+        dep.srcAccessMask |= VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+        dep.dstAccessMask |= VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    }
+    if (has_d) {
+        dep.srcStageMask |= VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT;
+        dep.srcAccessMask |= VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+        dep.dstAccessMask |= VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    }
+    dep.dstStageMask = dep.srcStageMask;
+    dep.dependencyFlags = VK_DEPENDENCY_BY_REGION_BIT;
+
+    VkRenderPassCreateInfo ci{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+    ci.attachmentCount = att_count;
+    ci.pAttachments = atts;
+    ci.subpassCount = 1;
+    ci.pSubpasses = &sub;
+    ci.dependencyCount = (has_c || has_d) ? 1u : 0u;
+    ci.pDependencies = &dep;
+    VkRenderPass rp = VK_NULL_HANDLE;
+    vk_.create_rp(dev_, &ci, nullptr, &rp);
+    rp_cache_[key] = rp;
+    return rp;
+}
+
+VkFramebuffer VulkanBackend::GetFramebuffer(VkRenderPass rp, VkImageView color_v, VkImageView depth_v, uint32_t w,
+                                            uint32_t h) {
+    FbKey k{rp, color_v, depth_v, w, h};
+    auto it = fb_cache_.find(k);
+    if (it != fb_cache_.end()) return it->second;
+
+    VkImageView atts[2]{};
+    uint32_t n = 0;
+    if (color_v != VK_NULL_HANDLE) atts[n++] = color_v;
+    if (depth_v != VK_NULL_HANDLE) atts[n++] = depth_v;
+
+    VkFramebufferCreateInfo fbi{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+    fbi.renderPass = rp;
+    fbi.attachmentCount = n;
+    fbi.pAttachments = atts;
+    fbi.width = w;
+    fbi.height = h;
+    fbi.layers = 1;
+    VkFramebuffer fb = VK_NULL_HANDLE;
+    vk_.create_fb(dev_, &fbi, nullptr, &fb);
+    fb_cache_[k] = fb;
+    return fb;
+}
+
+void VulkanBackend::InvalidateFramebuffersForView(VkImageView v) {
+    if (v == VK_NULL_HANDLE) return;
+    for (auto it = fb_cache_.begin(); it != fb_cache_.end();) {
+        if (it->first.color == v || it->first.depth == v) {
+            CurrentFrame().garbage.push_back({VK_NULL_HANDLE, VK_NULL_HANDLE, VK_NULL_HANDLE, VK_NULL_HANDLE, it->second});
+            it = fb_cache_.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+void VulkanBackend::EnsureRenderPass(Target* rt, Target* ds) {
+    if (in_render_pass_ && rp_rt_ == rt && rp_ds_ == ds) return;
+    EndRenderPass();
+    if (!rt && !ds) return;
+    if (rt) TransitionImage(rt->img, rt->layout, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_ASPECT_COLOR_BIT);
+    if (ds) {
+        TransitionImage(ds->img, ds->layout, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL,
+                        VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT);
+    }
+    VkFormat cf = rt ? rt->vk_fmt : VK_FORMAT_UNDEFINED;
+    VkFormat df = ds ? ds->vk_fmt : VK_FORMAT_UNDEFINED;
+    VkRenderPass rp = GetRenderPass(cf, df);
+    uint32_t w = rt ? rt->w : ds->w;
+    uint32_t h = rt ? rt->h : ds->h;
+    VkFramebuffer fb = GetFramebuffer(rp, rt ? rt->att_view : VK_NULL_HANDLE, ds ? ds->att_view : VK_NULL_HANDLE, w, h);
+
+    VkRenderPassBeginInfo bi{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    bi.renderPass = rp;
+    bi.framebuffer = fb;
+    bi.renderArea = {{0, 0}, {w, h}};
+    vk_.cmd_begin_rp(cmd_, &bi, VK_SUBPASS_CONTENTS_INLINE);
+    in_render_pass_ = true;
+    rp_rt_ = rt;
+    rp_ds_ = ds;
+}
+
+void VulkanBackend::EnsureRawRenderPass(VkRenderPass rp, VkFramebuffer fb, uint32_t w, uint32_t h) {
+    EndRenderPass();
+    VkRenderPassBeginInfo bi{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    bi.renderPass = rp;
+    bi.framebuffer = fb;
+    bi.renderArea = {{0, 0}, {w, h}};
+    vk_.cmd_begin_rp(cmd_, &bi, VK_SUBPASS_CONTENTS_INLINE);
+    in_render_pass_ = true;
+    rp_rt_ = nullptr;
+    rp_ds_ = nullptr;
+}
+
+void VulkanBackend::EndRenderPass() {
+    if (!in_render_pass_) return;
+    vk_.cmd_end_rp(cmd_);
+    in_render_pass_ = false;
+    rp_rt_ = rp_ds_ = nullptr;
+    binds_ = {};
+    FlushPendingQueryResolves();
+}
+
+void VulkanBackend::FlushPendingQueryResolves() {
+    if (pending_query_resolves_.empty() || occ_pool_ == VK_NULL_HANDLE || occ_rb_ == VK_NULL_HANDLE) return;
+    for (uint32_t q : pending_query_resolves_) {
+        vk_.cmd_copy_qp_res(cmd_, occ_pool_, q, 1, occ_rb_, VkDeviceSize(q) * sizeof(uint64_t), sizeof(uint64_t),
+                            VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT);
+    }
+    pending_query_resolves_.clear();
+}
+
+void VulkanBackend::TransitionImage(VkImage img, VkImageLayout& cur, VkImageLayout want, VkImageAspectFlags aspect,
+                                    uint32_t mips, uint32_t layers) {
+    if (cur == want && want != VK_IMAGE_LAYOUT_GENERAL) return;
+    EndRenderPass();
+    VkPipelineStageFlags src_stage = 0, dst_stage = 0;
+    VkAccessFlags src_acc = 0, dst_acc = 0;
+    LayoutStageAccess(cur, src_stage, src_acc);
+    LayoutStageAccess(want, dst_stage, dst_acc);
+
+    VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    b.srcAccessMask = src_acc;
+    b.dstAccessMask = dst_acc;
+    b.oldLayout = cur;
+    b.newLayout = want;
+    b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = img;
+    b.subresourceRange = {aspect, 0, mips, 0, layers};
+    vk_.cmd_barrier(cmd_, src_stage, dst_stage, 0, 0, nullptr, 0, nullptr, 1, &b);
+    cur = want;
+}
+
+// --- Persistent Disk Caches (cache/vk_shaders.bin & cache/vk_psos_<VID>_<DID>.bin) ---
+
+std::filesystem::path VulkanBackend::PsoCachePath() const {
+    char name[64];
+    std::snprintf(name, sizeof(name), "vk_psos_%04X_%04X.bin", phys_props_.vendorID, phys_props_.deviceID);
+    return cache_dir_ / name;
+}
+
+std::filesystem::path VulkanBackend::PsoMetaPath() const {
+    char name[64];
+    std::snprintf(name, sizeof(name), "vk_pso_meta_%04X_%04X.bin", phys_props_.vendorID, phys_props_.deviceID);
+    return cache_dir_ / name;
+}
+
+void VulkanBackend::StartSaveThread() {
+    std::lock_guard<std::mutex> lock(save_mtx_);
+    if (save_thread_.joinable()) return;
+    save_stop_ = false;
+    save_thread_ = std::thread([this] { SaveWorkerLoop(); });
+}
+
+void VulkanBackend::DrainSaveThread() {
+    std::unique_lock<std::mutex> lock(save_mtx_);
+    save_done_cv_.wait(lock, [this] { return !save_has_pending_ && !save_writing_; });
+}
+
+void VulkanBackend::StopSaveThread() {
+    {
+        std::lock_guard<std::mutex> lock(save_mtx_);
+        save_stop_ = true;
+    }
+    save_cv_.notify_all();
+    if (save_thread_.joinable()) save_thread_.join();
+}
+
+void VulkanBackend::SaveWorkerLoop() {
+    for (;;) {
+        CacheSaveJob job{};
+        {
+            std::unique_lock<std::mutex> lock(save_mtx_);
+            save_cv_.wait(lock, [this] { return save_has_pending_ || save_stop_; });
+            if (!save_has_pending_) {
+                if (save_stop_) break;
+                continue;
+            }
+            job = std::move(save_pending_);
+            save_pending_ = CacheSaveJob{};
+            save_has_pending_ = false;
+            save_writing_ = true;
+        }
+        std::error_code ec;
+        std::filesystem::create_directories(job.dir, ec);
+        if (job.write_shaders) WriteAtomicFilePosix(job.dir / "vk_shaders.bin", job.shaders_bytes);
+        if (job.write_pso) WriteAtomicFilePosix(job.pso_path, job.pso_bytes);
+        if (job.write_meta) WriteAtomicFilePosix(job.meta_path, job.meta_bytes);
+        if (job.write_recipes) WriteAtomicFilePosix(job.dir / "shader_recipes.bin", job.recipes_bytes);
+        {
+            std::lock_guard<std::mutex> lock(save_mtx_);
+            save_writing_ = false;
+        }
+        save_done_cv_.notify_all();
+    }
+}
+
+void VulkanBackend::PublishCacheStats() {
+    g_cache_enabled_stat.store(cache_enabled_, std::memory_order_relaxed);
+    g_cache_shaders_stat.store(uint32_t(shader_cache_entries_.size()), std::memory_order_relaxed);
+    g_cache_psos_stat.store(uint32_t(psos_.size() + blit_psos_.size()), std::memory_order_relaxed);
+    uint64_t bytes = 0;
+    if (cache_enabled_ && !cache_dir_.empty()) {
+        std::error_code ec;
+        auto ssz = std::filesystem::file_size(cache_dir_ / "vk_shaders.bin", ec);
+        if (!ec) bytes += ssz;
+        ec.clear();
+        auto psz = std::filesystem::file_size(PsoCachePath(), ec);
+        if (!ec) bytes += psz;
+        ec.clear();
+        auto msz = std::filesystem::file_size(PsoMetaPath(), ec);
+        if (!ec) bytes += msz;
+        ec.clear();
+        auto rsz = std::filesystem::file_size(cache_dir_ / "shader_recipes.bin", ec);
+        if (!ec) bytes += rsz;
+    }
+    g_cache_bytes_stat.store(bytes, std::memory_order_relaxed);
+}
+
+void VulkanBackend::InitCaches() {
+    cache_enabled_ = !NoShaderCacheFlag();
+    perf::SetShaderCacheEnabled(cache_enabled_);
+    cache_dir_ = app::ExeDir() / "cache";
+
+    size_t loaded_shaders = 0;
+    std::vector<uint8_t> pso_init_data;
+    if (cache_enabled_) {
+        if (FILE* sf = std::fopen((cache_dir_ / "vk_shaders.bin").c_str(), "rb")) {
+            VkShaderCacheHeader hdr{};
+            if (std::fread(&hdr, sizeof(hdr), 1, sf) == 1 && std::memcmp(hdr.magic, "VKSC", 4) == 0 &&
+                hdr.version == 1 && hdr.abi == 1) {
+                while (true) {
+                    uint64_t h = 0;
+                    uint32_t wc = 0;
+                    if (std::fread(&h, sizeof(h), 1, sf) != 1 || std::fread(&wc, sizeof(wc), 1, sf) != 1) break;
+                    if (wc == 0 || wc > (4u << 20)) break;
+                    std::vector<uint32_t> words(wc);
+                    if (std::fread(words.data(), sizeof(uint32_t), wc, sf) != wc) break;
+                    VkShaderModuleCreateInfo smci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+                    smci.codeSize = words.size() * sizeof(uint32_t);
+                    smci.pCode = words.data();
+                    VkShaderModule mod = VK_NULL_HANDLE;
+                    if (vk_.create_shader(dev_, &smci, nullptr, &mod) == VK_SUCCESS) {
+                        shader_mods_[h] = mod;
+                        disk_blob_pending_.insert(h);
+                        shader_cache_entries_.emplace_back(h, std::move(words));
+                        loaded_shaders++;
+                    }
+                }
+            }
+            std::fclose(sf);
+        }
+
+        if (FILE* pf = std::fopen(PsoCachePath().c_str(), "rb")) {
+            VkPsoCacheHeader hdr{};
+            if (std::fread(&hdr, sizeof(hdr), 1, pf) == 1 && std::memcmp(hdr.magic, "VKPC", 4) == 0 &&
+                hdr.version == 1 && hdr.vendor_id == phys_props_.vendorID && hdr.device_id == phys_props_.deviceID &&
+                hdr.driver_version == phys_props_.driverVersion &&
+                std::memcmp(hdr.uuid, phys_props_.pipelineCacheUUID, VK_UUID_SIZE) == 0 && hdr.blob_size > 0 &&
+                hdr.blob_size < (256u << 20)) {
+                pso_init_data.resize(hdr.blob_size);
+                if (std::fread(pso_init_data.data(), 1, hdr.blob_size, pf) != hdr.blob_size) pso_init_data.clear();
+            }
+            std::fclose(pf);
+        }
+    }
+
+    pso_cache_loaded_ = !pso_init_data.empty();
+    VkPipelineCacheCreateInfo pcci{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+    pcci.initialDataSize = pso_init_data.size();
+    pcci.pInitialData = pso_init_data.empty() ? nullptr : pso_init_data.data();
+    vk_.create_pipe_cache(dev_, &pcci, nullptr, &pipe_cache_);
+
+    LOGR("vulkan: cache initialized (enabled=%s, shaders_loaded=%zu, pso_blob=%zu B)",
+         cache_enabled_ ? "true" : "false", loaded_shaders, pso_init_data.size());
+    auto boot_t0 = PerfClock::now();
+    g_warmup_active.store(true, std::memory_order_release);
+    PrewarmBuiltinPipelines();
+    PrewarmCachedPsos();
+    LoadAndPrewarmRecipes();
+    g_warmup_elapsed_us.fetch_add(uint64_t(PerfMs(boot_t0) * 1000.0), std::memory_order_relaxed);
+    g_warmup_active.store(false, std::memory_order_release);
+    g_warmup_completed.store(true, std::memory_order_release);
+    g_warmup_completed_ms.store(NowMonoMs(), std::memory_order_release);
+    if (cache_enabled_ && (shaders_dirty_ || pso_dirty_ || meta_dirty_ || recipes_dirty_)) SaveCaches(false, true);
+    PublishCacheStats();
+}
+
+void VulkanBackend::SaveCaches(bool sync, bool include_pso_lib) {
+    if (!cache_enabled_) return;
+    CacheSaveJob job{};
+    job.dir = cache_dir_;
+    {
+        std::lock_guard<std::mutex> lock(cache_lock_);
+        bool want_pso = pso_dirty_ && (include_pso_lib || sync);
+        if (!shaders_dirty_ && !want_pso && !meta_dirty_ && !recipes_dirty_) {
+            if (!sync) return;
+        } else {
+            cache_dirty_frame_ = presents_;
+            if (shaders_dirty_) {
+                VkShaderCacheHeader hdr{{'V', 'K', 'S', 'C'}, 1u, 1u, 0u};
+                size_t total = sizeof(hdr);
+                for (const auto& [h, words] : shader_cache_entries_)
+                    total += sizeof(uint64_t) + sizeof(uint32_t) + words.size() * sizeof(uint32_t);
+                job.shaders_bytes.resize(total);
+                uint8_t* p = job.shaders_bytes.data();
+                std::memcpy(p, &hdr, sizeof(hdr));
+                p += sizeof(hdr);
+                for (const auto& [h, words] : shader_cache_entries_) {
+                    uint32_t wc = uint32_t(words.size());
+                    size_t wbytes = size_t(wc) * sizeof(uint32_t);
+                    std::memcpy(p, &h, sizeof(h));
+                    p += sizeof(h);
+                    std::memcpy(p, &wc, sizeof(wc));
+                    p += sizeof(wc);
+                    if (wbytes) {
+                        std::memcpy(p, words.data(), wbytes);
+                        p += wbytes;
+                    }
+                }
+                job.write_shaders = true;
+                shaders_dirty_ = false;
+            }
+            if (want_pso && pipe_cache_ != VK_NULL_HANDLE) {
+                size_t sz = 0;
+                if (vk_.get_pipe_cache_data(dev_, pipe_cache_, &sz, nullptr) == VK_SUCCESS && sz > 0 &&
+                    sz < (256u << 20)) {
+                    job.pso_bytes.resize(sizeof(VkPsoCacheHeader) + sz);
+                    if (vk_.get_pipe_cache_data(dev_, pipe_cache_, &sz, job.pso_bytes.data() + sizeof(VkPsoCacheHeader)) ==
+                        VK_SUCCESS) {
+                        job.pso_bytes.resize(sizeof(VkPsoCacheHeader) + sz);
+                        VkPsoCacheHeader hdr{{'V', 'K', 'P', 'C'}, 1u, phys_props_.vendorID, phys_props_.deviceID,
+                                             phys_props_.driverVersion, {}, uint32_t(sz), 0u};
+                        std::memcpy(hdr.uuid, phys_props_.pipelineCacheUUID, VK_UUID_SIZE);
+                        std::memcpy(job.pso_bytes.data(), &hdr, sizeof(hdr));
+                        job.pso_path = PsoCachePath();
+                        job.write_pso = true;
+                    } else {
+                        job.pso_bytes.clear();
+                    }
+                }
+                pso_dirty_ = false;
+            } else if (want_pso) {
+                pso_dirty_ = false;
+            }
+            if (meta_dirty_) {
+                VkPsoMetaHeader hdr{};
+                hdr.magic = kVkPsoMetaMagic;
+                hdr.version = kVkPsoMetaVersion;
+                hdr.sizeof_pso_key = uint32_t(sizeof(PsoKey));
+                hdr.vendor_id = phys_props_.vendorID;
+                hdr.device_id = phys_props_.deviceID;
+                hdr.driver_version = phys_props_.driverVersion;
+                std::memcpy(hdr.uuid, phys_props_.pipelineCacheUUID, VK_UUID_SIZE);
+                hdr.src_count = uint32_t(src_meta_entries_.size());
+                hdr.pso_count = uint32_t(pso_meta_entries_.size());
+                size_t src_bytes = src_meta_entries_.size() * sizeof(SrcMetaEntry);
+                size_t pso_bytes = pso_meta_entries_.size() * sizeof(PsoKey);
+                job.meta_bytes.resize(sizeof(hdr) + src_bytes + pso_bytes);
+                uint8_t* p = job.meta_bytes.data();
+                std::memcpy(p, &hdr, sizeof(hdr));
+                p += sizeof(hdr);
+                if (src_bytes) {
+                    std::memcpy(p, src_meta_entries_.data(), src_bytes);
+                    p += src_bytes;
+                }
+                if (pso_bytes) std::memcpy(p, pso_meta_entries_.data(), pso_bytes);
+                job.meta_path = PsoMetaPath();
+                job.write_meta = true;
+                meta_dirty_ = false;
+            }
+            if (recipes_dirty_) {
+                RecipeCacheHeader rh{};
+                rh.magic = kRecipeCacheMagic;
+                rh.version = kRecipeCacheVersion;
+                rh.sizeof_fixed_vs = uint32_t(sizeof(FixedVsRecipe));
+                rh.sizeof_pixel_ps = uint32_t(sizeof(PixelRecipe));
+                rh.fixed_vs_count = uint32_t(fixed_vs_recipes_.size());
+                rh.pixel_ps_count = uint32_t(pixel_ps_recipes_.size());
+                size_t fv_bytes = fixed_vs_recipes_.size() * sizeof(FixedVsRecipe);
+                size_t pp_bytes = pixel_ps_recipes_.size() * sizeof(PixelRecipe);
+                job.recipes_bytes.resize(sizeof(rh) + fv_bytes + pp_bytes);
+                uint8_t* p = job.recipes_bytes.data();
+                std::memcpy(p, &rh, sizeof(rh));
+                p += sizeof(rh);
+                if (fv_bytes) {
+                    std::memcpy(p, fixed_vs_recipes_.data(), fv_bytes);
+                    p += fv_bytes;
+                }
+                if (pp_bytes) std::memcpy(p, pixel_ps_recipes_.data(), pp_bytes);
+                job.write_recipes = true;
+                recipes_dirty_ = false;
+            }
+        }
+    }
+    if (job.write_shaders || job.write_pso || job.write_meta || job.write_recipes) {
+        StartSaveThread();
+        {
+            std::lock_guard<std::mutex> lock(save_mtx_);
+            save_pending_.dir = job.dir;
+            if (job.write_shaders) {
+                save_pending_.write_shaders = true;
+                save_pending_.shaders_bytes = std::move(job.shaders_bytes);
+            }
+            if (job.write_pso) {
+                save_pending_.write_pso = true;
+                save_pending_.pso_path = std::move(job.pso_path);
+                save_pending_.pso_bytes = std::move(job.pso_bytes);
+            }
+            if (job.write_meta) {
+                save_pending_.write_meta = true;
+                save_pending_.meta_path = std::move(job.meta_path);
+                save_pending_.meta_bytes = std::move(job.meta_bytes);
+            }
+            if (job.write_recipes) {
+                save_pending_.write_recipes = true;
+                save_pending_.recipes_bytes = std::move(job.recipes_bytes);
+            }
+            save_has_pending_ = true;
+        }
+        save_cv_.notify_one();
+    }
+    if (sync) DrainSaveThread();
+}
+
+void VulkanBackend::ResetCaches() {
+    StopAsyncPrewarm();
+    Flush();
+    DrainSaveThread();
+    {
+        std::lock_guard<std::mutex> lock(cache_lock_);
+        shader_cache_entries_.clear();
+        disk_blob_pending_.clear();
+        known_src_keys_.clear();
+        known_pso_keys_.clear();
+        known_fixed_vs_recipes_.clear();
+        known_pixel_ps_recipes_.clear();
+        src_meta_entries_.clear();
+        pso_meta_entries_.clear();
+        deferred_pso_keys_.clear();
+        fixed_vs_recipes_.clear();
+        pixel_ps_recipes_.clear();
+        shaders_dirty_ = false;
+        pso_dirty_ = false;
+        meta_dirty_ = false;
+        recipes_dirty_ = false;
+        if (pipe_cache_ != VK_NULL_HANDLE) {
+            vk_.destroy_pipe_cache(dev_, pipe_cache_, nullptr);
+            pipe_cache_ = VK_NULL_HANDLE;
+        }
+        if (!cache_dir_.empty()) {
+            std::error_code ec;
+            std::filesystem::remove(cache_dir_ / "vk_shaders.bin", ec);
+            std::filesystem::remove(cache_dir_ / "vk_shaders.bin.tmp", ec);
+            std::filesystem::remove(cache_dir_ / "shader_recipes.bin", ec);
+            std::filesystem::remove(cache_dir_ / "shader_recipes.bin.tmp", ec);
+            for (auto& e : std::filesystem::directory_iterator(cache_dir_, ec)) {
+                std::string fn = e.path().filename().string();
+                if (fn.rfind("vk_psos_", 0) == 0 || fn.rfind("vk_pso_meta_", 0) == 0)
+                    std::filesystem::remove(e.path(), ec);
+            }
+        }
+        VkPipelineCacheCreateInfo pcci{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+        vk_.create_pipe_cache(dev_, &pcci, nullptr, &pipe_cache_);
+    }
+    PublishCacheStats();
+    LOGR("vulkan: shader/PSO disk cache cleared by user");
+}
+
+void VulkanBackend::FlushCaches() {
+    DrainAsyncPrewarm(true);
+    SaveCaches(true, true);
+    PublishCacheStats();
+}
+
+void VulkanBackend::Flush() {
+    Submit(true);
+    DeliverReports();
+}
+
+// --- Shaders, Pipelines, Samplers, Descriptors ---
+
+VkShaderModule VulkanBackend::Compile(const std::string& src, const char* entry, const char* profile, uint64_t& hash) {
+    uint64_t profile_seed = Hash(profile, std::strlen(profile));
+    uint64_t entry_seed = Hash(entry, std::strlen(entry), profile_seed);
+    hash = Hash(src.data(), src.size(), entry_seed);
+    auto it = shader_mods_.find(hash);
+    if (it != shader_mods_.end()) {
+        if (disk_blob_pending_.erase(hash) > 0 && perf::Enabled()) perf::RecordShaderCacheHit();
+        return it->second;
+    }
+    PerfScope perf_compile{g_perf.compile};
+    g_perf.shaders++;
+    auto ct0 = perf::Enabled() ? PerfClock::now() : PerfClock::time_point{};
+    std::vector<uint32_t> spv;
+    std::string err;
+    bool ok = CompileHlslToSpirv(src, entry, profile, spv, err);
+    if (perf::Enabled()) perf::RecordShaderCompile(PerfMs(ct0));
+    if (!ok) {
+        LOGE("vulkan: %s (%s) compile failed: %s", profile, entry, err.c_str());
+        shader_mods_[hash] = VK_NULL_HANDLE;
+        return VK_NULL_HANDLE;
+    }
+    VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    ci.codeSize = spv.size() * sizeof(uint32_t);
+    ci.pCode = spv.data();
+    VkShaderModule mod = VK_NULL_HANDLE;
+    if (vk_.create_shader(dev_, &ci, nullptr, &mod) != VK_SUCCESS) {
+        shader_mods_[hash] = VK_NULL_HANDLE;
+        return VK_NULL_HANDLE;
+    }
+    shader_mods_[hash] = mod;
+    if (cache_enabled_) {
+        std::lock_guard<std::mutex> lock(cache_lock_);
+        shader_cache_entries_.emplace_back(hash, std::move(spv));
+        shaders_dirty_ = true;
+        cache_dirty_frame_ = presents_;
+    }
+    return mod;
+}
+
+VkPrimitiveTopology VkTopologyOf(uint32_t topo, uint32_t strip) {
+    if (topo == uint32_t(Topology::Points)) return VK_PRIMITIVE_TOPOLOGY_POINT_LIST;
+    if (topo == uint32_t(Topology::Lines)) {
+        return strip ? VK_PRIMITIVE_TOPOLOGY_LINE_STRIP : VK_PRIMITIVE_TOPOLOGY_LINE_LIST;
+    }
+    return strip ? VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+}
+
+VkPipeline VulkanBackend::EnsurePipeline(const PsoKey& k, VkShaderModule vs, VkShaderModule ps) {
+    uint64_t h = Hash(&k, sizeof(k));
+    auto it = psos_.find(h);
+    if (it != psos_.end()) return it->second;
+
+    VkPipelineShaderStageCreateInfo stages[3]{};
+    uint32_t stage_cnt = 0;
+    stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                           VK_SHADER_STAGE_VERTEX_BIT, vs, "main", nullptr};
+    bool expanded_points = false;
+    if (k.topo == uint32_t(Topology::Points)) {
+        uint64_t gh = 0;
+        VkShaderModule gs = Compile(k.sprite ? SpriteHlsl() : PointHlsl(), "main", "gs_5_0", gh);
+        if (gs != VK_NULL_HANDLE) {
+            stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                   VK_SHADER_STAGE_GEOMETRY_BIT, gs, "main", nullptr};
+            expanded_points = true;
+        }
+    }
+    stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                           VK_SHADER_STAGE_FRAGMENT_BIT, ps, "main", nullptr};
+
+    VkVertexInputBindingDescription vbinds[16]{};
+    for (uint32_t i = 0; i < k.buf_count; ++i) {
+        vbinds[i] = {i, k.strides[i], VK_VERTEX_INPUT_RATE_VERTEX};
+    }
+    VkVertexInputAttributeDescription vattrs[16]{};
+    uint32_t attr_cnt = 0;
+    for (uint32_t r = 0; r < 16; ++r) {
+        if (!((k.regs >> r) & 1)) continue;
+        uint32_t e = k.elements[r];
+        vattrs[attr_cnt++] = {r, (e >> 8) & 0xFF, DxgiToVkFormat(DXGI_FORMAT(e & 0xFF)), e >> 16};
+    }
+
+    VkPipelineVertexInputStateCreateInfo vi{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+    vi.vertexBindingDescriptionCount = k.buf_count;
+    vi.pVertexBindingDescriptions = vbinds;
+    vi.vertexAttributeDescriptionCount = attr_cnt;
+    vi.pVertexAttributeDescriptions = vattrs;
+
+    VkPipelineInputAssemblyStateCreateInfo ia{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+    ia.topology = VkTopologyOf(k.topo, k.strip);
+    ia.primitiveRestartEnable = VK_FALSE;
+
+    VkPipelineViewportStateCreateInfo vp{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+    vp.viewportCount = 1;
+    vp.scissorCount = 1;
+
+    VkPipelineRasterizationStateCreateInfo rs{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+    rs.polygonMode = (!expanded_points && k.fill == kFillWireframe) ? VK_POLYGON_MODE_LINE : VK_POLYGON_MODE_FILL;
+    rs.cullMode = (!expanded_points && k.cull) ? VK_CULL_MODE_BACK_BIT : VK_CULL_MODE_NONE;
+    // Negative-height VkViewport preserves exact D3D12 screen winding!
+    rs.frontFace = (!expanded_points && k.ccw) ? VK_FRONT_FACE_COUNTER_CLOCKWISE : VK_FRONT_FACE_CLOCKWISE;
+    rs.depthBiasEnable = (k.zbias != 0 || k.zslope != 0.0f) ? VK_TRUE : VK_FALSE;
+    rs.depthBiasConstantFactor = float(k.zbias);
+    rs.depthBiasSlopeFactor = k.zslope;
+    rs.lineWidth = 1.0f;
+
+    VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+    ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+
+    VkPipelineDepthStencilStateCreateInfo ds{VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+    ds.depthTestEnable = k.zen ? VK_TRUE : VK_FALSE;
+    ds.depthWriteEnable = k.zwrite ? VK_TRUE : VK_FALSE;
+    ds.depthCompareOp = ReversedCmpVk(k.zfunc);
+    ds.stencilTestEnable = k.sten ? VK_TRUE : VK_FALSE;
+    VkStencilOpState sop{};
+    sop.failOp = StencilOpVk(k.sfail);
+    sop.passOp = StencilOpVk(k.spass);
+    sop.depthFailOp = StencilOpVk(k.szfail);
+    sop.compareOp = CmpVk(k.sfunc);
+    sop.compareMask = k.smask;
+    sop.writeMask = k.swmask;
+    ds.front = ds.back = sop;
+
+    VkPipelineColorBlendAttachmentState ba{};
+    ba.blendEnable = k.blend ? VK_TRUE : VK_FALSE;
+    ba.srcColorBlendFactor = BlendFactor(k.src, false);
+    ba.dstColorBlendFactor = BlendFactor(k.dst, false);
+    ba.colorBlendOp = BlendOpVk(k.op);
+    ba.srcAlphaBlendFactor = BlendFactor(k.src, true);
+    ba.dstAlphaBlendFactor = BlendFactor(k.dst, true);
+    ba.alphaBlendOp = BlendOpVk(k.op);
+    ba.colorWriteMask = k.wmask & 0xF;
+
+    VkPipelineColorBlendStateCreateInfo cb{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+    cb.attachmentCount = k.has_rt ? 1u : 0u;
+    cb.pAttachments = k.has_rt ? &ba : nullptr;
+
+    VkDynamicState dyn_states[4] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR,
+                                    VK_DYNAMIC_STATE_BLEND_CONSTANTS, VK_DYNAMIC_STATE_STENCIL_REFERENCE};
+    VkPipelineDynamicStateCreateInfo dyn{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+    dyn.dynamicStateCount = 4;
+    dyn.pDynamicStates = dyn_states;
+
+    VkRenderPass rp = GetRenderPass(k.has_rt ? VkFormat(k.rtfmt) : VK_FORMAT_UNDEFINED,
+                                    k.has_ds ? depth_fmt_ : VK_FORMAT_UNDEFINED);
+
+    VkGraphicsPipelineCreateInfo gi{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+    gi.stageCount = stage_cnt;
+    gi.pStages = stages;
+    gi.pVertexInputState = &vi;
+    gi.pInputAssemblyState = &ia;
+    gi.pViewportState = &vp;
+    gi.pRasterizationState = &rs;
+    gi.pMultisampleState = &ms;
+    gi.pDepthStencilState = &ds;
+    gi.pColorBlendState = &cb;
+    gi.pDynamicState = &dyn;
+    gi.layout = gfx_layout_;
+    gi.renderPass = rp;
+    gi.subpass = 0;
+
+    VkPipeline pipe = VK_NULL_HANDLE;
+    g_perf.psos++;
+    auto pt0 = perf::Enabled() ? PerfClock::now() : PerfClock::time_point{};
+    VkResult r = vk_.create_gfx_pipes(dev_, pipe_cache_, 1, &gi, nullptr, &pipe);
+    if (r != VK_SUCCESS) {
+        if (perf::Enabled()) perf::RecordPsoCreate(PerfMs(pt0));
+        LOGE("vulkan: graphics pipeline creation failed (%d)", int(r));
+    } else if (cache_enabled_) {
+        bool is_new = false;
+        {
+            std::lock_guard<std::mutex> lock(cache_lock_);
+            is_new = known_pso_keys_.insert(h).second;
+            if (is_new) {
+                pso_meta_entries_.push_back(k);
+                pso_dirty_ = true;
+                meta_dirty_ = true;
+                cache_dirty_frame_ = presents_;
+            }
+        }
+        if (perf::Enabled()) {
+            if (is_new) perf::RecordPsoCreate(PerfMs(pt0));
+            else perf::RecordPsoCacheHit();
+        }
+    } else if (perf::Enabled()) {
+        perf::RecordPsoCreate(PerfMs(pt0));
+    }
+    psos_[h] = pipe;
+    return pipe;
+}
+
+void VulkanBackend::PrewarmBuiltinPipelines() {
+    VkFormat fmts[3] = {swap_fmt_, VK_FORMAT_B8G8R8A8_UNORM, VK_FORMAT_R8G8B8A8_UNORM};
+    for (VkFormat fmt : fmts) {
+        if (fmt == VK_FORMAT_UNDEFINED) continue;
+        EnsureBlitPipeline(fmt, false);
+        EnsureBlitPipeline(fmt, true);
+        static constexpr uint8_t kClearMasks[] = {0x7, 0x8, 0x1, 0x2, 0x4};
+        for (uint8_t m : kClearMasks) EnsureClearPipeline(fmt, m);
+    }
+    EnsureDepthCopyPipeline();
+    uint64_t gh = 0;
+    Compile(PointHlsl(), "main", "gs_5_0", gh);
+    Compile(SpriteHlsl(), "main", "gs_5_0", gh);
+}
+
+size_t VulkanBackend::CompileBatchParallel(const std::vector<ShaderPrewarmItem>& batch) {
+    if (batch.empty()) return 0;
+    struct WorkItem {
+        uint64_t src_key = 0;
+        uint64_t blob_hash = 0;
+        bool is_pixel = false;
+        const std::string* hlsl = nullptr;
+    };
+    std::vector<WorkItem> work;
+    work.reserve(batch.size());
+    std::unordered_set<uint64_t> queued_blobs;
+    std::vector<std::pair<uint64_t, uint64_t>> already_cached_links;
+
+    for (const auto& item : batch) {
+        if (shader_src_.count(item.src_key)) continue;
+        const char* profile = item.is_pixel ? "ps_5_0" : "vs_5_0";
+        uint64_t pseed = Hash(profile, std::strlen(profile));
+        uint64_t eseed = Hash("main", 4, pseed);
+        uint64_t bhash = Hash(item.hlsl.data(), item.hlsl.size(), eseed);
+        auto bit = shader_mods_.find(bhash);
+        if (bit != shader_mods_.end() && bit->second != VK_NULL_HANDLE) {
+            already_cached_links.emplace_back(item.src_key, bhash);
+            continue;
+        }
+        if (queued_blobs.insert(bhash).second) {
+            work.push_back(WorkItem{item.src_key, bhash, item.is_pixel, &item.hlsl});
+        } else {
+            already_cached_links.emplace_back(item.src_key, bhash);
+        }
+    }
+
+    for (const auto& [skey, bhash] : already_cached_links) {
+        auto bit = shader_mods_.find(bhash);
+        if (bit != shader_mods_.end() && bit->second != VK_NULL_HANDLE) {
+            shader_src_[skey] = bhash;
+            if (cache_enabled_) {
+                std::lock_guard<std::mutex> lock(cache_lock_);
+                if (known_src_keys_.insert(skey).second) {
+                    src_meta_entries_.push_back(SrcMetaEntry{skey, bhash});
+                    meta_dirty_ = true;
+                    cache_dirty_frame_ = presents_;
+                }
+            }
+        }
+    }
+
+    if (work.empty()) return 0;
+
+    // Ensure glslang is initialized once before worker threads run
+    {
+        std::vector<uint32_t> dummy_spv;
+        std::string dummy_err;
+        static bool glslang_ready = false;
+        if (!glslang_ready) {
+            glslang_ready = true;
+            CompileHlslToSpirv("float4 main() : SV_Target { return 0; }", "main", "ps_5_0", dummy_spv, dummy_err);
+        }
+    }
+
+    g_warmup_total.fetch_add(uint32_t(work.size()), std::memory_order_relaxed);
+    std::vector<std::vector<uint32_t>> out_spv(work.size());
+    std::atomic<size_t> cursor{0};
+    uint32_t max_jobs = std::max<uint32_t>(1u, app::RecommendedCompileJobs());
+    uint32_t n_threads = std::min<uint32_t>({12u, max_jobs, uint32_t(work.size())});
+
+    auto worker = [&] {
+        for (;;) {
+            size_t idx = cursor.fetch_add(1, std::memory_order_relaxed);
+            if (idx >= work.size()) break;
+            const WorkItem& w = work[idx];
+            const char* profile = w.is_pixel ? "ps_5_0" : "vs_5_0";
+            std::vector<uint32_t> spv;
+            std::string err;
+            if (CompileHlslToSpirv(*w.hlsl, "main", profile, spv, err) && !spv.empty()) {
+                out_spv[idx] = std::move(spv);
+            }
+            g_warmup_done.fetch_add(1u, std::memory_order_relaxed);
+        }
+    };
+
+    std::vector<std::thread> pool;
+    pool.reserve(n_threads > 1 ? n_threads - 1 : 0);
+    for (uint32_t t = 1; t < n_threads; ++t) pool.emplace_back(worker);
+    worker();
+    for (auto& th : pool) th.join();
+
+    size_t compiled = 0;
+    for (size_t i = 0; i < work.size(); ++i) {
+        if (out_spv[i].empty()) continue;
+        const WorkItem& w = work[i];
+        VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+        ci.codeSize = out_spv[i].size() * sizeof(uint32_t);
+        ci.pCode = out_spv[i].data();
+        VkShaderModule mod = VK_NULL_HANDLE;
+        if (vk_.create_shader(dev_, &ci, nullptr, &mod) != VK_SUCCESS || mod == VK_NULL_HANDLE) continue;
+        shader_mods_[w.blob_hash] = mod;
+        shader_src_[w.src_key] = w.blob_hash;
+        ++compiled;
+        if (cache_enabled_) {
+            std::lock_guard<std::mutex> lock(cache_lock_);
+            shader_cache_entries_.emplace_back(w.blob_hash, std::move(out_spv[i]));
+            shaders_dirty_ = true;
+            if (known_src_keys_.insert(w.src_key).second) {
+                src_meta_entries_.push_back(SrcMetaEntry{w.src_key, w.blob_hash});
+                meta_dirty_ = true;
+            }
+            cache_dirty_frame_ = presents_;
+        }
+    }
+    for (const auto& [skey, bhash] : already_cached_links) {
+        auto bit = shader_mods_.find(bhash);
+        if (bit != shader_mods_.end() && bit->second != VK_NULL_HANDLE && !shader_src_.count(skey)) {
+            shader_src_[skey] = bhash;
+            if (cache_enabled_) {
+                std::lock_guard<std::mutex> lock(cache_lock_);
+                if (known_src_keys_.insert(skey).second) {
+                    src_meta_entries_.push_back(SrcMetaEntry{skey, bhash});
+                    meta_dirty_ = true;
+                }
+            }
+        }
+    }
+    g_warmup_compiled_new.fetch_add(uint32_t(compiled), std::memory_order_relaxed);
+    return compiled;
+}
+
+void VulkanBackend::LoadAndPrewarmRecipes() {
+    constexpr uint64_t kSalt = 0x9E3779B97F4A7C15ull;
+    std::vector<ShaderPrewarmItem> batch;
+
+    if (cache_enabled_ && !cache_dir_.empty()) {
+        std::filesystem::path rpath = cache_dir_ / "shader_recipes.bin";
+        std::error_code ec;
+        auto fsize = std::filesystem::file_size(rpath, ec);
+        if (!ec && fsize >= sizeof(RecipeCacheHeader)) {
+            if (FILE* f = std::fopen(rpath.c_str(), "rb")) {
+                RecipeCacheHeader rh{};
+                bool ok = std::fread(&rh, sizeof(rh), 1, f) == 1 && rh.magic == kRecipeCacheMagic &&
+                          rh.version == kRecipeCacheVersion && rh.sizeof_fixed_vs == sizeof(FixedVsRecipe) &&
+                          rh.sizeof_pixel_ps == sizeof(PixelRecipe) && rh.fixed_vs_count <= 65536u &&
+                          rh.pixel_ps_count <= 65536u;
+                uint64_t expect = uint64_t(sizeof(rh)) + uint64_t(rh.fixed_vs_count) * sizeof(FixedVsRecipe) +
+                                  uint64_t(rh.pixel_ps_count) * sizeof(PixelRecipe);
+                if (ok && expect == fsize) {
+                    std::vector<FixedVsRecipe> fv(rh.fixed_vs_count);
+                    std::vector<PixelRecipe> pp(rh.pixel_ps_count);
+                    if (rh.fixed_vs_count &&
+                        std::fread(fv.data(), sizeof(FixedVsRecipe), rh.fixed_vs_count, f) != rh.fixed_vs_count)
+                        ok = false;
+                    if (ok && rh.pixel_ps_count &&
+                        std::fread(pp.data(), sizeof(PixelRecipe), rh.pixel_ps_count, f) != rh.pixel_ps_count)
+                        ok = false;
+                    if (ok) {
+                        for (const auto& r : fv) {
+                            if (known_fixed_vs_recipes_.insert(r.vkey).second) fixed_vs_recipes_.push_back(r);
+                            if (!shader_src_.count(r.vkey)) {
+                                std::string hlsl = ReversedDepthHlsl(
+                                    FixedVertexHlsl(r.regs, r.pretransformed != 0, r.decode, r.fk));
+                                batch.push_back(ShaderPrewarmItem{
+                                    r.vkey, false, r.quad ? QuadHlsl(std::move(hlsl)) : std::move(hlsl)});
+                            }
+                        }
+                        for (const auto& r : pp) {
+                            if (known_pixel_ps_recipes_.insert(r.key).second) pixel_ps_recipes_.push_back(r);
+                            if (!shader_src_.count(r.key)) {
+                                batch.push_back(ShaderPrewarmItem{r.key, true, PixelHlsl(r.pk)});
+                            }
+                        }
+                    }
+                }
+                std::fclose(f);
+            }
+        }
+    }
+
+    auto seeds = BuildCommonFixedShaderPrewarmBatch(kSalt);
+    for (auto& s : seeds) {
+        if (!shader_src_.count(s.src_key)) batch.push_back(std::move(s));
+    }
+    if (!batch.empty()) {
+        auto t0 = PerfClock::now();
+        size_t n = CompileBatchParallel(batch);
+        if (n > 0) {
+            LOGR("vulkan: pre-compiled %zu fixed/recipe shaders at startup in %.1f ms", n, PerfMs(t0));
+        }
+    }
+}
+
+size_t VulkanBackend::BuildDeferredPsos() {
+    if (deferred_pso_keys_.empty()) return 0;
+    std::vector<PsoKey> remaining;
+    uint64_t gh = 0;
+    VkShaderModule point_gs = Compile(PointHlsl(), "main", "gs_5_0", gh);
+    VkShaderModule sprite_gs = Compile(SpriteHlsl(), "main", "gs_5_0", gh);
+    struct DeferredItem {
+        uint64_t hash = 0;
+        PsoKey k{};
+        VkShaderModule vs = VK_NULL_HANDLE;
+        VkShaderModule ps = VK_NULL_HANDLE;
+        VkShaderModule gs = VK_NULL_HANDLE;
+        VkRenderPass rp = VK_NULL_HANDLE;
+    };
+    std::vector<DeferredItem> ready;
+    for (const auto& k : deferred_pso_keys_) {
+        uint64_t h = Hash(&k, sizeof(k));
+        if (psos_.count(h)) continue;
+        auto vit = shader_mods_.find(k.vs);
+        auto pit = shader_mods_.find(k.ps);
+        if (vit == shader_mods_.end() || vit->second == VK_NULL_HANDLE || pit == shader_mods_.end() ||
+            pit->second == VK_NULL_HANDLE) {
+            remaining.push_back(k);
+            continue;
+        }
+        VkShaderModule gs =
+            (k.topo == uint32_t(Topology::Points)) ? (k.sprite ? sprite_gs : point_gs) : VK_NULL_HANDLE;
+        VkRenderPass rp = GetRenderPass(k.has_rt ? VkFormat(k.rtfmt) : VK_FORMAT_UNDEFINED,
+                                        k.has_ds ? depth_fmt_ : VK_FORMAT_UNDEFINED);
+        if (rp == VK_NULL_HANDLE) continue;
+        ready.push_back(DeferredItem{h, k, vit->second, pit->second, gs, rp});
+    }
+    deferred_pso_keys_ = std::move(remaining);
+    if (ready.empty()) return 0;
+
+    std::vector<VkPipeline> out_pipes(ready.size(), VK_NULL_HANDLE);
+    std::atomic<size_t> cursor{0};
+    uint32_t max_jobs = std::max<uint32_t>(1u, app::RecommendedCompileJobs());
+    uint32_t n_threads = std::min<uint32_t>({12u, max_jobs, uint32_t(ready.size())});
+    auto worker = [&] {
+        for (;;) {
+            size_t idx = cursor.fetch_add(1, std::memory_order_relaxed);
+            if (idx >= ready.size()) break;
+            const auto& it = ready[idx];
+            const PsoKey& k = it.k;
+            VkPipelineShaderStageCreateInfo stages[3]{};
+            uint32_t stage_cnt = 0;
+            stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                   VK_SHADER_STAGE_VERTEX_BIT, it.vs, "main", nullptr};
+            bool expanded_points = false;
+            if (k.topo == uint32_t(Topology::Points) && it.gs != VK_NULL_HANDLE) {
+                stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                       VK_SHADER_STAGE_GEOMETRY_BIT, it.gs, "main", nullptr};
+                expanded_points = true;
+            }
+            stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                   VK_SHADER_STAGE_FRAGMENT_BIT, it.ps, "main", nullptr};
+            VkVertexInputBindingDescription vbinds[16]{};
+            for (uint32_t i = 0; i < k.buf_count && i < 16; ++i)
+                vbinds[i] = {i, k.strides[i], VK_VERTEX_INPUT_RATE_VERTEX};
+            VkVertexInputAttributeDescription vattrs[16]{};
+            uint32_t attr_cnt = 0;
+            for (uint32_t r = 0; r < 16; ++r) {
+                if (!((k.regs >> r) & 1)) continue;
+                uint32_t e = k.elements[r];
+                vattrs[attr_cnt++] = {r, (e >> 8) & 0xFF, DxgiToVkFormat(DXGI_FORMAT(e & 0xFF)), e >> 16};
+            }
+            VkPipelineVertexInputStateCreateInfo vi{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+            vi.vertexBindingDescriptionCount = std::min<uint32_t>(k.buf_count, 16u);
+            vi.pVertexBindingDescriptions = vbinds;
+            vi.vertexAttributeDescriptionCount = attr_cnt;
+            vi.pVertexAttributeDescriptions = vattrs;
+            VkPipelineInputAssemblyStateCreateInfo ia{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+            ia.topology = VkTopologyOf(k.topo, k.strip);
+            VkPipelineViewportStateCreateInfo vp{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+            vp.viewportCount = 1;
+            vp.scissorCount = 1;
+            VkPipelineRasterizationStateCreateInfo rs{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+            rs.polygonMode = (!expanded_points && k.fill == kFillWireframe) ? VK_POLYGON_MODE_LINE : VK_POLYGON_MODE_FILL;
+            rs.cullMode = (!expanded_points && k.cull) ? VK_CULL_MODE_BACK_BIT : VK_CULL_MODE_NONE;
+            rs.frontFace = (!expanded_points && k.ccw) ? VK_FRONT_FACE_COUNTER_CLOCKWISE : VK_FRONT_FACE_CLOCKWISE;
+            rs.depthBiasEnable = (k.zbias != 0 || k.zslope != 0.0f) ? VK_TRUE : VK_FALSE;
+            rs.depthBiasConstantFactor = float(k.zbias);
+            rs.depthBiasSlopeFactor = k.zslope;
+            rs.lineWidth = 1.0f;
+            VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+            ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+            VkPipelineDepthStencilStateCreateInfo ds{VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+            ds.depthTestEnable = k.zen ? VK_TRUE : VK_FALSE;
+            ds.depthWriteEnable = k.zwrite ? VK_TRUE : VK_FALSE;
+            ds.depthCompareOp = ReversedCmpVk(k.zfunc);
+            ds.stencilTestEnable = k.sten ? VK_TRUE : VK_FALSE;
+            VkStencilOpState sop{};
+            sop.failOp = StencilOpVk(k.sfail);
+            sop.passOp = StencilOpVk(k.spass);
+            sop.depthFailOp = StencilOpVk(k.szfail);
+            sop.compareOp = CmpVk(k.sfunc);
+            sop.compareMask = k.smask;
+            sop.writeMask = k.swmask;
+            ds.front = ds.back = sop;
+            VkPipelineColorBlendAttachmentState ba{};
+            ba.blendEnable = k.blend ? VK_TRUE : VK_FALSE;
+            ba.srcColorBlendFactor = BlendFactor(k.src, false);
+            ba.dstColorBlendFactor = BlendFactor(k.dst, false);
+            ba.colorBlendOp = BlendOpVk(k.op);
+            ba.srcAlphaBlendFactor = BlendFactor(k.src, true);
+            ba.dstAlphaBlendFactor = BlendFactor(k.dst, true);
+            ba.alphaBlendOp = BlendOpVk(k.op);
+            ba.colorWriteMask = k.wmask & 0xF;
+            VkPipelineColorBlendStateCreateInfo cb{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+            cb.attachmentCount = k.has_rt ? 1u : 0u;
+            cb.pAttachments = k.has_rt ? &ba : nullptr;
+            VkDynamicState dyn_states[4] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR,
+                                            VK_DYNAMIC_STATE_BLEND_CONSTANTS, VK_DYNAMIC_STATE_STENCIL_REFERENCE};
+            VkPipelineDynamicStateCreateInfo dyn{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+            dyn.dynamicStateCount = 4;
+            dyn.pDynamicStates = dyn_states;
+            VkGraphicsPipelineCreateInfo gi{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+            gi.stageCount = stage_cnt;
+            gi.pStages = stages;
+            gi.pVertexInputState = &vi;
+            gi.pInputAssemblyState = &ia;
+            gi.pViewportState = &vp;
+            gi.pRasterizationState = &rs;
+            gi.pMultisampleState = &ms;
+            gi.pDepthStencilState = &ds;
+            gi.pColorBlendState = &cb;
+            gi.pDynamicState = &dyn;
+            gi.layout = gfx_layout_;
+            gi.renderPass = it.rp;
+            gi.subpass = 0;
+            VkPipeline pipe = VK_NULL_HANDLE;
+            if (vk_.create_gfx_pipes(dev_, pipe_cache_, 1, &gi, nullptr, &pipe) == VK_SUCCESS) {
+                out_pipes[idx] = pipe;
+            }
+        }
+    };
+    std::vector<std::thread> pool;
+    pool.reserve(n_threads > 1 ? n_threads - 1 : 0);
+    for (uint32_t t = 1; t < n_threads; ++t) pool.emplace_back(worker);
+    worker();
+    for (auto& th : pool) th.join();
+
+    size_t deferred_built = 0;
+    for (size_t i = 0; i < ready.size(); ++i) {
+        if (out_pipes[i] == VK_NULL_HANDLE) continue;
+        psos_[ready[i].hash] = out_pipes[i];
+        if (known_pso_keys_.insert(ready[i].hash).second) pso_meta_entries_.push_back(ready[i].k);
+        pso_dirty_ = true;
+        ++deferred_built;
+    }
+    return deferred_built;
+}
+
+void VulkanBackend::DrainAsyncPrewarm(bool wait) {
+    if (!async_pw_running_.load(std::memory_order_acquire)) return;
+    if (wait && async_pw_thread_.joinable()) async_pw_thread_.join();
+
+    auto ingest = [&](std::vector<AsyncReadyShader>& list) {
+        for (auto& r : list) {
+            if (r.spv.empty()) continue;
+            bool new_mod = !shader_mods_.count(r.blob_hash) || shader_mods_[r.blob_hash] == VK_NULL_HANDLE;
+            if (new_mod) {
+                VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+                ci.codeSize = r.spv.size() * sizeof(uint32_t);
+                ci.pCode = r.spv.data();
+                VkShaderModule mod = VK_NULL_HANDLE;
+                if (vk_.create_shader(dev_, &ci, nullptr, &mod) != VK_SUCCESS || mod == VK_NULL_HANDLE) continue;
+                shader_mods_[r.blob_hash] = mod;
+                ++async_pw_compiled_;
+                g_warmup_compiled_new.fetch_add(1u, std::memory_order_relaxed);
+            }
+            shader_src_[r.src_key] = r.blob_hash;
+            if (cache_enabled_) {
+                std::lock_guard<std::mutex> lock(cache_lock_);
+                if (new_mod) {
+                    shader_cache_entries_.emplace_back(r.blob_hash, std::move(r.spv));
+                    shaders_dirty_ = true;
+                }
+                if (known_src_keys_.insert(r.src_key).second) {
+                    src_meta_entries_.push_back(SrcMetaEntry{r.src_key, r.blob_hash});
+                    meta_dirty_ = true;
+                }
+                cache_dirty_frame_ = presents_;
+            }
+        }
+    };
+
+    std::vector<AsyncReadyShader> ready;
+    {
+        std::lock_guard<std::mutex> lock(async_pw_mtx_);
+        ready.swap(async_pw_ready_);
+    }
+    ingest(ready);
+
+    if (wait || async_pw_done_flag_.load(std::memory_order_acquire)) {
+        if (async_pw_thread_.joinable()) async_pw_thread_.join();
+        std::vector<AsyncReadyShader> tail;
+        {
+            std::lock_guard<std::mutex> lock(async_pw_mtx_);
+            tail.swap(async_pw_ready_);
+        }
+        ingest(tail);
+        for (const auto& [skey, bhash] : async_pw_links_) {
+            auto bit = shader_mods_.find(bhash);
+            if (bit != shader_mods_.end() && bit->second != VK_NULL_HANDLE && !shader_src_.count(skey)) {
+                shader_src_[skey] = bhash;
+                if (cache_enabled_) {
+                    std::lock_guard<std::mutex> lock(cache_lock_);
+                    if (known_src_keys_.insert(skey).second) {
+                        src_meta_entries_.push_back(SrcMetaEntry{skey, bhash});
+                        meta_dirty_ = true;
+                    }
+                }
+            }
+        }
+        async_pw_links_.clear();
+        async_pw_running_.store(false, std::memory_order_release);
+        size_t deferred_built = BuildDeferredPsos();
+        double ms = PerfMs(async_pw_t0_);
+        g_warmup_elapsed_us.fetch_add(uint64_t(ms * 1000.0), std::memory_order_relaxed);
+        g_warmup_active.store(false, std::memory_order_release);
+        g_warmup_completed.store(true, std::memory_order_release);
+        g_warmup_completed_ms.store(NowMonoMs(), std::memory_order_release);
+        if (async_pw_compiled_ > 0 || deferred_built > 0) {
+            LOGR("vulkan: guest shader prewarm done in %.1f ms (async, vs_in=%zu, ps_in=%zu, compiled_new=%zu, deferred_psos=%zu, total_shaders=%zu)",
+                 ms, async_pw_vs_in_, async_pw_ps_in_, async_pw_compiled_, deferred_built,
+                 shader_cache_entries_.size());
+            SaveCaches(false, !frame_camera_.is_3d_gameplay);
+        }
+        PublishCacheStats();
+    }
+}
+
+void VulkanBackend::StopAsyncPrewarm() {
+    if (!async_pw_running_.load(std::memory_order_acquire) && !async_pw_thread_.joinable()) return;
+    async_pw_stop_.store(true, std::memory_order_release);
+    DrainAsyncPrewarm(true);
+    async_pw_stop_.store(false, std::memory_order_release);
+}
+
+void VulkanBackend::PrewarmGuestShaders(const std::vector<VertexShader>& vs_list,
+                                        const std::vector<PixelShader>& ps_list) {
+    if (vs_list.empty() && ps_list.empty()) return;
+    if (async_pw_running_.load(std::memory_order_acquire)) DrainAsyncPrewarm(true);
+    constexpr uint64_t kSalt = 0x9E3779B97F4A7C15ull;
+    auto t0 = PerfClock::now();
+    auto batch = BuildGuestShaderPrewarmBatch(vs_list, ps_list, kSalt);
+
+    struct AsyncWorkItem {
+        uint64_t src_key = 0;
+        uint64_t blob_hash = 0;
+        bool is_pixel = false;
+        std::string hlsl;
+    };
+    std::vector<AsyncWorkItem> work;
+    std::unordered_set<uint64_t> queued_blobs;
+    std::vector<std::pair<uint64_t, uint64_t>> cached_links;
+    std::vector<std::pair<uint64_t, uint64_t>> secondary_links;
+
+    for (auto& item : batch) {
+        if (shader_src_.count(item.src_key)) continue;
+        const char* profile = item.is_pixel ? "ps_5_0" : "vs_5_0";
+        uint64_t pseed = Hash(profile, std::strlen(profile));
+        uint64_t eseed = Hash("main", 4, pseed);
+        uint64_t bhash = Hash(item.hlsl.data(), item.hlsl.size(), eseed);
+        auto bit = shader_mods_.find(bhash);
+        if (bit != shader_mods_.end() && bit->second != VK_NULL_HANDLE) {
+            cached_links.emplace_back(item.src_key, bhash);
+            continue;
+        }
+        if (queued_blobs.insert(bhash).second) {
+            work.push_back(AsyncWorkItem{item.src_key, bhash, item.is_pixel, std::move(item.hlsl)});
+        } else {
+            secondary_links.emplace_back(item.src_key, bhash);
+        }
+    }
+
+    for (const auto& [skey, bhash] : cached_links) {
+        shader_src_[skey] = bhash;
+        if (cache_enabled_) {
+            std::lock_guard<std::mutex> lock(cache_lock_);
+            if (known_src_keys_.insert(skey).second) {
+                src_meta_entries_.push_back(SrcMetaEntry{skey, bhash});
+                meta_dirty_ = true;
+                cache_dirty_frame_ = presents_;
+            }
+        }
+    }
+
+    bool sync_mode = !cli_cap_bmp_.empty() || app::IsReplayOrAutotestActive() || work.size() <= 32;
+    if (!work.empty() && !sync_mode) {
+        {
+            std::vector<uint32_t> dummy_spv;
+            std::string dummy_err;
+            CompileHlslToSpirv("float4 main() : SV_Target { return 0; }", "main", "ps_5_0", dummy_spv, dummy_err);
+        }
+        g_warmup_active.store(true, std::memory_order_release);
+        g_warmup_total.fetch_add(uint32_t(work.size()), std::memory_order_relaxed);
+        async_pw_t0_ = t0;
+        async_pw_vs_in_ = vs_list.size();
+        async_pw_ps_in_ = ps_list.size();
+        async_pw_compiled_ = 0;
+        async_pw_links_ = std::move(secondary_links);
+        async_pw_done_flag_.store(false, std::memory_order_release);
+        async_pw_stop_.store(false, std::memory_order_release);
+        async_pw_running_.store(true, std::memory_order_release);
+
+        uint32_t max_jobs = std::max<uint32_t>(1u, app::RecommendedCompileJobs());
+        uint32_t n_threads = std::min<uint32_t>({10u, max_jobs, uint32_t(work.size())});
+        async_pw_thread_ = std::thread([this, wlist = std::move(work), n_threads]() {
+            std::atomic<size_t> cursor{0};
+            auto worker = [&] {
+                for (;;) {
+                    if (async_pw_stop_.load(std::memory_order_relaxed)) break;
+                    size_t idx = cursor.fetch_add(1, std::memory_order_relaxed);
+                    if (idx >= wlist.size()) break;
+                    const auto& w = wlist[idx];
+                    const char* profile = w.is_pixel ? "ps_5_0" : "vs_5_0";
+                    std::vector<uint32_t> spv;
+                    std::string err;
+                    if (CompileHlslToSpirv(w.hlsl, "main", profile, spv, err) && !spv.empty()) {
+                        std::lock_guard<std::mutex> lock(async_pw_mtx_);
+                        async_pw_ready_.push_back(AsyncReadyShader{w.src_key, w.blob_hash, std::move(spv)});
+                    }
+                    g_warmup_done.fetch_add(1u, std::memory_order_relaxed);
+                }
+            };
+            std::vector<std::thread> pool;
+            pool.reserve(n_threads > 1 ? n_threads - 1 : 0);
+            for (uint32_t t = 1; t < n_threads; ++t) pool.emplace_back(worker);
+            worker();
+            for (auto& th : pool) th.join();
+            async_pw_done_flag_.store(true, std::memory_order_release);
+        });
+        return;
+    }
+
+    size_t compiled = 0;
+    if (!work.empty()) {
+        g_warmup_active.store(true, std::memory_order_release);
+        std::vector<ShaderPrewarmItem> sync_batch;
+        sync_batch.reserve(work.size());
+        for (auto& w : work) sync_batch.push_back(ShaderPrewarmItem{w.src_key, w.is_pixel, std::move(w.hlsl)});
+        compiled = CompileBatchParallel(sync_batch);
+        for (const auto& [skey, bhash] : secondary_links) {
+            auto bit = shader_mods_.find(bhash);
+            if (bit != shader_mods_.end() && bit->second != VK_NULL_HANDLE && !shader_src_.count(skey)) {
+                shader_src_[skey] = bhash;
+                if (cache_enabled_) {
+                    std::lock_guard<std::mutex> lock(cache_lock_);
+                    if (known_src_keys_.insert(skey).second) {
+                        src_meta_entries_.push_back(SrcMetaEntry{skey, bhash});
+                        meta_dirty_ = true;
+                    }
+                }
+            }
+        }
+    }
+
+    size_t deferred_built = BuildDeferredPsos();
+    double ms = PerfMs(t0);
+    g_warmup_elapsed_us.fetch_add(uint64_t(ms * 1000.0), std::memory_order_relaxed);
+    g_warmup_active.store(false, std::memory_order_release);
+    g_warmup_completed.store(true, std::memory_order_release);
+    g_warmup_completed_ms.store(NowMonoMs(), std::memory_order_release);
+
+    if (compiled > 0 || deferred_built > 0) {
+        LOGR("vulkan: guest shader prewarm done in %.1f ms (vs_in=%zu, ps_in=%zu, compiled_new=%zu, deferred_psos=%zu, total_shaders=%zu)",
+             ms, vs_list.size(), ps_list.size(), compiled, deferred_built, shader_cache_entries_.size());
+        SaveCaches(false, presents_ == 0 || !frame_camera_.is_3d_gameplay);
+    }
+    PublishCacheStats();
+}
+
+void VulkanBackend::PrewarmCachedPsos() {
+    if (!cache_enabled_ || cache_dir_.empty()) return;
+    std::filesystem::path meta_path = PsoMetaPath();
+    std::error_code ec;
+    auto fsize = std::filesystem::file_size(meta_path, ec);
+    if (ec || fsize < sizeof(VkPsoMetaHeader)) return;
+    FILE* f = std::fopen(meta_path.c_str(), "rb");
+    if (!f) return;
+    VkPsoMetaHeader hdr{};
+    // Note: PsoKey & SrcMetaEntry are driver-version/UUID independent, so we keep prewarming PSOs across Mesa/driver updates!
+    bool ok = std::fread(&hdr, sizeof(hdr), 1, f) == 1 && hdr.magic == kVkPsoMetaMagic &&
+              hdr.version == kVkPsoMetaVersion && hdr.sizeof_pso_key == sizeof(PsoKey) &&
+              hdr.src_count <= 65536u && hdr.pso_count <= 65536u;
+    uint64_t expect = uint64_t(sizeof(VkPsoMetaHeader)) + uint64_t(hdr.src_count) * sizeof(SrcMetaEntry) +
+                      uint64_t(hdr.pso_count) * sizeof(PsoKey);
+    if (!ok || expect != fsize) {
+        std::fclose(f);
+        return;
+    }
+    std::vector<SrcMetaEntry> src_loaded(hdr.src_count);
+    std::vector<PsoKey> pso_loaded(hdr.pso_count);
+    if (hdr.src_count && std::fread(src_loaded.data(), sizeof(SrcMetaEntry), hdr.src_count, f) != hdr.src_count)
+        ok = false;
+    if (ok && hdr.pso_count && std::fread(pso_loaded.data(), sizeof(PsoKey), hdr.pso_count, f) != hdr.pso_count)
+        ok = false;
+    std::fclose(f);
+    if (!ok) return;
+
+    auto t0 = PerfClock::now();
+    size_t restored_src = 0;
+    for (const auto& e : src_loaded) {
+        auto bit = shader_mods_.find(e.blob_hash);
+        if (bit != shader_mods_.end() && bit->second != VK_NULL_HANDLE) {
+            shader_src_[e.src_key] = e.blob_hash;
+            if (known_src_keys_.insert(e.src_key).second) src_meta_entries_.push_back(e);
+            restored_src++;
+        }
+    }
+
+    // Single-threaded prep: pre-compile point/sprite GS and pre-create all VkRenderPasses before worker spawn
+    bool need_point_gs = false, need_sprite_gs = false;
+    for (const auto& k : pso_loaded) {
+        if (k.topo == uint32_t(Topology::Points)) {
+            if (k.sprite) need_sprite_gs = true;
+            else need_point_gs = true;
+        }
+    }
+    VkShaderModule point_gs = VK_NULL_HANDLE;
+    VkShaderModule sprite_gs = VK_NULL_HANDLE;
+    if (need_point_gs) {
+        uint64_t gh = 0;
+        point_gs = Compile(PointHlsl(), "main", "gs_5_0", gh);
+    }
+    if (need_sprite_gs) {
+        uint64_t gh = 0;
+        sprite_gs = Compile(SpriteHlsl(), "main", "gs_5_0", gh);
+    }
+
+    struct PrepItem {
+        uint64_t hash = 0;
+        PsoKey k{};
+        VkShaderModule vs = VK_NULL_HANDLE;
+        VkShaderModule ps = VK_NULL_HANDLE;
+        VkShaderModule gs = VK_NULL_HANDLE;
+        VkRenderPass rp = VK_NULL_HANDLE;
+    };
+    std::vector<PrepItem> items;
+    items.reserve(pso_loaded.size());
+    std::unordered_set<uint64_t> seen_hashes;
+    for (const auto& k : pso_loaded) {
+        uint64_t h = Hash(&k, sizeof(k));
+        if (psos_.count(h) || !seen_hashes.insert(h).second) continue;
+        auto vit = shader_mods_.find(k.vs);
+        auto pit = shader_mods_.find(k.ps);
+        if (vit == shader_mods_.end() || vit->second == VK_NULL_HANDLE || pit == shader_mods_.end() ||
+            pit->second == VK_NULL_HANDLE) {
+            deferred_pso_keys_.push_back(k);
+            continue;
+        }
+        VkShaderModule gs = VK_NULL_HANDLE;
+        if (k.topo == uint32_t(Topology::Points)) {
+            gs = k.sprite ? sprite_gs : point_gs;
+        }
+        VkRenderPass rp = GetRenderPass(k.has_rt ? VkFormat(k.rtfmt) : VK_FORMAT_UNDEFINED,
+                                        k.has_ds ? depth_fmt_ : VK_FORMAT_UNDEFINED);
+        if (rp == VK_NULL_HANDLE) continue;
+        items.push_back(PrepItem{h, k, vit->second, pit->second, gs, rp});
+    }
+    if (items.empty()) {
+        LOGR("vulkan: metadata restored (%zu src mappings, 0 PSOs to prewarm)", restored_src);
+        return;
+    }
+
+    std::vector<VkPipeline> results(items.size(), VK_NULL_HANDLE);
+    std::atomic<size_t> cursor{0};
+    uint32_t max_jobs = std::max<uint32_t>(1u, app::RecommendedCompileJobs());
+    uint32_t n_threads = std::min<uint32_t>({12u, max_jobs, uint32_t(items.size())});
+    auto worker = [&] {
+        for (;;) {
+            size_t idx = cursor.fetch_add(1, std::memory_order_relaxed);
+            if (idx >= items.size()) break;
+            const PrepItem& it = items[idx];
+            const PsoKey& k = it.k;
+
+            VkPipelineShaderStageCreateInfo stages[3]{};
+            uint32_t stage_cnt = 0;
+            stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                   VK_SHADER_STAGE_VERTEX_BIT, it.vs, "main", nullptr};
+            bool expanded_points = false;
+            if (k.topo == uint32_t(Topology::Points) && it.gs != VK_NULL_HANDLE) {
+                stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                       VK_SHADER_STAGE_GEOMETRY_BIT, it.gs, "main", nullptr};
+                expanded_points = true;
+            }
+            stages[stage_cnt++] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+                                   VK_SHADER_STAGE_FRAGMENT_BIT, it.ps, "main", nullptr};
+
+            VkVertexInputBindingDescription vbinds[16]{};
+            for (uint32_t i = 0; i < k.buf_count && i < 16; ++i) {
+                vbinds[i] = {i, k.strides[i], VK_VERTEX_INPUT_RATE_VERTEX};
+            }
+            VkVertexInputAttributeDescription vattrs[16]{};
+            uint32_t attr_cnt = 0;
+            for (uint32_t r = 0; r < 16; ++r) {
+                if (!((k.regs >> r) & 1)) continue;
+                uint32_t e = k.elements[r];
+                vattrs[attr_cnt++] = {r, (e >> 8) & 0xFF, DxgiToVkFormat(DXGI_FORMAT(e & 0xFF)), e >> 16};
+            }
+
+            VkPipelineVertexInputStateCreateInfo vi{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+            vi.vertexBindingDescriptionCount = std::min<uint32_t>(k.buf_count, 16u);
+            vi.pVertexBindingDescriptions = vbinds;
+            vi.vertexAttributeDescriptionCount = attr_cnt;
+            vi.pVertexAttributeDescriptions = vattrs;
+
+            VkPipelineInputAssemblyStateCreateInfo ia{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+            ia.topology = VkTopologyOf(k.topo, k.strip);
+            ia.primitiveRestartEnable = VK_FALSE;
+
+            VkPipelineViewportStateCreateInfo vp{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+            vp.viewportCount = 1;
+            vp.scissorCount = 1;
+
+            VkPipelineRasterizationStateCreateInfo rs{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+            rs.polygonMode = (!expanded_points && k.fill == kFillWireframe) ? VK_POLYGON_MODE_LINE : VK_POLYGON_MODE_FILL;
+            rs.cullMode = (!expanded_points && k.cull) ? VK_CULL_MODE_BACK_BIT : VK_CULL_MODE_NONE;
+            rs.frontFace = (!expanded_points && k.ccw) ? VK_FRONT_FACE_COUNTER_CLOCKWISE : VK_FRONT_FACE_CLOCKWISE;
+            rs.depthBiasEnable = (k.zbias != 0 || k.zslope != 0.0f) ? VK_TRUE : VK_FALSE;
+            rs.depthBiasConstantFactor = float(k.zbias);
+            rs.depthBiasSlopeFactor = k.zslope;
+            rs.lineWidth = 1.0f;
+
+            VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+            ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+
+            VkPipelineDepthStencilStateCreateInfo ds{VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+            ds.depthTestEnable = k.zen ? VK_TRUE : VK_FALSE;
+            ds.depthWriteEnable = k.zwrite ? VK_TRUE : VK_FALSE;
+            ds.depthCompareOp = ReversedCmpVk(k.zfunc);
+            ds.stencilTestEnable = k.sten ? VK_TRUE : VK_FALSE;
+            VkStencilOpState sop{};
+            sop.failOp = StencilOpVk(k.sfail);
+            sop.passOp = StencilOpVk(k.spass);
+            sop.depthFailOp = StencilOpVk(k.szfail);
+            sop.compareOp = CmpVk(k.sfunc);
+            sop.compareMask = k.smask;
+            sop.writeMask = k.swmask;
+            ds.front = ds.back = sop;
+
+            VkPipelineColorBlendAttachmentState ba{};
+            ba.blendEnable = k.blend ? VK_TRUE : VK_FALSE;
+            ba.srcColorBlendFactor = BlendFactor(k.src, false);
+            ba.dstColorBlendFactor = BlendFactor(k.dst, false);
+            ba.colorBlendOp = BlendOpVk(k.op);
+            ba.srcAlphaBlendFactor = BlendFactor(k.src, true);
+            ba.dstAlphaBlendFactor = BlendFactor(k.dst, true);
+            ba.alphaBlendOp = BlendOpVk(k.op);
+            ba.colorWriteMask = k.wmask & 0xF;
+
+            VkPipelineColorBlendStateCreateInfo cb{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+            cb.attachmentCount = k.has_rt ? 1u : 0u;
+            cb.pAttachments = k.has_rt ? &ba : nullptr;
+
+            VkDynamicState dyn_states[4] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR,
+                                            VK_DYNAMIC_STATE_BLEND_CONSTANTS, VK_DYNAMIC_STATE_STENCIL_REFERENCE};
+            VkPipelineDynamicStateCreateInfo dyn{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+            dyn.dynamicStateCount = 4;
+            dyn.pDynamicStates = dyn_states;
+
+            VkGraphicsPipelineCreateInfo gi{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+            gi.stageCount = stage_cnt;
+            gi.pStages = stages;
+            gi.pVertexInputState = &vi;
+            gi.pInputAssemblyState = &ia;
+            gi.pViewportState = &vp;
+            gi.pRasterizationState = &rs;
+            gi.pMultisampleState = &ms;
+            gi.pDepthStencilState = &ds;
+            gi.pColorBlendState = &cb;
+            gi.pDynamicState = &dyn;
+            gi.layout = gfx_layout_;
+            gi.renderPass = it.rp;
+            gi.subpass = 0;
+
+            VkPipeline pipe = VK_NULL_HANDLE;
+            if (vk_.create_gfx_pipes(dev_, pipe_cache_, 1, &gi, nullptr, &pipe) == VK_SUCCESS) {
+                results[idx] = pipe;
+            }
+        }
+    };
+    std::vector<std::thread> pool;
+    pool.reserve(n_threads > 1 ? n_threads - 1 : 0);
+    for (uint32_t t = 1; t < n_threads; ++t) pool.emplace_back(worker);
+    worker();
+    for (auto& th : pool) th.join();
+
+    size_t built = 0;
+    for (size_t i = 0; i < items.size(); ++i) {
+        if (results[i] == VK_NULL_HANDLE) continue;
+        psos_[items[i].hash] = results[i];
+        if (known_pso_keys_.insert(items[i].hash).second) pso_meta_entries_.push_back(items[i].k);
+        if (perf::Enabled()) perf::RecordPsoCacheHit();
+        built++;
+    }
+    if (built > 0 && !pso_cache_loaded_) {
+        pso_dirty_ = true;
+        cache_dirty_frame_ = presents_;
+    }
+    LOGR("vulkan: startup prewarm done in %.1f ms (src=%zu, psos=%zu/%zu, threads=%u)", PerfMs(t0), restored_src, built,
+         items.size(), n_threads);
+}
