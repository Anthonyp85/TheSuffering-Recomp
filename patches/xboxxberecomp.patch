+const char* ClassifySpikeCause(const FrameSample& f) {
+    if (f.compile_ms + f.pso_ms >= 5.0) return "shader_pso_compile";
+    if (f.wait_resource_ms + f.wait_readback_ms + f.wait_fence_ms + f.wait_flush_ms >= 5.0) return "render_wait";
+    if (f.disc_ms + f.z_write_ms + f.z_read_ms >= 5.0) return "io_stall";
+    if (f.fence_wait_ms + f.wait_gpu_frame_ms >= 5.0) return "gpu_wait";
+    if (f.swap_call_ms >= 20.0) return "swap_vsync";
+    if (f.draw_ms + f.present_ms >= 10.0) return "render_cpu";
+    if (f.guest_ms - f.pace_ms >= 10.0) return "guest_cpu";
+    return "pacing_or_other";
+}
+
+void WritePhaseJson(FILE* fp, const char* name, const std::vector<const FrameSample*>& list, bool trailing_comma) {
+    std::fprintf(fp, "    \"%s\": {", name);
+    if (list.empty()) {
+        std::fprintf(fp, " \"frames\": 0 }%s\n", trailing_comma ? "," : "");
+        return;
+    }
+    std::vector<double> rms, gms, gdt, host_ms, gpu_ms;
+    rms.reserve(list.size());
+    gms.reserve(list.size());
+    gdt.reserve(list.size());
+    host_ms.reserve(list.size());
+    gpu_ms.reserve(list.size());
+
+    double sum_r = 0.0, sum_g = 0.0, sum_host = 0.0, sum_gpu = 0.0, sum_draws = 0.0;
+    double sum_pace = 0.0, sum_cap = 0.0, sum_guest_work = 0.0;
+    uint64_t gt16 = 0, gt33 = 0, gt50 = 0, gt100 = 0;
+    uint64_t dt_le15 = 0, dt_16 = 0, dt_17 = 0, dt_18_32 = 0, dt_ge33 = 0;
+    double first_elapsed = -1.0, last_elapsed = -1.0;
+
+    for (const FrameSample* f : list) {
+        rms.push_back(f->render_ms);
+        if (f->guest_ms > 0.0) gms.push_back(f->guest_ms);
+        if (f->g_dt_ms > 0.0f) {
+            double d = double(f->g_dt_ms);
+            gdt.push_back(d);
+            if (d <= 15.5) dt_le15++;
+            else if (d <= 16.5) dt_16++;
+            else if (d <= 17.5) dt_17++;
+            else if (d < 32.5) dt_18_32++;
+            else dt_ge33++;
+        }
+        if (f->g_elapsed_s > 0.0f) {
+            if (first_elapsed < 0.0) first_elapsed = f->g_elapsed_s;
+            last_elapsed = f->g_elapsed_s;
+        }
+        double h = f->draw_ms + f->clear_ms + f->copy_ms + f->sync_ms + f->present_ms;
+        host_ms.push_back(h);
+        gpu_ms.push_back(f->gpu_ms);
+        sum_r += f->render_ms;
+        sum_g += f->guest_ms;
+        sum_host += h;
+        sum_gpu += f->gpu_ms;
+        sum_draws += f->draws;
+        sum_pace += f->pace_ms;
+        sum_cap += f->guest_capture_ms;
+        sum_guest_work += std::max(0.0, f->guest_ms - f->pace_ms - f->guest_capture_ms - f->wait_gpu_frame_ms);
+        if (f->render_ms > 16.67) gt16++;
+        if (f->render_ms > 33.33) gt33++;
+        if (f->render_ms > 50.0) gt50++;
+        if (f->render_ms > 100.0) gt100++;
+    }
+
+    double n = double(list.size());
+    double dur_s = sum_r / 1000.0;
+    double mean_r = sum_r / n;
+    double avg_fps = mean_r > 0.0 ? 1000.0 / mean_r : 0.0;
+
+    std::vector<double> rms_sorted = rms;
+    double p50 = Percentile(rms_sorted, 0.50);
+    double p95 = Percentile(rms_sorted, 0.95);
+    double p99 = Percentile(rms_sorted, 0.99);
+    double p99_9 = Percentile(rms_sorted, 0.999);
+    double max_r = rms_sorted.back();
+
+    size_t worst1_n = std::max<size_t>(1, size_t(std::ceil(0.01 * double(rms_sorted.size()))));
+    double worst1_sum = 0.0;
+    for (size_t i = rms_sorted.size() - worst1_n; i < rms_sorted.size(); ++i) worst1_sum += rms_sorted[i];
+    double worst1_mean = worst1_sum / double(worst1_n);
+    double fps_1pct_low_mean = worst1_mean > 0.0 ? 1000.0 / worst1_mean : 0.0;
+    double fps_p99 = p99 > 0.0 ? 1000.0 / p99 : 0.0;
+
+    double gp50 = gms.empty() ? 0.0 : Percentile(gms, 0.50);
+    double gp99 = gms.empty() ? 0.0 : Percentile(gms, 0.99);
+    double host_p99 = Percentile(host_ms, 0.99);
+    double gpu_p99 = Percentile(gpu_ms, 0.99);
+
+    double dt_min = 0.0, dt_p50 = 0.0, dt_p99 = 0.0, dt_max = 0.0;
+    if (!gdt.empty()) {
+        std::sort(gdt.begin(), gdt.end());
+        dt_min = gdt.front();
+        dt_max = gdt.back();
+        dt_p50 = Percentile(gdt, 0.50);
+        dt_p99 = Percentile(gdt, 0.99);
+    }
+    double gtime_delta = (first_elapsed >= 0.0 && last_elapsed >= first_elapsed) ? (last_elapsed - first_elapsed) : 0.0;
+    double gtime_ratio = dur_s > 0.1 ? gtime_delta / dur_s : 0.0;
+
+    std::fprintf(fp,
+                 "\n"
+                 "      \"frames\": %zu, \"duration_s\": %.3f, \"avg_fps\": %.2f,\n"
+                 "      \"mean_ms\": %.3f, \"p50_ms\": %.3f, \"p95_ms\": %.3f, \"p99_ms\": %.3f, \"p99_9_ms\": %.3f, \"max_ms\": %.3f,\n"
+                 "      \"fps_1pct_low_mean\": %.2f, \"fps_p99\": %.2f,\n"
+                 "      \"gt_16_67ms\": %llu, \"gt_33_33ms\": %llu, \"gt_50ms\": %llu, \"gt_100ms\": %llu,\n"
+                 "      \"guest_p50_ms\": %.3f, \"guest_p99_ms\": %.3f,\n"
+                 "      \"guest_work_ms_avg\": %.3f, \"guest_capture_ms_avg\": %.3f, \"pace_ms_avg\": %.3f,\n"
+                 "      \"render_host_ms_avg\": %.3f, \"render_host_ms_p99\": %.3f,\n"
+                 "      \"gpu_ms_avg\": %.3f, \"gpu_ms_p99\": %.3f, \"draws_avg\": %.1f,\n"
+                 "      \"g_dt_ms_min\": %.2f, \"g_dt_ms_p50\": %.2f, \"g_dt_ms_p99\": %.2f, \"g_dt_ms_max\": %.2f,\n"
+                 "      \"g_dt_hist\": { \"le_15ms\": %llu, \"eq_16ms\": %llu, \"eq_17ms\": %llu, \"18_32ms\": %llu, \"ge_33ms\": %llu },\n"
+                 "      \"g_elapsed_delta_s\": %.3f, \"g_elapsed_to_wall_ratio\": %.4f\n"
+                 "    }%s\n",
+                 list.size(), dur_s, avg_fps, mean_r, p50, p95, p99, p99_9, max_r, fps_1pct_low_mean, fps_p99,
+                 (unsigned long long)gt16, (unsigned long long)gt33, (unsigned long long)gt50, (unsigned long long)gt100,
+                 gp50, gp99, sum_guest_work / n, sum_cap / n, sum_pace / n, sum_host / n, host_p99, sum_gpu / n,
+                 gpu_p99, sum_draws / n, dt_min, dt_p50, dt_p99, dt_max, (unsigned long long)dt_le15,
+                 (unsigned long long)dt_16, (unsigned long long)dt_17, (unsigned long long)dt_18_32,
+                 (unsigned long long)dt_ge33, gtime_delta, gtime_ratio, trailing_comma ? "," : "");
+}
+
+void WriteSpikesJson(FILE* fp, const char* key, std::vector<const FrameSample*> list, bool trailing_comma) {
+    std::sort(list.begin(), list.end(),
+              [](const FrameSample* a, const FrameSample* b) { return a->render_ms > b->render_ms; });
+    size_t lim = std::min<size_t>(15, list.size());
+    std::fprintf(fp, "  \"%s\": [\n", key);
+    for (size_t i = 0; i < lim; ++i) {
+        const FrameSample* f = list[i];
+        std::fprintf(fp,
+                     "    { \"frame\": %llu, \"t_s\": %.3f, \"phase\": \"%s\", \"render_ms\": %.3f, \"guest_ms\": %.3f, "
+                     "\"render_host_ms\": %.3f, \"gpu_ms\": %.3f, \"compile_ms\": %.3f, \"pso_ms\": %.3f, "
+                     "\"shaders\": %u, \"psos\": %u, \"wait_res_ms\": %.3f, \"wait_gpu_ms\": %.3f, "
+                     "\"swap_call_ms\": %.3f, \"disc_ms\": %.3f, \"z_write_ms\": %.3f, \"g_dt_ms\": %.2f, \"cause\": \"%s\" }%s\n",
+                     (unsigned long long)f->index, f->t_s, kPhaseNames[size_t(f->phase)], f->render_ms, f->guest_ms,
+                     f->draw_ms + f->clear_ms + f->copy_ms + f->sync_ms + f->present_ms, f->gpu_ms, f->compile_ms,
+                     f->pso_ms, f->shaders, f->psos, f->wait_resource_ms, f->wait_gpu_frame_ms, f->swap_call_ms,
+                     f->disc_ms, f->z_write_ms, f->g_dt_ms, ClassifySpikeCause(*f), (i + 1 < lim) ? "," : "");
+    }
+    std::fprintf(fp, "  ]%s\n", trailing_comma ? "," : "");
+}
+
+void FlushLocked(PerfState& st) {
+    if (st.json_path.empty()) return;
+    double wall_s = std::chrono::duration<double>(Clock::now() - st.start_tp).count();
+    if (wall_s <= 0.0) wall_s = 0.001;
+
+    uint64_t proc_cpu_delta = ProcessCpu100ns() - st.proc_cpu_start;
+#ifdef _WIN32
+    uint64_t title_cpu_delta = st.title_thread ? (ThreadCpu100ns(st.title_thread) - st.title_cpu_start) : 0;
+    uint64_t render_cpu_delta = st.render_thread ? (ThreadCpu100ns(st.render_thread) - st.render_cpu_start) : 0;
+#else
+    uint64_t title_cpu_delta = st.has_title_clock ? (Clock100ns(st.title_clock) - st.title_cpu_start) : 0;
+    uint64_t render_cpu_delta = st.has_render_clock ? (Clock100ns(st.render_clock) - st.render_cpu_start) : 0;
+#endif
+    double wall_100ns = wall_s * 1e7;
+    double proc_cpu_pct = 100.0 * double(proc_cpu_delta) / (wall_100ns * double(std::max(1u, st.logical_cpus)));
+    double title_cpu_pct = 100.0 * double(title_cpu_delta) / wall_100ns;
+    double render_cpu_pct = 100.0 * double(render_cpu_delta) / wall_100ns;
+
+#ifdef _WIN32
+    PROCESS_MEMORY_COUNTERS_EX pmc{};
+    pmc.cb = sizeof(pmc);
+    K32GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&pmc), sizeof(pmc));
+    uint64_t host_ws_final = pmc.WorkingSetSize;
+    uint64_t host_ws_peak = std::max<uint64_t>(st.host_ws_peak, pmc.PeakWorkingSetSize);
+    uint64_t host_priv_final = pmc.PrivateUsage;
+    uint64_t host_priv_peak = std::max<uint64_t>(st.host_priv_peak, pmc.PrivateUsage);
+    uint64_t page_faults = pmc.PageFaultCount >= st.page_faults_start ? pmc.PageFaultCount - st.page_faults_start : 0;
+#else
+    LinuxMemInfo lm = QueryLinuxMem();
+    uint64_t host_ws_final = lm.rss;
+    uint64_t host_ws_peak = std::max<uint64_t>(st.host_ws_peak, lm.hwm);
+    uint64_t host_priv_final = lm.priv;
+    uint64_t host_priv_peak = std::max<uint64_t>(st.host_priv_peak, lm.priv);
+    uint64_t page_faults = lm.page_faults >= st.page_faults_start ? lm.page_faults - st.page_faults_start : 0;
+#endif
+
+    mem::Stats ms = mem::Query();
+    st.guest_contig_peak_pages = std::max<uint64_t>(st.guest_contig_peak_pages, ms.contiguous_used);
+    st.guest_virt_peak_pages = std::max<uint64_t>(st.guest_virt_peak_pages, ms.virtual_committed);
+    st.guest_sys_peak_pages = std::max<uint64_t>(st.guest_sys_peak_pages, ms.system_used);
+
+    std::vector<FrameSample> snap;
+    {
+        std::lock_guard<std::mutex> lock(st.samples_lock);
+        snap = st.samples;
+    }
+
+    std::error_code ec;
+    std::filesystem::path jp(st.json_path);
+    if (jp.has_parent_path()) std::filesystem::create_directories(jp.parent_path(), ec);
+
+    // 1. Write per-frame CSV
+    if (!st.csv_path.empty()) {
+        if (FILE* cf = std::fopen(st.csv_path.c_str(), "wb")) {
+            std::fprintf(cf,
+                         "frame,t_s,phase,render_ms,guest_ms,guest_capture_ms,pace_ms,swap_phase1_ms,wait_gpu_ms,"
+                         "draw_ms,assemble_ms,bind_ms,sig_ms,texup_ms,clear_ms,copy_ms,sync_ms,present_ms,swap_call_ms,"
+                         "fence_wait_ms,gpu_ms,compile_ms,pso_ms,shaders,psos,wait_res_ms,glock_bg_ms,disc_ms,z_write_ms,"
+                         "draws,upload_bytes,contig_alloc_bytes,g_dt_ms,g_elapsed_s,g_frame\n");
+            for (const FrameSample& f : snap) {
+                std::fprintf(cf,
+                             "%llu,%.4f,%s,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,"
+                             "%.3f,%.3f,%.3f,%.3f,%.3f,%u,%u,%.3f,%.3f,%.3f,%.3f,%u,%llu,%llu,%.2f,%.4f,%u\n",
+                             (unsigned long long)f.index, f.t_s, kPhaseNames[size_t(f.phase)], f.render_ms, f.guest_ms,
+                             f.guest_capture_ms, f.pace_ms, f.swap_phase1_ms, f.wait_gpu_frame_ms, f.draw_ms,
+                             f.assemble_ms, f.bind_ms, f.sig_ms, f.texup_ms, f.clear_ms, f.copy_ms, f.sync_ms,
+                             f.present_ms, f.swap_call_ms, f.fence_wait_ms, f.gpu_ms, f.compile_ms, f.pso_ms, f.shaders,
+                             f.psos, f.wait_resource_ms, f.glock_bg_wait_ms, f.disc_ms, f.z_write_ms, f.draws,
+                             (unsigned long long)f.upload_bytes, (unsigned long long)f.contig_alloc_bytes, f.g_dt_ms,
+                             f.g_elapsed_s, f.g_frame);
+            }
+            std::fclose(cf);
+        }
+    }
+
+    // 2. Partition frames by phase (skip frame 0 which has no prior present interval)
+    std::vector<const FrameSample*> all_valid;
+    std::array<std::vector<const FrameSample*>, size_t(Phase::Count)> by_phase;
+    double compile_max_frame = 0.0, pso_max_frame = 0.0, fence_wait_total = 0.0;
+    uint64_t contig_max_frame = 0;
+    for (const FrameSample& f : snap) {
+        if (f.index == 0) continue;
+        all_valid.push_back(&f);
+        by_phase[size_t(f.phase)].push_back(&f);
+        compile_max_frame = std::max(compile_max_frame, f.compile_ms);
+        pso_max_frame = std::max(pso_max_frame, f.pso_ms);
+        fence_wait_total += f.fence_wait_ms;
+        contig_max_frame = std::max(contig_max_frame, f.contig_alloc_bytes);
+    }
+
+    FILE* fp = std::fopen(st.json_path.c_str(), "wb");
+    if (!fp) {
+        LOGE("perf: cannot open %s for writing", st.json_path.c_str());
+        return;
+    }
+
+    const app::Settings& s = app::Get();
+    uint32_t hz = app::DisplayRefreshHz();
+    uint64_t blocks = st.audio_blocks.load();
+    uint32_t qmin = st.audio_queued_min.load();
+    if (qmin == UINT32_MAX) qmin = 0;
+    uint64_t p1_cnt = st.total_phase1_count.load();
+
+#ifdef NDEBUG
+    const char* build_str = "Release";
+#else
+    const char* build_str = "Debug";
+#endif
+
+    std::fprintf(fp, "{\n");
+    std::fprintf(fp,
+                 "  \"meta\": {\n"
+                 "    \"build\": \"%s\", \"fps_cap\": %u, \"vsync\": %s, \"render_scale\": %.3f,\n"
+                 "    \"window\": [%u, %u], \"display_refresh_hz\": %u, \"shader_cache_enabled\": %s,\n"
+                 "    \"logical_cpus\": %u, \"wall_duration_s\": %.3f, \"total_presents\": %zu,\n"
+                 "    \"cold_z_detected\": %s, \"csv_path\": \"%s\"\n"
+                 "  },\n",
+                 build_str, s.fps_cap, s.vsync ? "true" : "false", st.render_scale, st.window_w, st.window_h, hz,
+                 st.shader_cache_enabled ? "true" : "false", st.logical_cpus, wall_s, snap.size(),
+                 st.z_writes.load() > 10 ? "true" : "false", JsonEscape(st.csv_path).c_str());
+
+    std::fprintf(fp, "  \"phases\": {\n");
+    WritePhaseJson(fp, "overall", all_valid, true);
+    WritePhaseJson(fp, "gameplay_active", by_phase[size_t(Phase::GameplayActive)], true);
+    WritePhaseJson(fp, "loading_transition", by_phase[size_t(Phase::LoadingTransition)], true);
+    WritePhaseJson(fp, "title_menu", by_phase[size_t(Phase::TitleMenu)], true);
+    WritePhaseJson(fp, "fmv", by_phase[size_t(Phase::Fmv)], true);
+    WritePhaseJson(fp, "paused", by_phase[size_t(Phase::Paused)], false);
+    std::fprintf(fp, "  },\n");
+
+    std::fprintf(fp,
+                 "  \"workload\": {\n"
+                 "    \"process_cpu_pct_avg\": %.2f, \"title_thread_cpu_pct\": %.2f, \"render_thread_cpu_pct\": %.2f\n"
+                 "  },\n",
+                 proc_cpu_pct, title_cpu_pct, render_cpu_pct);
+
+    std::fprintf(fp,
+                 "  \"stalls\": {\n"
+                 "    \"render_waits_total\": %llu, \"wait_readback_ms_total\": %.3f, \"wait_resource_ms_total\": %.3f,\n"
+                 "    \"wait_fence_ms_total\": %.3f, \"wait_flush_ms_total\": %.3f, \"wait_copy_ms_total\": %.3f,\n"
+                 "    \"wait_next_frame_ms_total\": %.3f, \"wait_gpu_frame_ms_total\": %.3f,\n"
+                 "    \"render_fence_wait_ms_total\": %.3f, \"swap_phase1_ms_avg\": %.4f,\n"
+                 "    \"d3d_glock_bg_wait_ms_total\": %.3f, \"d3d_glock_bg_wait_ms_max\": %.3f, \"d3d_glock_title_wait_ms_total\": %.3f\n"
+                 "  },\n",
+                 (unsigned long long)st.total_render_waits.load(), st.total_wait_kind_ns[0].load() / 1e6,
+                 st.total_wait_kind_ns[1].load() / 1e6, st.total_wait_kind_ns[2].load() / 1e6,
+                 st.total_wait_kind_ns[3].load() / 1e6, st.total_wait_kind_ns[4].load() / 1e6,
+                 st.total_wait_kind_ns[5].load() / 1e6, st.total_wait_gpu_ns.load() / 1e6, fence_wait_total,
+                 p1_cnt ? (st.total_phase1_ns.load() / 1e6 / double(p1_cnt)) : 0.0,
+                 st.total_glock_bg_ns.load() / 1e6, st.max_glock_bg_ns.load() / 1e6,
+                 st.total_glock_title_ns.load() / 1e6);
+
+    std::fprintf(fp,
+                 "  \"shaders\": {\n"
+                 "    \"compile_count\": %llu, \"compile_ms_total\": %.3f, \"compile_ms_max_frame\": %.3f, \"shader_cache_hits\": %llu,\n"
+                 "    \"pso_create_count\": %llu, \"pso_create_ms_total\": %.3f, \"pso_create_ms_max_frame\": %.3f, \"pso_cache_hits\": %llu\n"
+                 "  },\n",
+                 (unsigned long long)st.total_compile_count.load(), st.total_compile_ns.load() / 1e6, compile_max_frame,
+                 (unsigned long long)st.total_shader_hits.load(), (unsigned long long)st.total_pso_count.load(),
+                 st.total_pso_ns.load() / 1e6, pso_max_frame, (unsigned long long)st.total_pso_hits.load());
+
+    std::fprintf(fp,
+                 "  \"audio\": {\n"
+                 "    \"xaudio2_underruns\": %llu, \"xaudio2_glitches\": %llu,\n"
+                 "    \"depth_ms_start\": %u, \"depth_ms_peak\": %u, \"depth_ms_final\": %u,\n"
+                 "    \"queued_min\": %u, \"blocks_submitted\": %llu, \"render_us_avg\": %.2f, \"render_us_max\": %u,\n"
+                 "    \"active_voices_peak\": %u, \"stream_packets_completed\": %llu, \"stream_underruns\": %llu\n"
+                 "  },\n",
+                 (unsigned long long)st.audio_underruns.load(), (unsigned long long)st.audio_glitches.load(),
+                 st.audio_depth_start.load() * 10u, st.audio_depth_peak.load() * 10u, st.audio_depth_final.load() * 10u,
+                 qmin, (unsigned long long)blocks, blocks ? double(st.audio_render_us_total.load()) / double(blocks) : 0.0,
+                 st.audio_render_us_max.load(), st.audio_voices_peak.load(),
+                 (unsigned long long)st.stream_packets_done.load(), (unsigned long long)st.stream_underruns.load());
+
+    std::fprintf(fp,
+                 "  \"io\": {\n"
+                 "    \"disc_reads\": %llu, \"disc_bytes\": %llu, \"disc_read_ms_total\": %.3f, \"disc_read_ms_max\": %.3f,\n"
+                 "    \"z_writes\": %llu, \"z_write_bytes\": %llu, \"z_write_ms_total\": %.3f, \"z_write_ms_max\": %.3f,\n"
+                 "    \"z_reads\": %llu, \"z_read_bytes\": %llu, \"z_read_ms_total\": %.3f, \"z_read_ms_max\": %.3f,\n"
+                 "    \"hdd_other_ops\": %llu\n"
+                 "  },\n",
+                 (unsigned long long)st.disc_reads.load(), (unsigned long long)st.disc_bytes.load(),
+                 st.disc_ns_total.load() / 1e6, st.disc_ns_max.load() / 1e6, (unsigned long long)st.z_writes.load(),
+                 (unsigned long long)st.z_write_bytes.load(), st.z_write_ns_total.load() / 1e6,
+                 st.z_write_ns_max.load() / 1e6, (unsigned long long)st.z_reads.load(),
+                 (unsigned long long)st.z_read_bytes.load(), st.z_read_ns_total.load() / 1e6,
+                 st.z_read_ns_max.load() / 1e6, (unsigned long long)st.hdd_other_ops.load());
+
+    constexpr double kMb = 1048576.0;
+    constexpr double kPageMb = 4096.0 / 1048576.0;
+    std::fprintf(fp,
+                 "  \"memory\": {\n"
+                 "    \"host_ws_start_mb\": %.2f, \"host_ws_peak_mb\": %.2f, \"host_ws_final_mb\": %.2f, \"host_ws_delta_mb\": %.2f,\n"
+                 "    \"host_private_start_mb\": %.2f, \"host_private_peak_mb\": %.2f, \"host_private_final_mb\": %.2f, \"page_faults\": %llu,\n"
+                 "    \"guest_contig_peak_mb\": %.2f, \"guest_virt_peak_mb\": %.2f, \"guest_sys_peak_mb\": %.2f,\n"
+                 "    \"contig_allocs\": %llu, \"contig_alloc_mb_total\": %.2f, \"contig_alloc_max_frame_mb\": %.2f,\n"
+                 "    \"virt_allocs\": %llu, \"virt_commit_mb_total\": %.2f,\n"
+                 "    \"d3d12_upload_ring_cap_mb\": %.2f, \"d3d12_upload_ring_peak_mb\": %.2f, \"d3d12_upload_overflows\": %llu,\n"
+                 "    \"d3d12_textures_peak\": %u, \"d3d12_targets_peak\": %u\n"
+                 "  },\n",
+                 st.host_ws_start / kMb, host_ws_peak / kMb, host_ws_final / kMb,
+                 (double(host_ws_final) - double(st.host_ws_start)) / kMb, st.host_priv_start / kMb, host_priv_peak / kMb,
+                 host_priv_final / kMb, (unsigned long long)page_faults, st.guest_contig_peak_pages * kPageMb,
+                 st.guest_virt_peak_pages * kPageMb, st.guest_sys_peak_pages * kPageMb,
+                 (unsigned long long)st.contig_allocs.load(), st.contig_alloc_bytes_total.load() / kMb,
+                 contig_max_frame / kMb, (unsigned long long)st.virt_allocs.load(),
+                 st.virt_commit_bytes_total.load() / kMb, st.upload_ring_cap / kMb, st.upload_ring_peak / kMb,
+                 (unsigned long long)st.upload_overflows_total, st.textures_peak, st.targets_peak);
+
+    WriteSpikesJson(fp, "top_spikes_overall", all_valid, true);
+    WriteSpikesJson(fp, "top_spikes_gameplay", by_phase[size_t(Phase::GameplayActive)], false);
+    std::fprintf(fp, "}\n");
+    std::fflush(fp);
+    std::fclose(fp);
+    LOGR("perf: wrote telemetry summary to %s (%zu frames, %.2fs)", st.json_path.c_str(), snap.size(), wall_s);
+}
+
+}  // namespace
+
+void Init() {
+    std::string path = ParsePerfPath();
+    if (path.empty()) return;
+    PerfState& st = State();
+    st.json_path = std::move(path);
+    std::filesystem::path p(st.json_path);
+    std::filesystem::path csv = p;
+    csv.replace_extension(".frames.csv");
+    st.csv_path = csv.string();
+    st.start_tp = Clock::now();
+    st.proc_cpu_start = ProcessCpu100ns();
+#ifdef _WIN32
+    SYSTEM_INFO si{};
+    GetSystemInfo(&si);
+    st.logical_cpus = std::max<uint32_t>(1, si.dwNumberOfProcessors);
+
+    PROCESS_MEMORY_COUNTERS_EX pmc{};
+    pmc.cb = sizeof(pmc);
+    if (K32GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&pmc), sizeof(pmc))) {
+        st.host_ws_start = pmc.WorkingSetSize;
+        st.host_ws_peak = pmc.PeakWorkingSetSize;
+        st.host_priv_start = pmc.PrivateUsage;
+        st.host_priv_peak = pmc.PrivateUsage;
+        st.page_faults_start = pmc.PageFaultCount;
+    }
+#else
+    long ncpu = sysconf(_SC_NPROCESSORS_ONLN);
+    st.logical_cpus = ncpu > 0 ? uint32_t(ncpu) : 1u;
+    LinuxMemInfo lm = QueryLinuxMem();
+    st.host_ws_start = lm.rss;
+    st.host_ws_peak = lm.hwm;
+    st.host_priv_start = lm.priv;
+    st.host_priv_peak = lm.priv;
+    st.page_faults_start = lm.page_faults;
+#endif
+    st.samples.reserve(16384);
+    g_enabled.store(true, std::memory_order_release);
+    LOGR("perf: telemetry enabled -> %s", st.json_path.c_str());
+}
+
+void Shutdown() {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    std::call_once(st.flush_once, [&] { FlushLocked(st); });
+}
+
+void SetPhaseCallback(PhaseCallback cb) { State().phase_cb.store(cb, std::memory_order_release); }
+void SetShaderCacheEnabled(bool enabled) { State().shader_cache_enabled = enabled; }
+
+void RegisterTitleThread() {
+    if (!Enabled()) return;
+    PerfState& st = State();
+#ifdef _WIN32
+    if (st.title_thread) return;
+    HANDLE dup = nullptr;
+    if (DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &dup, THREAD_QUERY_INFORMATION,
+                        FALSE, 0)) {
+        st.title_cpu_start = ThreadCpu100ns(dup);
+        st.title_thread = dup;
+    }
+#else
+    if (st.has_title_clock) return;
+    if (pthread_getcpuclockid(pthread_self(), &st.title_clock) == 0) {
+        st.title_cpu_start = Clock100ns(st.title_clock);
+        st.has_title_clock = true;
+    }
+#endif
+}
+
+void RegisterRenderThread() {
+    if (!Enabled()) return;
+    PerfState& st = State();
+#ifdef _WIN32
+    if (st.render_thread) return;
+    HANDLE dup = nullptr;
+    if (DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &dup, THREAD_QUERY_INFORMATION,
+                        FALSE, 0)) {
+        st.render_cpu_start = ThreadCpu100ns(dup);
+        st.render_thread = dup;
+    }
+#else
+    if (st.has_render_clock) return;
+    if (pthread_getcpuclockid(pthread_self(), &st.render_clock) == 0) {
+        st.render_cpu_start = Clock100ns(st.render_clock);
+        st.has_render_clock = true;
+    }
+#endif
+}
+
+void RecordSwapPhase1(double ms) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    uint64_t ns = uint64_t(std::max(0.0, ms * 1e6));
+    st.pending_phase1_ns.fetch_add(ns, std::memory_order_relaxed);
+    st.total_phase1_ns.fetch_add(ns, std::memory_order_relaxed);
+    st.total_phase1_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordPace(double ms) {
+    if (!Enabled()) return;
+    State().pending_pace_ns.fetch_add(uint64_t(std::max(0.0, ms * 1e6)), std::memory_order_relaxed);
+}
+
+void RecordGuestFrame(double guest_frame_ms, double capture_ms, double wait_gpu_frame_ms) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    st.pending_guest_ns.store(uint64_t(std::max(0.0, guest_frame_ms * 1e6)), std::memory_order_relaxed);
+    st.pending_capture_ns.fetch_add(uint64_t(std::max(0.0, capture_ms * 1e6)), std::memory_order_relaxed);
+    uint64_t wg = uint64_t(std::max(0.0, wait_gpu_frame_ms * 1e6));
+    st.pending_wait_gpu_ns.fetch_add(wg, std::memory_order_relaxed);
+    st.total_wait_gpu_ns.fetch_add(wg, std::memory_order_relaxed);
+}
+
+void RecordD3dGlockWait(double ms, bool is_title_thread) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    uint64_t ns = uint64_t(std::max(0.0, ms * 1e6));
+    if (is_title_thread) {
+        st.total_glock_title_ns.fetch_add(ns, std::memory_order_relaxed);
+    } else {
+        st.pending_glock_bg_ns.fetch_add(ns, std::memory_order_relaxed);
+        st.total_glock_bg_ns.fetch_add(ns, std::memory_order_relaxed);
+        AtomicMax(st.max_glock_bg_ns, ns);
+    }
+}
+
+void RecordRenderWait(uint8_t kind, double ms, bool is_named_wait) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    uint64_t ns = uint64_t(std::max(0.0, ms * 1e6));
+    if (kind < 6) {
+        st.pending_wait_kind_ns[kind].fetch_add(ns, std::memory_order_relaxed);
+        st.total_wait_kind_ns[kind].fetch_add(ns, std::memory_order_relaxed);
+    }
+    if (is_named_wait) st.total_render_waits.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordShaderCompile(double ms) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    uint64_t ns = uint64_t(std::max(0.0, ms * 1e6));
+    st.pending_compile_ns.fetch_add(ns, std::memory_order_relaxed);
+    st.pending_shaders.fetch_add(1, std::memory_order_relaxed);
+    st.total_compile_ns.fetch_add(ns, std::memory_order_relaxed);
+    st.total_compile_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordShaderCacheHit() {
+    if (!Enabled()) return;
+    State().total_shader_hits.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordPsoCreate(double ms) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    uint64_t ns = uint64_t(std::max(0.0, ms * 1e6));
+    st.pending_pso_ns.fetch_add(ns, std::memory_order_relaxed);
+    st.pending_psos.fetch_add(1, std::memory_order_relaxed);
+    st.total_pso_ns.fetch_add(ns, std::memory_order_relaxed);
+    st.total_pso_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordPsoCacheHit() {
+    if (!Enabled()) return;
+    State().total_pso_hits.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordPresent(const PresentMetrics& m) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    auto now = Clock::now();
+    double render_ms = st.has_last_present ? std::chrono::duration<double, std::milli>(now - st.last_present_tp).count() : 0.0;
+    st.last_present_tp = now;
+    st.has_last_present = true;
+
+    PhaseInfo pi{};
+    if (PhaseCallback cb = st.phase_cb.load(std::memory_order_acquire)) pi = cb();
+
+    FrameSample f{};
+    f.t_s = std::chrono::duration<double>(now - st.start_tp).count();
+    f.phase = pi.phase;
+    f.render_ms = render_ms;
+    f.guest_ms = st.pending_guest_ns.exchange(0, std::memory_order_relaxed) / 1e6;
+    f.guest_capture_ms = st.pending_capture_ns.exchange(0, std::memory_order_relaxed) / 1e6;
+    f.pace_ms = st.pending_pace_ns.exchange(0, std::memory_order_relaxed) / 1e6;
+    f.swap_phase1_ms = st.pending_phase1_ns.exchange(0, std::memory_order_relaxed) / 1e6;
+    f.wait_gpu_frame_ms = st.pending_wait_gpu_ns.exchange(0, std::memory_order_relaxed) / 1e6;
+
+    f.draw_ms = m.draw_ms;
+    f.assemble_ms = m.assemble_ms;
+    f.bind_ms = m.bind_ms;
+    f.sig_ms = m.sig_ms;
+    f.texup_ms = m.texup_ms;
+    f.clear_ms = m.clear_ms;
+    f.copy_ms = m.copy_ms;
+    f.sync_ms = m.sync_ms;
+    f.present_ms = m.present_ms;
+    f.swap_call_ms = m.swap_call_ms;
+    f.fence_wait_ms = m.fence_wait_ms;
+    f.gpu_ms = m.gpu_ms;
+
+    f.compile_ms = st.pending_compile_ns.exchange(0, std::memory_order_relaxed) / 1e6;
+    f.pso_ms = st.pending_pso_ns.exchange(0, std::memory_order_relaxed) / 1e6;
+    f.shaders = st.pending_shaders.exchange(0, std::memory_order_relaxed);
+    f.psos = st.pending_psos.exchange(0, std::memory_order_relaxed);
+
+    f.wait_readback_ms = st.pending_wait_kind_ns[0].exchange(0, std::memory_order_relaxed) / 1e6;
+    f.wait_resource_ms = st.pending_wait_kind_ns[1].exchange(0, std::memory_order_relaxed) / 1e6;
+    f.wait_fence_ms = st.pending_wait_kind_ns[2].exchange(0, std::memory_order_relaxed) / 1e6;
+    f.wait_flush_ms = st.pending_wait_kind_ns[3].exchange(0, std::memory_order_relaxed) / 1e6;
+    f.wait_copy_ms = st.pending_wait_kind_ns[4].exchange(0, std::memory_order_relaxed) / 1e6;
+    f.wait_next_frame_ms = st.pending_wait_kind_ns[5].exchange(0, std::memory_order_relaxed) / 1e6;
+    f.glock_bg_wait_ms = st.pending_glock_bg_ns.exchange(0, std::memory_order_relaxed) / 1e6;
+
+    f.disc_ms = st.pending_disc_ns.exchange(0, std::memory_order_relaxed) / 1e6;
+    f.disc_reads = st.pending_disc_reads.exchange(0, std::memory_order_relaxed);
+    f.z_write_ms = st.pending_z_write_ns.exchange(0, std::memory_order_relaxed) / 1e6;
+    f.z_read_ms = st.pending_z_read_ns.exchange(0, std::memory_order_relaxed) / 1e6;
+
+    f.draws = m.draws;
+    f.raw_draws = m.raw_draws;
+    f.upload_bytes = m.upload_bytes;
+    f.contig_alloc_bytes = st.pending_contig_alloc_bytes.exchange(0, std::memory_order_relaxed);
+    f.g_dt_ms = pi.g_dt_ms;
+    f.g_elapsed_s = pi.g_elapsed_s;
+    f.g_frame = pi.g_frame;
+
+    // Detect startup 30 Hz XMV FMV playback if engine mode bit 3 wasn't set by intro player
+    if (f.phase == Phase::TitleMenu && f.t_s < 21.0 && f.render_ms >= 25.0 && f.render_ms <= 45.0) {
+        f.phase = Phase::Fmv;
+    }
+
+    std::lock_guard<std::mutex> lock(st.samples_lock);
+    f.index = st.samples.size();
+    st.window_w = m.window_w;
+    st.window_h = m.window_h;
+    st.render_scale = m.render_scale;
+    st.upload_ring_cap = std::max(st.upload_ring_cap, m.upload_ring_cap);
+    st.upload_ring_peak = std::max(st.upload_ring_peak, m.upload_ring_used);
+    st.upload_overflows_total += m.upload_overflows;
+    st.textures_peak = std::max(st.textures_peak, m.textures);
+    st.targets_peak = std::max(st.targets_peak, m.targets);
+
+    // Sample host/guest memory every 30 frames (~0.5s) to track accurate peaks with negligible cost
+    if ((f.index % 30) == 0) {
+#ifdef _WIN32
+        PROCESS_MEMORY_COUNTERS_EX pmc{};
+        pmc.cb = sizeof(pmc);
+        if (K32GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&pmc), sizeof(pmc))) {
+            st.host_ws_peak = std::max<uint64_t>(st.host_ws_peak, pmc.PeakWorkingSetSize);
+            st.host_priv_peak = std::max<uint64_t>(st.host_priv_peak, pmc.PrivateUsage);
+        }
+#else
+        LinuxMemInfo lm = QueryLinuxMem();
+        st.host_ws_peak = std::max<uint64_t>(st.host_ws_peak, lm.hwm);
+        st.host_priv_peak = std::max<uint64_t>(st.host_priv_peak, lm.priv);
+#endif
+        mem::Stats ms = mem::Query();
+        st.guest_contig_peak_pages = std::max<uint64_t>(st.guest_contig_peak_pages, ms.contiguous_used);
+        st.guest_virt_peak_pages = std::max<uint64_t>(st.guest_virt_peak_pages, ms.virtual_committed);
+        st.guest_sys_peak_pages = std::max<uint64_t>(st.guest_sys_peak_pages, ms.system_used);
+    }
+
+    st.samples.push_back(f);
+}
+
+void RecordAudioBlock(uint32_t render_us, uint32_t queued_before, uint32_t depth_blocks, bool starved,
+                      uint32_t glitches_delta) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    uint32_t zero = 0;
+    st.audio_depth_start.compare_exchange_strong(zero, depth_blocks, std::memory_order_relaxed);
+    AtomicMax(st.audio_depth_peak, depth_blocks);
+    st.audio_depth_final.store(depth_blocks, std::memory_order_relaxed);
+    AtomicMin(st.audio_queued_min, queued_before);
+    st.audio_blocks.fetch_add(1, std::memory_order_relaxed);
+    st.audio_render_us_total.fetch_add(render_us, std::memory_order_relaxed);
+    AtomicMax(st.audio_render_us_max, render_us);
+    if (starved) st.audio_underruns.fetch_add(1, std::memory_order_relaxed);
+    if (glitches_delta) st.audio_glitches.fetch_add(glitches_delta, std::memory_order_relaxed);
+}
+
+void RecordAudioVoices(uint32_t active_voices) {
+    if (!Enabled()) return;
+    AtomicMax(State().audio_voices_peak, active_voices);
+}
+
+void RecordStreamPacketCompleted() {
+    if (!Enabled()) return;
+    State().stream_packets_done.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordStreamUnderrun() {
+    if (!Enabled()) return;
+    State().stream_underruns.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordDiscRead(uint32_t bytes, double ms) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    uint64_t ns = uint64_t(std::max(0.0, ms * 1e6));
+    st.disc_reads.fetch_add(1, std::memory_order_relaxed);
+    st.disc_bytes.fetch_add(bytes, std::memory_order_relaxed);
+    st.disc_ns_total.fetch_add(ns, std::memory_order_relaxed);
+    AtomicMax(st.disc_ns_max, ns);
+    st.pending_disc_ns.fetch_add(ns, std::memory_order_relaxed);
+    st.pending_disc_reads.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordZIo(bool is_write, uint32_t bytes, double ms) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    uint64_t ns = uint64_t(std::max(0.0, ms * 1e6));
+    if (is_write) {
+        st.z_writes.fetch_add(1, std::memory_order_relaxed);
+        st.z_write_bytes.fetch_add(bytes, std::memory_order_relaxed);
+        st.z_write_ns_total.fetch_add(ns, std::memory_order_relaxed);
+        AtomicMax(st.z_write_ns_max, ns);
+        st.pending_z_write_ns.fetch_add(ns, std::memory_order_relaxed);
+    } else {
+        st.z_reads.fetch_add(1, std::memory_order_relaxed);
+        st.z_read_bytes.fetch_add(bytes, std::memory_order_relaxed);
+        st.z_read_ns_total.fetch_add(ns, std::memory_order_relaxed);
+        AtomicMax(st.z_read_ns_max, ns);
+        st.pending_z_read_ns.fetch_add(ns, std::memory_order_relaxed);
+    }
+}
+
+void RecordHddOtherIo() {
+    if (!Enabled()) return;
+    State().hdd_other_ops.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordGuestContigAlloc(uint32_t bytes) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    st.contig_allocs.fetch_add(1, std::memory_order_relaxed);
+    st.contig_alloc_bytes_total.fetch_add(bytes, std::memory_order_relaxed);
+    st.pending_contig_alloc_bytes.fetch_add(bytes, std::memory_order_relaxed);
+}
+
+void RecordGuestVirtCommit(uint32_t bytes) {
+    if (!Enabled()) return;
+    PerfState& st = State();
+    st.virt_allocs.fetch_add(1, std::memory_order_relaxed);
+    st.virt_commit_bytes_total.fetch_add(bytes, std::memory_order_relaxed);
+}
+
+}  // namespace perf
