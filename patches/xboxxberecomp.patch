+VkSampler VulkanBackend::GetOrCreateSampler(const VkSamplerCreateInfo& ci, const float border_rgba[4],
+                                            bool custom_border) {
+    struct KeyData {
+        VkFilter mag, min;
+        VkSamplerMipmapMode mip;
+        VkSamplerAddressMode u, v, w;
+        float lod_bias, max_aniso, min_lod, max_lod;
+        VkBool32 aniso, cmp;
+        VkCompareOp cmp_op;
+        VkBorderColor border;
+        float rgba[4];
+        uint32_t custom;
+    } kd;
+    std::memset(&kd, 0, sizeof(kd));
+    kd.mag = ci.magFilter;
+    kd.min = ci.minFilter;
+    kd.mip = ci.mipmapMode;
+    kd.u = ci.addressModeU;
+    kd.v = ci.addressModeV;
+    kd.w = ci.addressModeW;
+    kd.lod_bias = ci.mipLodBias;
+    kd.max_aniso = ci.maxAnisotropy;
+    kd.min_lod = ci.minLod;
+    kd.max_lod = ci.maxLod;
+    kd.aniso = ci.anisotropyEnable;
+    kd.cmp = ci.compareEnable;
+    kd.cmp_op = ci.compareOp;
+    kd.border = ci.borderColor;
+    kd.custom = custom_border ? 1u : 0u;
+    if (custom_border && border_rgba) std::memcpy(kd.rgba, border_rgba, 16);
+    uint64_t key = Hash(&kd, sizeof(kd));
+    auto it = samplers_.find(key);
+    if (it != samplers_.end()) return it->second;
+
+    VkSamplerCreateInfo local = ci;
+    VkSamplerCustomBorderColorCreateInfoEXT cbci{VK_STRUCTURE_TYPE_SAMPLER_CUSTOM_BORDER_COLOR_CREATE_INFO_EXT};
+    if (custom_border && has_custom_border_ && border_rgba) {
+        local.borderColor = VK_BORDER_COLOR_FLOAT_CUSTOM_EXT;
+        std::memcpy(cbci.customBorderColor.float32, border_rgba, 16);
+        cbci.format = VK_FORMAT_UNDEFINED;
+        local.pNext = &cbci;
+    }
+    VkSampler smp = VK_NULL_HANDLE;
+    vk_.create_sampler(dev_, &local, nullptr, &smp);
+    samplers_[key] = smp;
+    return smp;
+}
+
+void VulkanBackend::EnsureBlitSamplers(VkSampler out[4]) {
+    for (int i = 0; i < 4; ++i) {
+        VkSamplerCreateInfo ci{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+        ci.magFilter = (i == 0) ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+        ci.minFilter = (i == 0) ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+        ci.mipmapMode = (i == 0) ? VK_SAMPLER_MIPMAP_MODE_LINEAR : VK_SAMPLER_MIPMAP_MODE_NEAREST;
+        ci.addressModeU = ci.addressModeV = ci.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+        ci.maxLod = VK_LOD_CLAMP_NONE;
+        out[i] = GetOrCreateSampler(ci, nullptr, false);
+    }
+}
+
+void VulkanBackend::EnsureStageSamplers(const State& s, const DrawTextures& stages, uint8_t clamp_mask,
+                                        VkSampler out[4]) {
+    uint32_t aniso_setting = app::Get().aniso;
+    float max_bias = phys_props_.limits.maxSamplerLodBias;
+    float max_aniso_hw = phys_props_.limits.maxSamplerAnisotropy;
+    for (int i = 0; i < 4; ++i) {
+        const auto& t = s.tss[size_t(i)];
+        uint32_t mag = t[kTssMagFilter], min = t[kTssMinFilter], mip = t[kTssMipFilter];
+        auto lin = [](uint32_t f) { return f >= kTexfLinear; };
+        VkSamplerCreateInfo ci{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+        ci.minFilter = lin(min) ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+        ci.magFilter = lin(mag) ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+        ci.mipmapMode = (mip == kTexfLinear) ? VK_SAMPLER_MIPMAP_MODE_LINEAR : VK_SAMPLER_MIPMAP_MODE_NEAREST;
+
+        bool aniso_req = (min == kTexfAnisotropic || mag == kTexfAnisotropic);
+        uint32_t an = aniso_req ? std::max<uint32_t>(t[kTssMaxAnisotropy], 1) : 1;
+        if (aniso_setting && lin(min) && mip && stages.mips[i] > 1 && !stages.info[i].shadow) an = aniso_setting;
+        if (an > 1 && !stages.info[i].shadow) {
+            ci.anisotropyEnable = VK_TRUE;
+            ci.maxAnisotropy = std::min(float(an), max_aniso_hw);
+            ci.minFilter = VK_FILTER_LINEAR;
+            ci.magFilter = VK_FILTER_LINEAR;
+        }
+
+        bool c = ((clamp_mask >> i) & 1u) != 0;
+        ci.addressModeU = AddressVk(c && t[kTssAddressU] == kTaddressWrap ? kTaddressClamp : t[kTssAddressU]);
+        ci.addressModeV = AddressVk(c && t[kTssAddressV] == kTaddressWrap ? kTaddressClamp : t[kTssAddressV]);
+        ci.addressModeW = AddressVk(t[kTssAddressW]);
+        ci.mipLodBias = std::clamp(Bits(t[kTssMipLodBias]), -max_bias, max_bias);
+        ci.minLod = float(t[kTssMaxMipLevel]);
+        ci.maxLod = mip ? VK_LOD_CLAMP_NONE : ci.minLod;
+
+        float bc[4]{};
+        Color(t[kTssBorderColor], bc);
+        bool uses_border = (ci.addressModeU == VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER ||
+                            ci.addressModeV == VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER ||
+                            ci.addressModeW == VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER);
+        if (bc[0] > 0.5f && bc[1] > 0.5f && bc[2] > 0.5f) ci.borderColor = VK_BORDER_COLOR_FLOAT_OPAQUE_WHITE;
+        else if (bc[3] > 0.5f) ci.borderColor = VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK;
+        else ci.borderColor = VK_BORDER_COLOR_FLOAT_TRANSPARENT_BLACK;
+
+        if (stages.info[i].shadow) {
+            ci.minFilter = ci.magFilter = (lin(min) || lin(mag)) ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+            ci.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+            ci.compareEnable = VK_TRUE;
+            ci.compareOp = CmpVk(s.rs[kRsShadowFunc]);
+            ci.anisotropyEnable = VK_FALSE;
+            ci.maxAnisotropy = 1.0f;
+        }
+        out[i] = GetOrCreateSampler(ci, bc, uses_border && has_custom_border_);
+    }
+}
