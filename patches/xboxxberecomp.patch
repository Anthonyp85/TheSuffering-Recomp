+void D3D12Backend::InitUpscaler() {
+    Upscaler* u = g_upscaler.load(std::memory_order_acquire);
+    if (!u) return;
+    UpscalerInitDesc desc{};
+    desc.device = dev_.Get();
+    desc.queue = queue_.Get();
+    desc.cmd_list = cl_.Get();
+    desc.caps = caps_;
+    desc.host.ctx = this;
+    desc.host.transition = [](void* ctx, void* res, uint32_t* cur_state, uint32_t want_state) {
+        auto* self = static_cast<D3D12Backend*>(ctx);
+        D3D12_RESOURCE_STATES st = static_cast<D3D12_RESOURCE_STATES>(*cur_state);
+        self->Transition(static_cast<ID3D12Resource*>(res), st, static_cast<D3D12_RESOURCE_STATES>(want_state));
+        *cur_state = uint32_t(st);
+    };
+    desc.host.compile = [](void* ctx, const std::string& src, const char* entry, const char* profile,
+                           uint64_t* out_hash) -> void* {
+        auto* self = static_cast<D3D12Backend*>(ctx);
+        uint64_t h = 0;
+        ID3DBlob* b = self->Compile(src, entry, profile, h);
+        if (out_hash) *out_hash = h;
+        return b;
+    };
+    desc.host.create_or_load_compute_pso = [](void* ctx, const wchar_t* name, const void* d, void** out_pso) -> bool {
+        auto* self = static_cast<D3D12Backend*>(ctx);
+        ComPtr<ID3D12PipelineState> pso;
+        bool ok = self->CreateOrLoadComputePso(name, *static_cast<const D3D12_COMPUTE_PIPELINE_STATE_DESC*>(d), pso);
+        if (ok && out_pso) *out_pso = pso.Detach();
+        return ok;
+    };
+    desc.host.create_or_load_graphics_pso = [](void* ctx, const wchar_t* name, const void* d, void** out_pso) -> bool {
+        auto* self = static_cast<D3D12Backend*>(ctx);
+        ComPtr<ID3D12PipelineState> pso;
+        bool ok = self->CreateOrLoadPso(name, *static_cast<const D3D12_GRAPHICS_PIPELINE_STATE_DESC*>(d), pso);
+        if (ok && out_pso) *out_pso = pso.Detach();
+        return ok;
+    };
+    desc.host.flush = [](void* ctx) { static_cast<D3D12Backend*>(ctx)->Flush(); };
+    desc.host.upload = [](void* ctx, uint64_t size, uint64_t align, void** out_res, uint64_t* out_off,
+                          uint8_t** out_cpu, uint64_t* out_gpu) -> bool {
+        auto* self = static_cast<D3D12Backend*>(ctx);
+        Alloc a = self->Upload(size, align);
