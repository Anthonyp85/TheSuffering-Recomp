+    if (!f) return args;
+    std::string raw((std::istreambuf_iterator<char>(f)), {});
+    size_t pos = 0;
+    while (pos < raw.size()) {
+        size_t nul = raw.find('\0', pos);
+        if (nul == std::string::npos) nul = raw.size();
+        args.push_back(raw.substr(pos, nul - pos));
+        pos = nul + 1;
+    }
+    return args;
+}
