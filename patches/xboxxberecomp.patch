+            if (job.write_shaders) {
+                save_pending_.write_shaders = true;
+                save_pending_.shaders_bytes = std::move(job.shaders_bytes);
+            }
+            if (job.write_pso) {
+                save_pending_.write_pso = true;
+                save_pending_.pso_path = std::move(job.pso_path);
+                save_pending_.pso_bytes = std::move(job.pso_bytes);
+            }
+            if (job.write_meta) {
+                save_pending_.write_meta = true;
+                save_pending_.meta_path = std::move(job.meta_path);
+                save_pending_.meta_bytes = std::move(job.meta_bytes);
+            }
+            if (job.write_recipes) {
+                save_pending_.write_recipes = true;
+                save_pending_.recipes_bytes = std::move(job.recipes_bytes);
+            }
+            save_has_pending_ = true;
+        }
+        save_cv_.notify_one();
+    }
