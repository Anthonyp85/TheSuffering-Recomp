+    if (FAILED(hr)) return false;
+
+    ComPtr<IShellItem> item;
+    if (FAILED(dlg->GetResult(&item)) || !item) return false;
+    PWSTR raw = nullptr;
+    if (FAILED(item->GetDisplayName(SIGDN_FILESYSPATH, &raw)) || !raw) return false;
+    picked = fs::path(raw);
+    CoTaskMemFree(raw);
+    return !picked.empty();
+#else
+    bool temp_video = false;
+    if (!SDL_WasInit(SDL_INIT_VIDEO)) {
+        if (!SDL_InitSubSystem(SDL_INIT_VIDEO)) return false;
+        temp_video = true;
+    }
+    struct DialogState {
+        std::atomic<bool> done{false};
+        std::mutex lock;
+        std::string path;
+    } st;
+    auto cb = [](void* ud, const char* const* filelist, int /*filter*/) {
+        auto* s = static_cast<DialogState*>(ud);
+        if (filelist && filelist[0] && filelist[0][0]) {
+            std::lock_guard<std::mutex> g(s->lock);
+            s->path = filelist[0];
+        }
+        s->done.store(true, std::memory_order_release);
+    };
+    const SDL_DialogFileFilter filters[] = {
+        {"Xbox Disc Images (*.xiso.iso; *.iso)", "iso"},
+        {"All Files", "*"},
+    };
+    std::string start_dir = ExeDir().string();
+    SDL_ShowOpenFileDialog(cb, &st, static_cast<SDL_Window*>(owner_hwnd), filters, 2, start_dir.c_str(), false);
+    while (!st.done.load(std::memory_order_acquire)) {
+        SDL_PumpEvents();
+        SDL_Delay(15);
+    }
+    if (temp_video) SDL_QuitSubSystem(SDL_INIT_VIDEO);
+    std::lock_guard<std::mutex> g(st.lock);
+    if (st.path.empty()) return false;
+    picked = fs::path(st.path);
+    return true;
+#endif
