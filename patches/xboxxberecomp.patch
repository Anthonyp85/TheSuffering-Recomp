+constexpr uint32_t kSigWholeMax = 524288;
+constexpr uint32_t kSigPageStep = 4096;
+constexpr uint32_t kSigPageSampleBytes = 256;
+
+inline bool RangesOverlap(uint32_t a, uint32_t a_size, uint32_t b, uint32_t b_size) {
+    if (!a_size || !b_size) return false;
+    uint64_t a_end = uint64_t(a) + a_size;
+    uint64_t b_end = uint64_t(b) + b_size;
+    return uint64_t(a) < b_end && uint64_t(b) < a_end;
+}
+
+inline uint64_t Mix64(uint64_t x) {
+    x ^= x >> 30;
+    x *= 0xBF58476D1CE4E5B9ull;
+    x ^= x >> 27;
+    x *= 0x94D049BB133111EBull;
+    x ^= x >> 31;
+    return x;
+}
+
+uint64_t FastMemHash64(const uint8_t* p, size_t n, uint64_t seed) {
+    constexpr uint64_t kP1 = 0x9E3779B185EBCA87ull;
+    constexpr uint64_t kP2 = 0xC2B2AE3D27D4EB4Full;
+    uint64_t h0 = seed ^ (kP1 + uint64_t(n));
+    uint64_t h1 = seed ^ kP2;
+    uint64_t h2 = seed + kP1;
+    uint64_t h3 = seed - kP2;
+    size_t i = 0;
+    for (; i + 32 <= n; i += 32) {
+        uint64_t w0, w1, w2, w3;
+        std::memcpy(&w0, p + i + 0, 8);
+        std::memcpy(&w1, p + i + 8, 8);
+        std::memcpy(&w2, p + i + 16, 8);
+        std::memcpy(&w3, p + i + 24, 8);
+        h0 = (h0 ^ (w0 * kP2)) * kP1;
+        h1 = (h1 ^ (w1 * kP2)) * kP1;
+        h2 = (h2 ^ (w2 * kP2)) * kP1;
+        h3 = (h3 ^ (w3 * kP2)) * kP1;
+    }
+    uint64_t h = Mix64(h0) ^ (Mix64(h1) * kP1) ^ Mix64(h2 + kP2) ^ Mix64(h3);
+    for (; i + 8 <= n; i += 8) {
+        uint64_t w;
+        std::memcpy(&w, p + i, 8);
+        h = Mix64(h ^ (w * kP2));
+    }
+    for (; i < n; ++i) {
+        h = (h ^ p[i]) * 1099511628211ull;
+    }
+    return Mix64(h);
+}
+
+uint64_t MemSig(uint32_t data, uint32_t total) {
+    const uint8_t* p = static_cast<const uint8_t*>(kernel::HostPtr(data));
+    uint64_t sig = Mix64(0x9E3779B97F4A7C15ull ^ uint64_t(total));
+    g_perf.sigs++;
+    if (total <= kSigWholeMax) {
+        g_perf.sig_bytes += total;
+        return FastMemHash64(p, total, sig);
+    }
+    uint32_t hashed = 0;
+    for (uint32_t off = 0; off < total; off += kSigPageStep) {
+        uint32_t chunk = std::min<uint32_t>(kSigPageSampleBytes, total - off);
+        sig = FastMemHash64(p + off, chunk, sig ^ off);
+        hashed += chunk;
+    }
+    if (total > kSigPageSampleBytes) {
+        sig = FastMemHash64(p + total - kSigPageSampleBytes, kSigPageSampleBytes, sig ^ total);
+        hashed += kSigPageSampleBytes;
+    }
+    g_perf.sig_bytes += hashed;
+    return sig;
+}
+
+bool Changed(const Target& t) {
+    if (t.drawn || t.read.empty()) return false;
+    uint32_t row = t.gw * 4;
+    uint32_t pitch = GuestPitch(t.gw);
+    const uint8_t* p = static_cast<const uint8_t*>(kernel::HostPtr(t.data));
+    for (uint32_t y = 0; y < t.gh; y++) {
+        if (std::memcmp(p + size_t(y) * pitch, &t.read[size_t(y) * row], row)) return true;
+    }
+    return false;
+}
