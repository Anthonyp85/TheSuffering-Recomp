+DWORD_PTR SelectGuestCoreMask() {
+    static std::once_flag once;
+    static DWORD_PTR cached_mask = DWORD_PTR(1);
+    std::call_once(once, [] {
+        DWORD_PTR proc_mask = 0, sys_mask = 0;
+        if (!GetProcessAffinityMask(GetCurrentProcess(), &proc_mask, &sys_mask) || !proc_mask) {
+            cached_mask = DWORD_PTR(1);
+            app::SetGuestCoreInfo(0, uint64_t(cached_mask));
+            LOGR("threads: single_core_guest pinned to fallback logical CPU 0 (mask 0x1)");
+            return;
+        }
+        auto lsb = [](DWORD_PTR m) -> DWORD_PTR { return m & (~m + 1); };
+        auto bit_index = [](DWORD_PTR m) -> uint32_t {
+            return m ? uint32_t(std::countr_zero(uint64_t(m))) : 0u;
+        };
+        if (std::popcount(uint64_t(proc_mask)) == 1) {
+            cached_mask = proc_mask;
+            uint32_t idx = bit_index(cached_mask);
+            app::SetGuestCoreInfo(idx, uint64_t(cached_mask));
+            LOGR("threads: single_core_guest pinned to logical CPU %u (mask 0x%llX, proc_mask=0x%llX)",
+                 idx, (unsigned long long)cached_mask, (unsigned long long)proc_mask);
+            return;
+        }
+
+        DWORD_PTR chosen = 0;
+        uint8_t chosen_eff = 0;
+        DWORD len = 0;
+        GetLogicalProcessorInformationEx(RelationProcessorCore, nullptr, &len);
+        if (len > 0) {
+            std::vector<uint8_t> buf(len);
+            if (GetLogicalProcessorInformationEx(
+                    RelationProcessorCore, reinterpret_cast<PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX>(buf.data()),
+                    &len)) {
+                struct Cand {
+                    DWORD_PTR bit = 0;
+                    uint32_t idx = 0;
+                    uint8_t eff = 0;
+                    bool shares_cpu0 = false;
+                };
+                std::vector<Cand> cands;
+                uint8_t max_eff = 0;
+                for (DWORD off = 0; off + sizeof(SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX) <= len;) {
+                    auto* info = reinterpret_cast<const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*>(buf.data() + off);
+                    if (info->Size == 0) break;
+                    if (info->Relationship == RelationProcessorCore && info->Processor.GroupCount >= 1 &&
+                        info->Processor.GroupMask[0].Group == 0) {
+                        DWORD_PTR cmask = info->Processor.GroupMask[0].Mask;
+                        DWORD_PTR avail = cmask & proc_mask;
+                        if (avail != 0) {
+                            DWORD_PTR b = lsb(avail);
+                            uint8_t eff = info->Processor.EfficiencyClass;
+                            if (eff > max_eff) max_eff = eff;
+                            cands.push_back({b, bit_index(b), eff, (cmask & DWORD_PTR(1)) != 0});
+                        }
+                    }
+                    off += info->Size;
+                }
+                std::vector<Cand> top;
+                for (const Cand& c : cands)
+                    if (c.eff == max_eff) top.push_back(c);
+                bool has_non_cpu0 = false;
+                for (const Cand& c : top)
+                    if (!c.shares_cpu0) has_non_cpu0 = true;
+                uint32_t best_idx = UINT32_MAX;
+                for (const Cand& c : top) {
+                    if (has_non_cpu0 && c.shares_cpu0) continue;
+                    if (c.idx < best_idx) {
+                        best_idx = c.idx;
+                        chosen = c.bit;
+                        chosen_eff = c.eff;
+                    }
+                }
+            }
+        }
+        if (!chosen) {
+            DWORD_PTR non0 = proc_mask & ~DWORD_PTR(1);
+            if (std::popcount(uint64_t(proc_mask)) >= 4 && (proc_mask & ~DWORD_PTR(3)) != 0) {
+                chosen = lsb(proc_mask & ~DWORD_PTR(3));
+            } else if (non0 != 0) {
+                chosen = lsb(non0);
+            } else {
+                chosen = lsb(proc_mask);
+            }
+        }
+        cached_mask = chosen;
+        uint32_t idx = bit_index(cached_mask);
+        app::SetGuestCoreInfo(idx, uint64_t(cached_mask));
+        LOGR("threads: single_core_guest pinned to logical CPU %u (mask 0x%llX, eff=%u, proc_mask=0x%llX)",
+             idx, (unsigned long long)cached_mask, unsigned(chosen_eff), (unsigned long long)proc_mask);
+    });
+    return cached_mask;
+}
+#else
+bool SiblingListContainsZero(const std::string& list) {
+    size_t i = 0;
+    while (i < list.size()) {
+        while (i < list.size() && (list[i] == ',' || list[i] == ' ' || list[i] == '\n' || list[i] == '\r')) ++i;
+        if (i >= list.size()) break;
+        char* end = nullptr;
+        long lo = std::strtol(list.c_str() + i, &end, 10);
+        if (end == list.c_str() + i) break;
+        long hi = lo;
+        if (*end == '-') {
+            char* end2 = nullptr;
+            hi = std::strtol(end + 1, &end2, 10);
+            end = end2;
+        }
+        if (lo <= 0 && 0 <= hi) return true;
+        i = size_t(end - list.c_str());
+    }
+    return false;
+}
