+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace perf {
+
+enum class Phase : uint8_t {
+    TitleMenu = 0,
+    Fmv = 1,
+    LoadingTransition = 2,
+    GameplayActive = 3,
+    Paused = 4,
+    Count = 5,
+};
+
+struct PhaseInfo {
+    Phase phase = Phase::TitleMenu;
+    float g_dt_ms = 0.0f;
+    float g_elapsed_s = 0.0f;
+    uint32_t g_frame = 0;
+    uint32_t session = 0;
+};
+
+using PhaseCallback = PhaseInfo (*)();
+
+extern std::atomic<bool> g_enabled;
+inline bool Enabled() { return g_enabled.load(std::memory_order_relaxed); }
+
+void Init();
+void Shutdown();
+void SetPhaseCallback(PhaseCallback cb);
+void SetShaderCacheEnabled(bool enabled);
+
+// Thread registration for GetThreadTimes CPU% attribution
+void RegisterTitleThread();
+void RegisterRenderThread();
+
+// Guest-side per-swap & pacing telemetry (called from d3d8.cpp / main.cpp)
+void RecordSwapPhase1(double ms);
+void RecordPace(double ms);
+void RecordGuestFrame(double guest_frame_ms, double capture_ms, double wait_gpu_frame_ms);
+void RecordD3dGlockWait(double ms, bool is_title_thread);
+
+// Render-thread wait attribution (called from render_thread.cpp)
+void RecordRenderWait(uint8_t kind, double ms, bool is_named_wait);
+
+// Shader & PSO compilation telemetry (called from d3d12.cpp)
+void RecordShaderCompile(double ms);
+void RecordShaderCacheHit();
+void RecordPsoCreate(double ms);
+void RecordPsoCacheHit();
+
+// Per-present frame sample from D3D12Backend::Present
+struct PresentMetrics {
+    double draw_ms = 0.0;
+    double assemble_ms = 0.0;
+    double bind_ms = 0.0;
+    double sig_ms = 0.0;
+    double texup_ms = 0.0;
+    double clear_ms = 0.0;
+    double copy_ms = 0.0;
+    double sync_ms = 0.0;
+    double present_ms = 0.0;
+    double swap_call_ms = 0.0;
+    double fence_wait_ms = 0.0;
+    double gpu_ms = 0.0;
+    uint32_t draws = 0;
+    uint32_t raw_draws = 0;
+    uint64_t verts = 0;
+    uint64_t upload_bytes = 0;
+    uint32_t upload_overflows = 0;
+    uint64_t upload_ring_cap = 0;
+    uint64_t upload_ring_used = 0;
+    uint32_t textures = 0;
+    uint32_t targets = 0;
+    uint32_t window_w = 0;
+    uint32_t window_h = 0;
+    float render_scale = 1.0f;
+};
+void RecordPresent(const PresentMetrics& m);
+
+// Audio telemetry (xaudio2.cpp / dsound.cpp)
+void RecordAudioBlock(uint32_t render_us, uint32_t queued_before, uint32_t depth_blocks, bool starved,
+                      uint32_t glitches_delta);
+void RecordAudioVoices(uint32_t active_voices);
+void RecordStreamPacketCompleted();
+void RecordStreamUnderrun();
+
+// Filesystem & XISO telemetry (disc.cpp / files.cpp)
+void RecordDiscRead(uint32_t bytes, double ms);
+void RecordZIo(bool is_write, uint32_t bytes, double ms);
+void RecordHddOtherIo();
+
+// Guest memory allocation telemetry (memory.cpp)
+void RecordGuestContigAlloc(uint32_t bytes);
+void RecordGuestVirtCommit(uint32_t bytes);
