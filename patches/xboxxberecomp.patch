+// main/SDL thread only: never call SDL3 display queries from the Render or Guest threads
+void UpdateCachedRefreshHz() {
+    uint32_t r = 60;
+    if (SDL_WasInit(SDL_INIT_VIDEO)) {
+        SDL_DisplayID did = ResolveTargetDisplay();
+        if (did) {
+            const SDL_DisplayMode* dm = SDL_GetCurrentDisplayMode(did);
+            if (!dm || dm->refresh_rate <= 1.0f) dm = SDL_GetDesktopDisplayMode(did);
+            if (dm && dm->refresh_rate > 1.0f) {
+                r = uint32_t(std::lround(dm->refresh_rate));
+            }
+        }
+    }
+    g_cached_refresh_hz.store(r, std::memory_order_release);
+    g_refresh_dirty.store(false, std::memory_order_release);
+}
+
+// window thread only
+void ApplyNow() {
+    if (!g_window) return;
+    const Settings& s = Get();
+    SDL_DisplayID did = ResolveTargetDisplay();
+    SDL_Rect bounds{0, 0, 1280, 720};
+    if (did) SDL_GetDisplayBounds(did, &bounds);
+    const SDL_DisplayMode* desk = did ? SDL_GetDesktopDisplayMode(did) : nullptr;
+    Mode out = Output();
+
+    if (s.display_mode == DisplayMode::Windowed) {
+        SDL_SetWindowFullscreen(g_window, false);
+        SDL_SetWindowBordered(g_window, true);
+        SDL_SetWindowResizable(g_window, true);
+        SDL_Rect usable = bounds;
+        if (did) SDL_GetDisplayUsableBounds(did, &usable);
+        int uw = std::max(320, usable.w);
+        int uh = std::max(240, usable.h);
+        int w = std::min(int(out.width ? out.width : 1280), uw);
+        int h = std::min(int(out.height ? out.height : 720), uh);
+        SDL_SetWindowSize(g_window, w, h);
+        SDL_SetWindowPosition(g_window, usable.x + (uw - w) / 2, usable.y + (uh - h) / 2);
+        SDL_SyncWindow(g_window);
+    } else if (s.display_mode == DisplayMode::Borderless) {
+        int tw = std::max(320, bounds.w);
+        int th = std::max(240, bounds.h);
+        SDL_SetWindowFullscreenMode(g_window, nullptr);
+        SDL_SetWindowBordered(g_window, false);
+        SDL_SetWindowSize(g_window, tw, th);
+        SDL_SetWindowPosition(g_window, bounds.x, bounds.y);
+        SDL_SetWindowFullscreen(g_window, true);
+        SDL_SyncWindow(g_window);
+    } else {
+        // Exclusive fullscreen (or desktop-sized borderless if matching desktop mode)
+        int tw = std::max(320, bounds.w);
+        int th = std::max(240, bounds.h);
+        bool set_exclusive = false;
+        if (did && s.width && s.height &&
+            (!desk || int(s.width) != desk->w || int(s.height) != desk->h)) {
+            SDL_DisplayMode dm{};
+            if (SDL_GetClosestFullscreenDisplayMode(did, int(s.width), int(s.height), 0.0f, true, &dm)) {
+                SDL_SetWindowFullscreenMode(g_window, &dm);
+                tw = std::max(320, dm.w);
+                th = std::max(240, dm.h);
+                set_exclusive = true;
+            }
+        }
+        if (!set_exclusive) {
+            SDL_SetWindowFullscreenMode(g_window, nullptr);
+        }
+        SDL_SetWindowBordered(g_window, false);
+        SDL_SetWindowSize(g_window, tw, th);
+        SDL_SetWindowPosition(g_window, bounds.x, bounds.y);
+        SDL_SetWindowFullscreen(g_window, true);
+        SDL_SyncWindow(g_window);
+    }
+    UpdateCachedRefreshHz();
+}
