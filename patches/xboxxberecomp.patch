+    if (!cmd) return out;
+    std::string raw((std::istreambuf_iterator<char>(cmd)), {});
+    std::vector<std::string> args;
+    size_t pos = 0;
+    while (pos < raw.size()) {
+        size_t nul = raw.find('\0', pos);
+        if (nul == std::string::npos) nul = raw.size();
+        args.push_back(raw.substr(pos, nul - pos));
+        pos = nul + 1;
+    }
+    for (size_t i = 1; i < args.size(); ++i) {
+        if (args[i] == "--perf-log" && i + 1 < args.size()) {
+            out = StripQuotesA(args[++i]);
+        } else if (args[i].rfind("--perf-log=", 0) == 0) {
+            out = StripQuotesA(args[i].substr(11));
