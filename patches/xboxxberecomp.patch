+    if (cache_enabled_ && pso_lib_) {
+        std::lock_guard<std::mutex> lock(cache_lock_);
+        HRESULT shr = pso_lib_->StorePipeline(name, out.Get());
+        if (SUCCEEDED(shr)) {
+            pso_dirty_ = true;
+            cache_dirty_frame_ = presents_;
+        }
+    }
+    return true;
+}
