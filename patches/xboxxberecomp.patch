+size_t D3D12Backend::CompileBatchParallel(const std::vector<ShaderPrewarmItem>& batch) {
+    struct WorkItem {
+        uint64_t src_key = 0;
+        uint64_t blob_hash = 0;
+        bool is_pixel = false;
+        const std::string* hlsl = nullptr;
+    };
+    std::vector<WorkItem> work;
+    work.reserve(batch.size());
+    std::unordered_set<uint64_t> queued_blobs;
+    std::vector<std::pair<uint64_t, uint64_t>> already_cached_links;
+
+    for (const auto& item : batch) {
+        if (shader_src_.count(item.src_key)) continue;
+        const char* profile = item.is_pixel ? "ps_5_0" : "vs_5_0";
+        uint64_t pseed = Hash(profile, std::strlen(profile));
+        uint64_t eseed = Hash("main", 4, pseed);
+        uint64_t bhash = Hash(item.hlsl.data(), item.hlsl.size(), eseed);
+        auto bit = blobs_.find(bhash);
+        if (bit != blobs_.end() && bit->second) {
+            already_cached_links.emplace_back(item.src_key, bhash);
+            continue;
+        }
+        if (queued_blobs.insert(bhash).second) {
+            work.push_back(WorkItem{item.src_key, bhash, item.is_pixel, &item.hlsl});
+        } else {
+            already_cached_links.emplace_back(item.src_key, bhash);
+        }
+    }
+
+    for (const auto& [skey, bhash] : already_cached_links) {
+        if (blobs_.count(bhash) && blobs_[bhash]) {
+            shader_src_[skey] = bhash;
+            if (cache_enabled_) {
+                std::lock_guard<std::mutex> lock(cache_lock_);
+                if (known_src_keys_.insert(skey).second) {
+                    src_meta_entries_.push_back(SrcMetaEntry{skey, bhash});
+                    meta_dirty_ = true;
+                    cache_dirty_frame_ = presents_;
+                }
+            }
+        }
+    }
+
+    if (work.empty()) return 0;
+
+    g_warmup_total.fetch_add(uint32_t(work.size()), std::memory_order_relaxed);
+    std::vector<ComPtr<ID3DBlob>> out_blobs(work.size());
+    std::atomic<size_t> cursor{0};
+    uint32_t max_jobs = std::max<uint32_t>(1u, app::RecommendedCompileJobs());
+    uint32_t n_threads = std::min<uint32_t>({12u, max_jobs, uint32_t(work.size())});
+
+    auto worker = [&] {
+        for (;;) {
+            size_t idx = cursor.fetch_add(1, std::memory_order_relaxed);
+            if (idx >= work.size()) break;
+            const WorkItem& w = work[idx];
+            const char* profile = w.is_pixel ? "ps_5_0" : "vs_5_0";
+            ComPtr<ID3DBlob> code;
+            ComPtr<ID3DBlob> err;
+            HRESULT hr = D3DCompile(w.hlsl->data(), w.hlsl->size(), nullptr, nullptr, nullptr, "main", profile,
+                                    D3DCOMPILE_OPTIMIZATION_LEVEL1, 0, &code, &err);
+            if (SUCCEEDED(hr) && code && code->GetBufferSize() > 0) {
+                out_blobs[idx] = std::move(code);
+            }
+            g_warmup_done.fetch_add(1u, std::memory_order_relaxed);
+        }
+    };
+
+    std::vector<std::thread> pool;
+    pool.reserve(n_threads > 1 ? n_threads - 1 : 0);
+    for (uint32_t t = 1; t < n_threads; ++t) pool.emplace_back(worker);
+    worker();
+    for (auto& th : pool) th.join();
+
+    size_t compiled = 0;
+    for (size_t i = 0; i < work.size(); ++i) {
+        if (!out_blobs[i]) continue;
+        const WorkItem& w = work[i];
+        blobs_[w.blob_hash] = out_blobs[i];
+        shader_src_[w.src_key] = w.blob_hash;
+        ++compiled;
+        if (cache_enabled_) {
+            std::lock_guard<std::mutex> lock(cache_lock_);
+            const uint8_t* ptr = static_cast<const uint8_t*>(out_blobs[i]->GetBufferPointer());
+            shader_cache_entries_.emplace_back(w.blob_hash, std::vector<uint8_t>(ptr, ptr + out_blobs[i]->GetBufferSize()));
+            shaders_dirty_ = true;
+            if (known_src_keys_.insert(w.src_key).second) {
+                src_meta_entries_.push_back(SrcMetaEntry{w.src_key, w.blob_hash});
+                meta_dirty_ = true;
+            }
+            cache_dirty_frame_ = presents_;
+        }
+    }
+    // Link any secondary src_keys that shared a newly compiled blob_hash
+    for (const auto& [skey, bhash] : already_cached_links) {
+        auto bit = blobs_.find(bhash);
+        if (bit != blobs_.end() && bit->second && !shader_src_.count(skey)) {
+            shader_src_[skey] = bhash;
+            if (cache_enabled_) {
+                std::lock_guard<std::mutex> lock(cache_lock_);
+                if (known_src_keys_.insert(skey).second) {
+                    src_meta_entries_.push_back(SrcMetaEntry{skey, bhash});
+                    meta_dirty_ = true;
+                }
+            }
+        }
+    }
+    g_warmup_compiled_new.fetch_add(uint32_t(compiled), std::memory_order_relaxed);
+    return compiled;
+}
+
+void D3D12Backend::LoadAndPrewarmRecipes() {
+    constexpr uint64_t kSalt = 0x9E3779B97F4A7C15ull;
+    std::vector<ShaderPrewarmItem> batch;
+
+    if (cache_enabled_ && !cache_dir_.empty()) {
+        std::filesystem::path rpath = cache_dir_ / "shader_recipes.bin";
+        std::error_code ec;
+        auto fsize = std::filesystem::file_size(rpath, ec);
+        if (!ec && fsize >= sizeof(RecipeCacheHeader)) {
+            if (FILE* f = _wfopen(rpath.c_str(), L"rb")) {
+                RecipeCacheHeader rh{};
+                bool ok = std::fread(&rh, sizeof(rh), 1, f) == 1 && rh.magic == kRecipeCacheMagic &&
+                          rh.version == kRecipeCacheVersion && rh.sizeof_fixed_vs == sizeof(FixedVsRecipe) &&
+                          rh.sizeof_pixel_ps == sizeof(PixelRecipe) && rh.fixed_vs_count <= 65536u &&
+                          rh.pixel_ps_count <= 65536u;
+                uint64_t expect = uint64_t(sizeof(rh)) + uint64_t(rh.fixed_vs_count) * sizeof(FixedVsRecipe) +
+                                  uint64_t(rh.pixel_ps_count) * sizeof(PixelRecipe);
+                if (ok && expect == fsize) {
+                    std::vector<FixedVsRecipe> fv(rh.fixed_vs_count);
+                    std::vector<PixelRecipe> pp(rh.pixel_ps_count);
+                    if (rh.fixed_vs_count && std::fread(fv.data(), sizeof(FixedVsRecipe), rh.fixed_vs_count, f) != rh.fixed_vs_count)
+                        ok = false;
+                    if (ok && rh.pixel_ps_count && std::fread(pp.data(), sizeof(PixelRecipe), rh.pixel_ps_count, f) != rh.pixel_ps_count)
+                        ok = false;
+                    if (ok) {
+                        for (const auto& r : fv) {
+                            if (known_fixed_vs_recipes_.insert(r.vkey).second) fixed_vs_recipes_.push_back(r);
+                            if (!shader_src_.count(r.vkey)) {
+                                std::string hlsl = ReversedDepthHlsl(
+                                    FixedVertexHlsl(r.regs, r.pretransformed != 0, r.decode, r.fk));
+                                batch.push_back(ShaderPrewarmItem{
+                                    r.vkey, false, r.quad ? QuadHlsl(std::move(hlsl)) : std::move(hlsl)});
+                            }
+                        }
+                        for (const auto& r : pp) {
+                            if (known_pixel_ps_recipes_.insert(r.key).second) pixel_ps_recipes_.push_back(r);
+                            if (!shader_src_.count(r.key)) {
+                                batch.push_back(ShaderPrewarmItem{r.key, true, PixelHlsl(r.pk)});
+                            }
+                        }
+                    }
+                }
+                std::fclose(f);
+            }
+        }
+    }
+
+    auto seeds = BuildCommonFixedShaderPrewarmBatch(kSalt);
+    for (auto& s : seeds) {
+        if (!shader_src_.count(s.src_key)) batch.push_back(std::move(s));
+    }
+    if (!batch.empty()) {
+        auto t0 = PerfClock::now();
+        size_t n = CompileBatchParallel(batch);
+        if (n > 0) {
+            LOGR("d3d12: pre-compiled %zu fixed/recipe shaders at startup in %.1f ms", n, PerfMs(t0));
+        }
+    }
+}
+
+size_t D3D12Backend::BuildDeferredPsos() {
+    if (deferred_pso_keys_.empty()) return 0;
+    std::vector<PsoKey> remaining;
+    uint64_t gh = 0;
+    ID3DBlob* point_gs = Compile(PointHlsl(), "main", "gs_5_0", gh);
+    ID3DBlob* sprite_gs = Compile(SpriteHlsl(), "main", "gs_5_0", gh);
+    struct DeferredItem {
+        uint64_t hash;
+        PsoKey k;
+        ID3DBlob* vs;
+        ID3DBlob* ps;
+        ID3DBlob* gs;
+    };
+    std::vector<DeferredItem> ready;
+    for (const auto& k : deferred_pso_keys_) {
+        uint64_t h = Hash(&k, sizeof(k));
+        if (psos_.count(h)) continue;
+        auto vit = blobs_.find(k.vs);
+        auto pit = blobs_.find(k.ps);
+        if (vit == blobs_.end() || !vit->second || pit == blobs_.end() || !pit->second) {
+            remaining.push_back(k);
+            continue;
+        }
+        ID3DBlob* gs = (k.topo == uint32_t(Topology::Points)) ? (k.sprite ? sprite_gs : point_gs) : nullptr;
+        ready.push_back(DeferredItem{h, k, vit->second.Get(), pit->second.Get(), gs});
+    }
+    deferred_pso_keys_ = std::move(remaining);
+    if (ready.empty()) return 0;
+
+    std::vector<ComPtr<ID3D12PipelineState>> out_psos(ready.size());
+    std::atomic<size_t> cursor{0};
+    uint32_t max_jobs = std::max<uint32_t>(1u, app::RecommendedCompileJobs());
+    uint32_t n_threads = std::min<uint32_t>({12u, max_jobs, uint32_t(ready.size())});
+    auto worker = [&] {
+        for (;;) {
+            size_t idx = cursor.fetch_add(1, std::memory_order_relaxed);
+            if (idx >= ready.size()) break;
+            const auto& it = ready[idx];
+            D3D12_INPUT_ELEMENT_DESC el[16];
+            uint32_t n = FillInputLayout(it.k, el);
+            D3D12_GRAPHICS_PIPELINE_STATE_DESC d{};
+            d.InputLayout = {el, n};
+            FillPipelineDesc(it.k, it.vs, it.ps, d);
+            if (it.gs) {
+                d.GS = {it.gs->GetBufferPointer(), it.gs->GetBufferSize()};
+                d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+                d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+                d.RasterizerState.FrontCounterClockwise = FALSE;
+            }
+            ComPtr<ID3D12PipelineState> pso;
+            if (SUCCEEDED(dev_->CreateGraphicsPipelineState(&d, IID_PPV_ARGS(&pso))) && pso) {
+                out_psos[idx] = std::move(pso);
+            }
+        }
+    };
+    std::vector<std::thread> pool;
+    pool.reserve(n_threads > 1 ? n_threads - 1 : 0);
+    for (uint32_t t = 1; t < n_threads; ++t) pool.emplace_back(worker);
+    worker();
+    for (auto& th : pool) th.join();
+
+    size_t deferred_built = 0;
+    for (size_t i = 0; i < ready.size(); ++i) {
+        if (!out_psos[i]) continue;
+        psos_[ready[i].hash] = out_psos[i];
+        if (known_pso_keys_.insert(ready[i].hash).second) pso_meta_entries_.push_back(ready[i].k);
+        if (pso_lib_) {
+            wchar_t wname[32];
+            std::swprintf(wname, 32, L"draw_%016llX", (unsigned long long)ready[i].hash);
+            if (SUCCEEDED(pso_lib_->StorePipeline(wname, out_psos[i].Get()))) pso_dirty_ = true;
+        }
+        ++deferred_built;
+    }
+    return deferred_built;
+}
