+void ReplaceAll(std::string& s, const char* from, const char* to) {
+    size_t flen = std::strlen(from);
+    size_t tlen = std::strlen(to);
+    size_t pos = 0;
+    while ((pos = s.find(from, pos)) != std::string::npos) {
+        s.replace(pos, flen, to);
+        pos += tlen;
+    }
+}
