+            uint8_t px[16][4]{};
+            if (img.format == DXGI_FORMAT_BC1_UNORM) {
+                DecodeBcColorBlock(blk, true, px);
+            } else if (img.format == DXGI_FORMAT_BC2_UNORM) {
+                DecodeBcColorBlock(blk + 8, false, px);
+                for (int i = 0; i < 16; i++) {
+                    uint8_t nib = (blk[i / 2] >> ((i & 1) * 4)) & 0xF;
+                    px[i][3] = uint8_t((nib << 4) | nib);
+                }
+            } else {
+                DecodeBcColorBlock(blk + 8, false, px);
+                DecodeBc3AlphaBlock(blk, px);
+            }
+            for (uint32_t py = 0; py < 4; py++) {
+                uint32_t y = by * 4 + py;
+                if (y >= img.height) break;
+                for (uint32_t px_i = 0; px_i < 4; px_i++) {
+                    uint32_t x = bx * 4 + px_i;
+                    if (x >= img.width) break;
+                    std::memcpy(&rgba[(size_t(y) * img.width + x) * 4], px[py * 4 + px_i], 4);
+                }
+            }
+        }
+    }
+    return true;
+}
+
+void WriteBe32(std::vector<uint8_t>& out, uint32_t v) {
+    out.push_back(uint8_t((v >> 24) & 0xFF));
+    out.push_back(uint8_t((v >> 16) & 0xFF));
+    out.push_back(uint8_t((v >> 8) & 0xFF));
+    out.push_back(uint8_t(v & 0xFF));
+}
+
+uint32_t ReadBe32(const uint8_t* p) {
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+}
+
+void AppendPngChunk(std::vector<uint8_t>& out, const char type[4], const uint8_t* data, size_t len) {
+    WriteBe32(out, uint32_t(len));
+    size_t type_pos = out.size();
+    out.insert(out.end(), type, type + 4);
+    if (len && data) out.insert(out.end(), data, data + len);
+    uLong crc = crc32(0L, Z_NULL, 0);
+    crc = crc32(crc, out.data() + type_pos, uInt(4 + len));
+    WriteBe32(out, uint32_t(crc));
+}
+
+void WritePng(const fs::path& path, const Image& img) {
+    std::error_code ec;
+    if (fs::exists(path, ec)) return;
+    std::vector<uint8_t> rgba;
+    if (!LevelZeroToRgba(img, rgba)) {
+        LOGE("texture dump: %s unsupported format %u", Utf8(path).c_str(), uint32_t(img.format));
+        return;
+    }
+    size_t stride = size_t(img.width) * 4;
+    std::vector<uint8_t> raw(size_t(img.height) * (1 + stride));
+    for (uint32_t y = 0; y < img.height; y++) {
+        uint8_t* row = &raw[size_t(y) * (1 + stride)];
+        row[0] = 0;  // filter None
+        std::memcpy(row + 1, &rgba[size_t(y) * stride], stride);
+    }
+    uLongf comp_len = compressBound(uLong(raw.size()));
+    std::vector<uint8_t> comp(comp_len);
+    if (compress2(comp.data(), &comp_len, raw.data(), uLong(raw.size()), Z_DEFAULT_COMPRESSION) != Z_OK) {
+        LOGE("texture dump: %s zlib compress failed", Utf8(path).c_str());
+        return;
+    }
+    comp.resize(comp_len);
+
+    static constexpr uint8_t kSig[8] = {137, 80, 78, 71, 13, 10, 26, 10};
+    std::vector<uint8_t> png(kSig, kSig + 8);
+    std::vector<uint8_t> ihdr;
+    ihdr.reserve(13);
+    WriteBe32(ihdr, img.width);
+    WriteBe32(ihdr, img.height);
+    ihdr.push_back(8);  // bit depth
+    ihdr.push_back(6);  // RGBA
+    ihdr.push_back(0);  // deflate
+    ihdr.push_back(0);  // filter
+    ihdr.push_back(0);  // non-interlaced
+    AppendPngChunk(png, "IHDR", ihdr.data(), ihdr.size());
+    AppendPngChunk(png, "IDAT", comp.data(), comp.size());
+    AppendPngChunk(png, "IEND", nullptr, 0);
+
+    std::ofstream out(path, std::ios::binary);
+    out.write(reinterpret_cast<const char*>(png.data()), std::streamsize(png.size()));
+    if (!out) LOGE("texture dump: %s not written", Utf8(path).c_str());
+}
+
+uint8_t Paeth(uint8_t a, uint8_t b, uint8_t c) {
+    int p = int(a) + int(b) - int(c);
+    int pa = std::abs(p - int(a));
+    int pb = std::abs(p - int(b));
+    int pc = std::abs(p - int(c));
+    if (pa <= pb && pa <= pc) return a;
+    return pb <= pc ? b : c;
+}
+
+bool ReadPng(const fs::path& path, Image& img) {
+    std::ifstream in(path, std::ios::binary);
+    std::vector<uint8_t> f{std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>()};
+    static constexpr uint8_t kSig[8] = {137, 80, 78, 71, 13, 10, 26, 10};
+    if (f.size() < 33 || std::memcmp(f.data(), kSig, 8) != 0) return false;
+
+    uint32_t w = 0, h = 0;
+    uint8_t bit_depth = 0, color_type = 0, interlace = 0;
+    bool have_ihdr = false;
+    std::vector<uint8_t> idat;
+    std::vector<uint8_t> plte;
+    std::vector<uint8_t> trns;
+
+    size_t pos = 8;
+    while (pos + 12 <= f.size()) {
+        uint32_t len = ReadBe32(&f[pos]);
+        const char* type = reinterpret_cast<const char*>(&f[pos + 4]);
+        pos += 8;
+        if (pos + len + 4 > f.size()) return false;
+        if (std::memcmp(type, "IHDR", 4) == 0 && len >= 13) {
+            w = ReadBe32(&f[pos]);
+            h = ReadBe32(&f[pos + 4]);
+            bit_depth = f[pos + 8];
+            color_type = f[pos + 9];
+            interlace = f[pos + 12];
+            have_ihdr = true;
+        } else if (std::memcmp(type, "IDAT", 4) == 0) {
+            idat.insert(idat.end(), f.begin() + pos, f.begin() + pos + len);
+        } else if (std::memcmp(type, "PLTE", 4) == 0) {
+            plte.assign(f.begin() + pos, f.begin() + pos + len);
+        } else if (std::memcmp(type, "tRNS", 4) == 0) {
+            trns.assign(f.begin() + pos, f.begin() + pos + len);
+        } else if (std::memcmp(type, "IEND", 4) == 0) {
+            break;
+        }
+        pos += len + 4;
+    }
+
+    if (!have_ihdr || !w || !h || w > kMaxSide || h > kMaxSide || bit_depth != 8 || interlace != 0 || idat.empty()) {
+        return false;
+    }
+    uint32_t bpp = 0;
+    switch (color_type) {
+        case 0: bpp = 1; break;  // Gray
+        case 2: bpp = 3; break;  // RGB
+        case 3: bpp = 1; break;  // Indexed
+        case 4: bpp = 2; break;  // Gray+Alpha
+        case 6: bpp = 4; break;  // RGBA
+        default: return false;
+    }
+    size_t scan_bytes = size_t(w) * bpp;
+    size_t raw_size = size_t(h) * (1 + scan_bytes);
+    std::vector<uint8_t> raw(raw_size);
+
+    z_stream zs{};
+    if (inflateInit(&zs) != Z_OK) return false;
+    zs.next_in = idat.data();
+    zs.avail_in = uInt(idat.size());
+    zs.next_out = raw.data();
+    zs.avail_out = uInt(raw.size());
+    int zres = inflate(&zs, Z_FINISH);
+    inflateEnd(&zs);
+    if (zres != Z_STREAM_END || zs.total_out != raw_size) return false;
+
+    std::vector<uint8_t> prev(scan_bytes, 0), cur(scan_bytes, 0);
+    Level top{std::vector<uint8_t>(size_t(w) * h * 4), w * 4};
+    for (uint32_t y = 0; y < h; y++) {
+        const uint8_t* src = &raw[size_t(y) * (1 + scan_bytes)];
+        uint8_t filter = src[0];
+        const uint8_t* in_row = src + 1;
+        for (size_t i = 0; i < scan_bytes; i++) {
+            uint8_t a = (i >= bpp) ? cur[i - bpp] : 0;
+            uint8_t b = prev[i];
+            uint8_t c = (i >= bpp) ? prev[i - bpp] : 0;
+            switch (filter) {
+                case 0: cur[i] = in_row[i]; break;
+                case 1: cur[i] = uint8_t(in_row[i] + a); break;
+                case 2: cur[i] = uint8_t(in_row[i] + b); break;
+                case 3: cur[i] = uint8_t(in_row[i] + ((int(a) + int(b)) >> 1)); break;
+                case 4: cur[i] = uint8_t(in_row[i] + Paeth(a, b, c)); break;
+                default: return false;
+            }
+        }
+        uint8_t* dst = &top.px[size_t(y) * top.pitch];
+        for (uint32_t x = 0; x < w; x++) {
+            uint8_t r = 0, g_c = 0, b_c = 0, a_c = 255;
+            if (color_type == 6) {
+                r = cur[x * 4 + 0]; g_c = cur[x * 4 + 1]; b_c = cur[x * 4 + 2]; a_c = cur[x * 4 + 3];
+            } else if (color_type == 2) {
+                r = cur[x * 3 + 0]; g_c = cur[x * 3 + 1]; b_c = cur[x * 3 + 2];
+            } else if (color_type == 4) {
+                r = g_c = b_c = cur[x * 2 + 0]; a_c = cur[x * 2 + 1];
+            } else if (color_type == 0) {
+                r = g_c = b_c = cur[x];
+            } else if (color_type == 3) {
+                uint8_t idx = cur[x];
+                if (size_t(idx) * 3 + 2 < plte.size()) {
+                    r = plte[idx * 3 + 0]; g_c = plte[idx * 3 + 1]; b_c = plte[idx * 3 + 2];
+                }
+                if (idx < trns.size()) a_c = trns[idx];
+            }
+            // Output BGRA8 to match Windows WIC path
+            dst[x * 4 + 0] = b_c;
+            dst[x * 4 + 1] = g_c;
+            dst[x * 4 + 2] = r;
+            dst[x * 4 + 3] = a_c;
+        }
+        prev.swap(cur);
+    }
+
+    img.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    img.width = w;
+    img.height = h;
+    img.levels.push_back(std::move(top));
+    return true;
+}
