+            auto* c = reinterpret_cast<Ctx*>(lp);
+            MONITORINFOEXW mi{};
+            mi.cbSize = sizeof(mi);
+            if (!GetMonitorInfoW(hmon, &mi)) return TRUE;
+            c->index++;
+            MonitorInfo info;
+            info.device = WideToUtf8(mi.szDevice);
+            info.primary = (mi.dwFlags & MONITORINFOF_PRIMARY) != 0;
+            DEVMODEW dm{};
+            dm.dmSize = sizeof(dm);
+            if (EnumDisplaySettingsW(mi.szDevice, ENUM_CURRENT_SETTINGS, &dm) ||
+                EnumDisplaySettingsW(mi.szDevice, ENUM_REGISTRY_SETTINGS, &dm)) {
+                info.width = dm.dmPelsWidth;
+                info.height = dm.dmPelsHeight;
+                info.hz = dm.dmDisplayFrequency;
+            }
+            DISPLAY_DEVICEW dd{};
+            dd.cb = sizeof(dd);
+            std::string friendly;
+            if (EnumDisplayDevicesW(mi.szDevice, 0, &dd, 0) && dd.DeviceString[0])
+                friendly = WideToUtf8(dd.DeviceString);
+            char buf[256];
+            std::snprintf(buf, sizeof(buf), "Display %d: %ux%u @ %u Hz%s%s%s", c->index, info.width, info.height,
+                          info.hz, info.primary ? " (Primary)" : "", friendly.empty() ? "" : " - ",
+                          friendly.c_str());
+            info.label = buf;
+            c->list->push_back(std::move(info));
+            return TRUE;
+        },
+        reinterpret_cast<LPARAM>(&ctx));
+#else
+    if (!SDL_WasInit(SDL_INIT_VIDEO)) return out;
+    int count = 0;
+    SDL_DisplayID primary = SDL_GetPrimaryDisplay();
+    if (SDL_DisplayID* ids = SDL_GetDisplays(&count)) {
+        for (int i = 0; i < count; ++i) {
+            MonitorInfo info;
+            info.device = std::to_string(ids[i]);
+            info.primary = (ids[i] == primary);
+            if (const SDL_DisplayMode* dm = SDL_GetDesktopDisplayMode(ids[i])) {
+                info.width = uint32_t(std::max(0, dm->w));
+                info.height = uint32_t(std::max(0, dm->h));
+                info.hz = uint32_t(std::max(0L, std::lround(dm->refresh_rate)));
+            }
+            const char* name = SDL_GetDisplayName(ids[i]);
+            char buf[256];
+            std::snprintf(buf, sizeof(buf), "Display %d: %ux%u @ %u Hz%s%s%s", i + 1, info.width, info.height,
+                          info.hz, info.primary ? " (Primary)" : "", (name && *name) ? " - " : "",
+                          (name && *name) ? name : "");
+            info.label = buf;
+            out.push_back(std::move(info));
+        }
+        SDL_free(ids);
+    }
+#endif
+    return out;
+}
