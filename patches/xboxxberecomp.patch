+VulkanBackend::~VulkanBackend() {
+    StopAsyncPrewarm();
+    if (dev_ != VK_NULL_HANDLE) {
+        vk_.dev_wait_idle(dev_);
+    }
+    if (upscaler_inited_) {
+        if (Upscaler* u = g_upscaler.load(std::memory_order_acquire)) u->Shutdown();
+        upscaler_inited_ = false;
+    }
+    FlushCaches();
+    StopSaveThread();
+    if (imgui_inited_) {
+        ImGui_ImplVulkan_Shutdown();
+        imgui_inited_ = false;
+    }
+    if (dev_ != VK_NULL_HANDLE) {
+        for (auto& f : frames_) {
+            FreeDeferred(f.garbage);
+            if (f.upload_buf != VK_NULL_HANDLE) vk_.destroy_buf(dev_, f.upload_buf, nullptr);
+            if (f.upload_mem != VK_NULL_HANDLE) vk_.free_mem(dev_, f.upload_mem, nullptr);
+            if (f.desc_pool != VK_NULL_HANDLE) vk_.destroy_desc_pool(dev_, f.desc_pool, nullptr);
+            for (VkDescriptorPool ep : f.extra_desc_pools) {
+                if (ep != VK_NULL_HANDLE) vk_.destroy_desc_pool(dev_, ep, nullptr);
+            }
+            f.extra_desc_pools.clear();
+            if (f.cmd_pool != VK_NULL_HANDLE) vk_.destroy_cmd_pool(dev_, f.cmd_pool, nullptr);
+        }
+        for (auto& s : img_avail_sems_)
+            if (s != VK_NULL_HANDLE) vk_.destroy_sem(dev_, s, nullptr);
+        if (timeline_sem_ != VK_NULL_HANDLE) vk_.destroy_sem(dev_, timeline_sem_, nullptr);
+
+        if (upload_tex_view_ != VK_NULL_HANDLE) vk_.destroy_img_view(dev_, upload_tex_view_, nullptr);
+        if (upload_tex_img_ != VK_NULL_HANDLE) vk_.destroy_img(dev_, upload_tex_img_, nullptr);
+        if (upload_tex_mem_ != VK_NULL_HANDLE) vk_.free_mem(dev_, upload_tex_mem_, nullptr);
+        if (rb_buf_ != VK_NULL_HANDLE) vk_.destroy_buf(dev_, rb_buf_, nullptr);
+        if (rb_mem_ != VK_NULL_HANDLE) vk_.free_mem(dev_, rb_mem_, nullptr);
+        if (sync_down_view_ != VK_NULL_HANDLE) vk_.destroy_img_view(dev_, sync_down_view_, nullptr);
+        if (sync_down_img_ != VK_NULL_HANDLE) vk_.destroy_img(dev_, sync_down_img_, nullptr);
+        if (sync_down_mem_ != VK_NULL_HANDLE) vk_.free_mem(dev_, sync_down_mem_, nullptr);
+
+        for (auto& [k, t] : targets_) {
+            if (t.att_view != VK_NULL_HANDLE) vk_.destroy_img_view(dev_, t.att_view, nullptr);
+            if (t.srv_view != VK_NULL_HANDLE && t.srv_view != t.att_view) vk_.destroy_img_view(dev_, t.srv_view, nullptr);
+            if (t.img != VK_NULL_HANDLE) vk_.destroy_img(dev_, t.img, nullptr);
+            if (t.mem != VK_NULL_HANDLE) vk_.free_mem(dev_, t.mem, nullptr);
+            if (t.fb_view != VK_NULL_HANDLE) vk_.destroy_img_view(dev_, t.fb_view, nullptr);
+            if (t.fb_img != VK_NULL_HANDLE) vk_.destroy_img(dev_, t.fb_img, nullptr);
+            if (t.fb_mem != VK_NULL_HANDLE) vk_.free_mem(dev_, t.fb_mem, nullptr);
+        }
+        targets_.clear();
+
+        auto destroy_tex = [&](Tex& tx) {
+            if (tx.view != VK_NULL_HANDLE) vk_.destroy_img_view(dev_, tx.view, nullptr);
+            if (tx.img != VK_NULL_HANDLE) vk_.destroy_img(dev_, tx.img, nullptr);
+            if (tx.mem != VK_NULL_HANDLE) vk_.free_mem(dev_, tx.mem, nullptr);
+        };
+        for (auto& [k, tx] : textures_) destroy_tex(tx);
+        for (auto& [k, tx] : pack_textures_) destroy_tex(tx);
+        textures_.clear();
+        pack_textures_.clear();
+        for (auto& slab : tex_slabs_) {
+            if (slab.mem != VK_NULL_HANDLE) vk_.free_mem(dev_, slab.mem, nullptr);
+        }
+        tex_slabs_.clear();
+
+        for (auto& [k, l] : late_) {
+            for (int i = 0; i < kFrames; ++i) {
+                if (l.rb[i] != VK_NULL_HANDLE) vk_.destroy_buf(dev_, l.rb[i], nullptr);
+                if (l.rb_mem[i] != VK_NULL_HANDLE) vk_.free_mem(dev_, l.rb_mem[i], nullptr);
+            }
+            if (l.down_view != VK_NULL_HANDLE) vk_.destroy_img_view(dev_, l.down_view, nullptr);
+            if (l.down_img != VK_NULL_HANDLE) vk_.destroy_img(dev_, l.down_img, nullptr);
+            if (l.down_mem != VK_NULL_HANDLE) vk_.free_mem(dev_, l.down_mem, nullptr);
+        }
+        late_.clear();
+
+        auto destroy_dummy = [&](DummyTex& d) {
+            if (d.view != VK_NULL_HANDLE) vk_.destroy_img_view(dev_, d.view, nullptr);
+            if (d.img != VK_NULL_HANDLE) vk_.destroy_img(dev_, d.img, nullptr);
+            if (d.mem != VK_NULL_HANDLE) vk_.free_mem(dev_, d.mem, nullptr);
+        };
+        destroy_dummy(dummy_2d_);
+        destroy_dummy(dummy_3d_);
+        destroy_dummy(dummy_cube_);
+        destroy_dummy(dummy_depth_2d_);
+
+        if (lut_view_ != VK_NULL_HANDLE) vk_.destroy_img_view(dev_, lut_view_, nullptr);
+        if (lut_img_ != VK_NULL_HANDLE) vk_.destroy_img(dev_, lut_img_, nullptr);
+        if (lut_mem_ != VK_NULL_HANDLE) vk_.free_mem(dev_, lut_mem_, nullptr);
+
+        if (occ_pool_ != VK_NULL_HANDLE) vk_.destroy_query_pool(dev_, occ_pool_, nullptr);
+        if (occ_rb_ != VK_NULL_HANDLE) vk_.destroy_buf(dev_, occ_rb_, nullptr);
+        if (occ_rb_mem_ != VK_NULL_HANDLE) vk_.free_mem(dev_, occ_rb_mem_, nullptr);
+        if (ts_pool_ != VK_NULL_HANDLE) vk_.destroy_query_pool(dev_, ts_pool_, nullptr);
+
+        for (auto& [k, p] : psos_)
+            if (p != VK_NULL_HANDLE) vk_.destroy_pipe(dev_, p, nullptr);
+        for (auto& [k, p] : blit_psos_)
+            if (p != VK_NULL_HANDLE) vk_.destroy_pipe(dev_, p, nullptr);
+        for (auto& [k, m] : shader_mods_)
+            if (m != VK_NULL_HANDLE) vk_.destroy_shader(dev_, m, nullptr);
+        for (auto& [k, s] : samplers_)
+            if (s != VK_NULL_HANDLE) vk_.destroy_sampler(dev_, s, nullptr);
+        for (auto& [k, fb] : fb_cache_)
+            if (fb != VK_NULL_HANDLE) vk_.destroy_fb(dev_, fb, nullptr);
+        for (auto& [k, rp] : rp_cache_)
+            if (rp != VK_NULL_HANDLE) vk_.destroy_rp(dev_, rp, nullptr);
+
+        DestroySwapchain();
+        if (present_rp_ != VK_NULL_HANDLE) vk_.destroy_rp(dev_, present_rp_, nullptr);
+        if (pipe_cache_ != VK_NULL_HANDLE) vk_.destroy_pipe_cache(dev_, pipe_cache_, nullptr);
+        if (ui_pool_ != VK_NULL_HANDLE) vk_.destroy_desc_pool(dev_, ui_pool_, nullptr);
+        if (gfx_layout_ != VK_NULL_HANDLE) vk_.destroy_pipe_layout(dev_, gfx_layout_, nullptr);
+        if (gfx_dsl_ != VK_NULL_HANDLE) vk_.destroy_dsl(dev_, gfx_dsl_, nullptr);
+        vk_.destroy_device(dev_, nullptr);
+        dev_ = VK_NULL_HANDLE;
+    }
+    if (surface_ != VK_NULL_HANDLE && instance_ != VK_NULL_HANDLE) {
+        vk_.destroy_surface(instance_, surface_, nullptr);
+        surface_ = VK_NULL_HANDLE;
+    }
+    if (instance_ != VK_NULL_HANDLE) {
+        vk_.destroy_instance(instance_, nullptr);
+        instance_ = VK_NULL_HANDLE;
+    }
+}
+
+bool VulkanBackend::Init(uint32_t width, uint32_t height) {
+    g_reversed_depth = true;
+    guest_w_ = width;
+    guest_h_ = height;
+    ParseCaptureCli();
+
+    if (!SDL_Vulkan_LoadLibrary(nullptr)) {
+        LOGE("vulkan: SDL_Vulkan_LoadLibrary failed: %s", SDL_GetError());
+        return false;
+    }
+    if (!vk_.LoadGlobal()) {
+        LOGE("vulkan: failed to load global Vulkan symbols");
+        return false;
+    }
+    if (!CreateInstanceAndDevice()) return false;
+
+    int win_w = 1280, win_h = 720;
+    if (auto* win = static_cast<SDL_Window*>(app::Window())) {
+        SDL_GetWindowSizeInPixels(win, &win_w, &win_h);
+    }
+    if (!CreateSwapchain(uint32_t(std::max(win_w, 1)), uint32_t(std::max(win_h, 1)))) return false;
+    if (!CreatePipelineLayout()) return false;
+    InitCaches();
+    if (!CreateFrames()) return false;
+    if (!CreateQueries()) return false;
+    if (!CreateDummyTextures()) return false;
+    if (!CreateGammaLut()) return false;
+    if (!InitImGui()) return false;
+
+    Begin();
+    // Initialize dummy textures & occlusion query pool on first command buffer
+    if (occ_pool_ != VK_NULL_HANDLE) vk_.cmd_reset_qp(cmd_, occ_pool_, 0, kQueries);
+    {
+        VkImageLayout l = VK_IMAGE_LAYOUT_UNDEFINED;
+        TransitionImage(dummy_2d_.img, l, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_ASPECT_COLOR_BIT);
+        l = VK_IMAGE_LAYOUT_UNDEFINED;
+        TransitionImage(dummy_3d_.img, l, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_ASPECT_COLOR_BIT);
+        l = VK_IMAGE_LAYOUT_UNDEFINED;
+        TransitionImage(dummy_cube_.img, l, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_ASPECT_COLOR_BIT, 1, 6);
+        l = VK_IMAGE_LAYOUT_UNDEFINED;
+        TransitionImage(dummy_depth_2d_.img, l, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                        VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT);
+        TransitionImage(lut_img_, lut_layout_, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_ASPECT_COLOR_BIT);
+    }
+    InitUpscaler();
+    LoadSettings();
+    if (upscaler_inited_) {
+        if (Upscaler* u = g_upscaler.load(std::memory_order_acquire)) {
+            auto pw0 = PerfClock::now();
+            u->Prewarm(reinterpret_cast<void*>(cmd_), render_w_, render_h_, vp_w_, vp_h_);
+            LOGR("vulkan: upscaler prewarm complete (%.1f ms, %ux%u -> %ux%u)", PerfMs(pw0), render_w_, render_h_, vp_w_,
+                 vp_h_);
+        }
+    }
+
+    LOGR("vulkan: %ux%u guest, render=%ux%u -> vp=%ux%u (bb=%ux%u, scale=%.3fx%.3f, upload=%llu MiB, uma=%s, api=%u.%u)",
+         width, height, render_w_, render_h_, vp_w_, vp_h_, bb_w_, bb_h_, scale_x_, scale_y_,
+         (unsigned long long)(upload_size_ >> 20), caps_.uma ? "true" : "false",
+         VK_API_VERSION_MAJOR(phys_props_.apiVersion), VK_API_VERSION_MINOR(phys_props_.apiVersion));
+    return true;
+}
+
+bool VulkanBackend::CreateInstanceAndDevice() {
+    auto* win = static_cast<SDL_Window*>(app::Window());
+    if (!win) {
+        LOGE("vulkan: app::Window() is null");
+        return false;
+    }
+
+    uint32_t sdl_ext_count = 0;
+    const char* const* sdl_exts = SDL_Vulkan_GetInstanceExtensions(&sdl_ext_count);
+    std::vector<const char*> inst_exts;
+    for (uint32_t i = 0; i < sdl_ext_count; ++i) inst_exts.push_back(sdl_exts[i]);
+
+    bool want_debug = std::getenv("XBE_VK_DEBUG") != nullptr;
+    std::vector<const char*> layers;
+    if (want_debug) {
+        uint32_t lc = 0;
+        vk_.enum_inst_layers(&lc, nullptr);
+        std::vector<VkLayerProperties> lprops(lc);
+        vk_.enum_inst_layers(&lc, lprops.data());
+        for (const auto& lp : lprops) {
+            if (std::strcmp(lp.layerName, "VK_LAYER_KHRONOS_validation") == 0) {
+                layers.push_back("VK_LAYER_KHRONOS_validation");
+                break;
+            }
+        }
+    }
+
+    VkApplicationInfo app_info{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    app_info.pApplicationName = "The Suffering Recomp";
+    app_info.applicationVersion = VK_MAKE_VERSION(1, 3, 0);
+    app_info.pEngineName = "XboxXBERecomp";
+    app_info.engineVersion = VK_MAKE_VERSION(1, 3, 0);
+    app_info.apiVersion = VK_API_VERSION_1_2;
+
+    VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    ici.pApplicationInfo = &app_info;
+    ici.enabledExtensionCount = uint32_t(inst_exts.size());
+    ici.ppEnabledExtensionNames = inst_exts.data();
+    ici.enabledLayerCount = uint32_t(layers.size());
+    ici.ppEnabledLayerNames = layers.data();
+
+    if (vk_.create_instance(&ici, nullptr, &instance_) != VK_SUCCESS) {
+        LOGE("vulkan: vkCreateInstance failed");
+        return false;
+    }
+    if (!vk_.LoadInstance(instance_)) {
+        LOGE("vulkan: failed to load instance functions");
+        return false;
+    }
+    if (!SDL_Vulkan_CreateSurface(win, instance_, nullptr, &surface_)) {
+        LOGE("vulkan: SDL_Vulkan_CreateSurface failed: %s", SDL_GetError());
+        return false;
+    }
+
+    uint32_t dev_count = 0;
+    vk_.enum_phys_devs(instance_, &dev_count, nullptr);
+    if (dev_count == 0) {
+        LOGE("vulkan: no Vulkan physical devices found");
+        return false;
+    }
+    std::vector<VkPhysicalDevice> phys_list(dev_count);
+    vk_.enum_phys_devs(instance_, &dev_count, phys_list.data());
+
+    struct Cand {
+        VkPhysicalDevice pd = VK_NULL_HANDLE;
+        VkPhysicalDeviceProperties props{};
+        VkPhysicalDeviceFeatures feats{};
+        VkPhysicalDeviceVulkan12Features vk12{};
+        VkPhysicalDeviceMemoryProperties mem{};
+        uint32_t qfam = ~0u;
+        uint64_t vram = 0;
+        std::string key;
+        bool is_sw = false;
+        bool has_custom_border = false;
+        bool has_mem_budget = false;
+        int priority = 0;
+    };
+    std::vector<Cand> cands;
+    std::unordered_map<uint64_t, uint32_t> ord_map;
+    for (VkPhysicalDevice pd : phys_list) {
+        Cand c;
+        c.pd = pd;
+        vk_.get_phys_props(pd, &c.props);
+        if (c.props.apiVersion < VK_API_VERSION_1_2) continue;
+
+        VkPhysicalDeviceFeatures2 f2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+        c.vk12.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES;
+        f2.pNext = &c.vk12;
+        vk_.get_phys_feats2(pd, &f2);
+        c.feats = f2.features;
+        if (!c.vk12.timelineSemaphore || !c.feats.geometryShader || !c.feats.fillModeNonSolid ||
+            !c.feats.samplerAnisotropy || !c.feats.textureCompressionBC) {
+            continue;
+        }
+
+        uint32_t qcount = 0;
+        vk_.get_queue_fams(pd, &qcount, nullptr);
+        std::vector<VkQueueFamilyProperties> qprops(qcount);
+        vk_.get_queue_fams(pd, &qcount, qprops.data());
+        for (uint32_t q = 0; q < qcount; ++q) {
+            VkBool32 sup = VK_FALSE;
+            vk_.get_surf_support(pd, q, surface_, &sup);
+            if ((qprops[q].queueFlags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)) ==
+                    (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT) &&
+                sup) {
+                c.qfam = q;
+                break;
+            }
+        }
+        if (c.qfam == ~0u) continue;
+
+        uint32_t ecount = 0;
+        vk_.enum_dev_exts(pd, nullptr, &ecount, nullptr);
+        std::vector<VkExtensionProperties> eprops(ecount);
+        vk_.enum_dev_exts(pd, nullptr, &ecount, eprops.data());
+        bool has_swap = false;
+        for (const auto& ep : eprops) {
+            if (std::strcmp(ep.extensionName, VK_KHR_SWAPCHAIN_EXTENSION_NAME) == 0) has_swap = true;
+            if (std::strcmp(ep.extensionName, VK_EXT_CUSTOM_BORDER_COLOR_EXTENSION_NAME) == 0) c.has_custom_border = true;
+            if (std::strcmp(ep.extensionName, VK_EXT_MEMORY_BUDGET_EXTENSION_NAME) == 0) c.has_mem_budget = true;
+        }
+        if (!has_swap) continue;
+
+        vk_.get_phys_mem(pd, &c.mem);
+        for (uint32_t h = 0; h < c.mem.memoryHeapCount; ++h) {
+            if (c.mem.memoryHeaps[h].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) c.vram += c.mem.memoryHeaps[h].size;
+        }
+        c.is_sw = (c.props.deviceType == VK_PHYSICAL_DEVICE_TYPE_CPU);
+        switch (c.props.deviceType) {
+            case VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU: c.priority = 4; break;
+            case VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU: c.priority = 3; break;
+            case VK_PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU: c.priority = 2; break;
+            case VK_PHYSICAL_DEVICE_TYPE_CPU: c.priority = 1; break;
+            default: c.priority = 0; break;
+        }
+        uint64_t k = (uint64_t(c.props.vendorID) << 32) | uint64_t(c.props.deviceID);
+        uint32_t ord = ord_map[k]++;
+        char keybuf[64];
+        std::snprintf(keybuf, sizeof(keybuf), "%04X:%04X:%08X:%u", c.props.vendorID, c.props.deviceID, 0u, ord);
+        c.key = keybuf;
+        cands.push_back(std::move(c));
+    }
+
+    if (cands.empty()) {
+        LOGE("vulkan: no Vulkan 1.2 device with required features found");
+        return false;
+    }
+
+    std::stable_sort(cands.begin(), cands.end(), [](const Cand& a, const Cand& b) {
+        if (a.priority != b.priority) return a.priority > b.priority;
+        return a.vram > b.vram;
+    });
+
+    int chosen = -1;
+    const std::string& want = app::Get().gpu_adapter;
+    if (!want.empty() && LowerAscii(want) != "auto") {
+        std::string wlow = LowerAscii(want);
+        for (size_t i = 0; i < cands.size(); ++i) {
+            if (LowerAscii(cands[i].key) == wlow || LowerAscii(cands[i].props.deviceName).find(wlow) != std::string::npos) {
+                chosen = int(i);
+                break;
+            }
+        }
+    }
+    if (chosen < 0) chosen = 0;
+
+    const Cand& sel = cands[size_t(chosen)];
+    phys_ = sel.pd;
+    phys_props_ = sel.props;
+    mem_props_ = sel.mem;
+    queue_family_ = sel.qfam;
+    has_custom_border_ = sel.has_custom_border;
+    has_mem_budget_ = sel.has_mem_budget;
+    ubo_align_ = std::max<uint64_t>(256, phys_props_.limits.minUniformBufferOffsetAlignment);
+
+    // Check preferred depth format
+    VkFormatProperties fp{};
+    vk_.get_fmt_props(phys_, VK_FORMAT_D32_SFLOAT_S8_UINT, &fp);
+    VkFormatFeatureFlags need_ds = VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+    if ((fp.optimalTilingFeatures & need_ds) == need_ds) {
+        depth_fmt_ = VK_FORMAT_D32_SFLOAT_S8_UINT;
+    } else {
+        depth_fmt_ = VK_FORMAT_D24_UNORM_S8_UINT;
+    }
+
+    float qprio = 1.0f;
+    VkDeviceQueueCreateInfo qci{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+    qci.queueFamilyIndex = queue_family_;
+    qci.queueCount = 1;
+    qci.pQueuePriorities = &qprio;
+
+    std::vector<const char*> dev_exts = {VK_KHR_SWAPCHAIN_EXTENSION_NAME};
+    if (has_custom_border_) dev_exts.push_back(VK_EXT_CUSTOM_BORDER_COLOR_EXTENSION_NAME);
+    if (has_mem_budget_) dev_exts.push_back(VK_EXT_MEMORY_BUDGET_EXTENSION_NAME);
+
+    VkPhysicalDeviceFeatures enabled_feats{};
+    enabled_feats.geometryShader = VK_TRUE;
+    enabled_feats.fillModeNonSolid = VK_TRUE;
+    enabled_feats.samplerAnisotropy = VK_TRUE;
+    enabled_feats.textureCompressionBC = VK_TRUE;
+    enabled_feats.occlusionQueryPrecise = sel.feats.occlusionQueryPrecise;
+    enabled_feats.shaderStorageImageWriteWithoutFormat = sel.feats.shaderStorageImageWriteWithoutFormat;
+
+    VkPhysicalDeviceVulkan12Features enabled_vk12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+    enabled_vk12.timelineSemaphore = VK_TRUE;
+
+    VkPhysicalDeviceCustomBorderColorFeaturesEXT border_feats{
+        VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_CUSTOM_BORDER_COLOR_FEATURES_EXT};
+    if (has_custom_border_) {
+        border_feats.customBorderColors = VK_TRUE;
+        border_feats.customBorderColorWithoutFormat = VK_TRUE;
+        enabled_vk12.pNext = &border_feats;
+    }
+
+    VkDeviceCreateInfo dci{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+    dci.pNext = &enabled_vk12;
+    dci.queueCreateInfoCount = 1;
+    dci.pQueueCreateInfos = &qci;
+    dci.enabledExtensionCount = uint32_t(dev_exts.size());
+    dci.ppEnabledExtensionNames = dev_exts.data();
+    dci.pEnabledFeatures = &enabled_feats;
+
+    if (vk_.create_device(phys_, &dci, nullptr, &dev_) != VK_SUCCESS) {
+        LOGE("vulkan: vkCreateDevice failed for %s", phys_props_.deviceName);
+        return false;
+    }
+    if (!vk_.LoadDevice(dev_)) {
+        LOGE("vulkan: failed to load device functions");
+        return false;
+    }
+    vk_.get_queue(dev_, queue_family_, 0, &queue_);
+
+    // Probe present modes
+    uint32_t pm_count = 0;
+    vk_.get_surf_modes(phys_, surface_, &pm_count, nullptr);
+    std::vector<VkPresentModeKHR> pms(pm_count);
+    vk_.get_surf_modes(phys_, surface_, &pm_count, pms.data());
+    for (auto m : pms) {
+        if (m == VK_PRESENT_MODE_IMMEDIATE_KHR) has_immediate_ = true;
+        if (m == VK_PRESENT_MODE_MAILBOX_KHR) has_mailbox_ = true;
+    }
+
+    // Populate GpuCaps & adaptive upload ring size
+    bool all_host_vis = true;
+    uint64_t shared_mem = 0;
+    for (uint32_t h = 0; h < mem_props_.memoryHeapCount; ++h) {
+        if (!(mem_props_.memoryHeaps[h].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)) {
+            shared_mem += mem_props_.memoryHeaps[h].size;
+        }
+    }
+    for (uint32_t t = 0; t < mem_props_.memoryTypeCount; ++t) {
+        if ((mem_props_.memoryTypes[t].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) &&
+            !(mem_props_.memoryTypes[t].propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) {
+            all_host_vis = false;
+            break;
+        }
+    }
+    bool uma = (phys_props_.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU) ||
+               (phys_props_.deviceType == VK_PHYSICAL_DEVICE_TYPE_CPU) || all_host_vis;
+
+    caps_ = GpuCaps{};
+    caps_.adapter_name = phys_props_.deviceName;
+    caps_.vendor_id = phys_props_.vendorID;
+    caps_.device_id = phys_props_.deviceID;
+    caps_.subsys_id = 0;
+    caps_.revision = phys_props_.driverVersion;
+    caps_.dedicated_vram = sel.vram;
+    caps_.shared_mem = shared_mem;
+    caps_.uma = uma;
+    caps_.cache_coherent_uma = uma;
+    caps_.max_feature_level = phys_props_.apiVersion;
+    caps_.max_shader_model = 0x65;
+    caps_.allow_tearing = has_immediate_;
+
+    uint64_t total_ram = TotalSystemRamBytes();
+    total_sys_mem_ = total_ram;
+    if (caps_.uma && total_ram >= (11ull << 30)) {
+        upload_size_ = 32ull << 20;
+        upload_reserve_ = 4ull << 20;
+    } else if (caps_.uma || caps_.dedicated_vram < (3ull << 30) || total_ram <= (8704ull << 20)) {
+        upload_size_ = 16ull << 20;
+        upload_reserve_ = 2ull << 20;
+    } else if (caps_.dedicated_vram < (6ull << 30)) {
+        upload_size_ = 32ull << 20;
+        upload_reserve_ = 4ull << 20;
+    } else {
+        upload_size_ = 64ull << 20;
+        upload_reserve_ = 8ull << 20;
+    }
+    caps_.upload_ring_bytes = upload_size_;
+    {
+        std::lock_guard<std::mutex> lock(g_caps_lock);
+        g_gpu_caps = caps_;
+    }
+
+    LOGR("Vulkan adapter: %s (VID=0x%04X DID=0x%04X VRAM=%llu MiB UMA=%s SW=%s Immediate=%s Mailbox=%s)",
+         caps_.adapter_name.c_str(), caps_.vendor_id, caps_.device_id,
+         (unsigned long long)(caps_.dedicated_vram >> 20), caps_.uma ? "true" : "false", sel.is_sw ? "true" : "false",
+         has_immediate_ ? "true" : "false", has_mailbox_ ? "true" : "false");
+    return true;
+}
+
+bool VulkanBackend::CreateSwapchain(uint32_t w, uint32_t h) {
+    VkSurfaceCapabilitiesKHR caps{};
+    if (vk_.get_surf_caps(phys_, surface_, &caps) != VK_SUCCESS) return false;
+
+    uint32_t fmt_count = 0;
+    vk_.get_surf_fmts(phys_, surface_, &fmt_count, nullptr);
+    std::vector<VkSurfaceFormatKHR> fmts(fmt_count);
+    vk_.get_surf_fmts(phys_, surface_, &fmt_count, fmts.data());
+    if (fmts.empty()) return false;
+
+    VkSurfaceFormatKHR chosen_fmt = fmts[0];
+    for (const auto& f : fmts) {
+        if (f.format == VK_FORMAT_B8G8R8A8_UNORM && f.colorSpace == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR) {
+            chosen_fmt = f;
+            break;
+        }
+    }
+    if (chosen_fmt.format != VK_FORMAT_B8G8R8A8_UNORM) {
+        for (const auto& f : fmts) {
+            if (f.format == VK_FORMAT_R8G8B8A8_UNORM && f.colorSpace == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR) {
+                chosen_fmt = f;
+                break;
+            }
+        }
+    }
+
+    // Choose present mode from settings
+    const app::Settings& cfg = app::Get();
+    last_present_mode_req_ = cfg.present_mode;
+    last_fps_cap_req_ = cfg.fps_cap;
+    uint32_t hz = app::DisplayRefreshHz();
+    last_display_hz_ = hz;
+    uint32_t cap = cfg.fps_cap == app::kFpsCapRefresh ? hz : cfg.fps_cap;
+    VkPresentModeKHR pm = VK_PRESENT_MODE_FIFO_KHR;
+    switch (cfg.present_mode) {
+        case app::PresentMode::VSync:
+            if (cap > 0 && hz > 0 && std::fabs(double(hz) - double(cap)) > 1.5 && has_mailbox_) {
+                pm = VK_PRESENT_MODE_MAILBOX_KHR;
+            } else {
+                pm = VK_PRESENT_MODE_FIFO_KHR;
+            }
+            break;
+        case app::PresentMode::VrrAllowTearing:
+            pm = has_immediate_ ? VK_PRESENT_MODE_IMMEDIATE_KHR
+                                : (has_mailbox_ ? VK_PRESENT_MODE_MAILBOX_KHR : VK_PRESENT_MODE_FIFO_KHR);
+            break;
+        case app::PresentMode::TearFreeMailbox:
+            pm = has_mailbox_ ? VK_PRESENT_MODE_MAILBOX_KHR : VK_PRESENT_MODE_FIFO_KHR;
+            break;
+        case app::PresentMode::Auto:
+        default: {
+            bool match_hz = (cap > 0 && hz > 0 && std::fabs(double(hz) - double(cap)) <= 1.5);
+            if (match_hz) pm = VK_PRESENT_MODE_FIFO_KHR;
+            else if (has_mailbox_) pm = VK_PRESENT_MODE_MAILBOX_KHR;
+            else if (has_immediate_) pm = VK_PRESENT_MODE_IMMEDIATE_KHR;
+            else pm = VK_PRESENT_MODE_FIFO_KHR;
+            break;
+        }
+    }
+    active_present_mode_ = pm;
+
+    VkExtent2D extent{};
+    if (caps.currentExtent.width != UINT32_MAX && caps.currentExtent.width > 0 && caps.currentExtent.height > 0) {
+        extent = caps.currentExtent;
+    } else {
+        extent.width = std::clamp(w, caps.minImageExtent.width, caps.maxImageExtent.width);
+        extent.height = std::clamp(h, caps.minImageExtent.height, caps.maxImageExtent.height);
+    }
+    if (extent.width == 0 || extent.height == 0) return false;
+
+    uint32_t img_count = std::max(uint32_t(kFrames), caps.minImageCount);
+    if (caps.maxImageCount > 0 && img_count > caps.maxImageCount) img_count = caps.maxImageCount;
+
+    VkImageUsageFlags usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    if (caps.supportedUsageFlags & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) usage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+
+    VkSwapchainCreateInfoKHR sci{VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR};
+    sci.surface = surface_;
+    sci.minImageCount = img_count;
+    sci.imageFormat = chosen_fmt.format;
+    sci.imageColorSpace = chosen_fmt.colorSpace;
+    sci.imageExtent = extent;
+    sci.imageArrayLayers = 1;
+    sci.imageUsage = usage;
+    sci.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    sci.preTransform = caps.currentTransform;
+    sci.compositeAlpha = (caps.supportedCompositeAlpha & VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR)
+                             ? VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR
+                             : VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR;
+    sci.presentMode = pm;
+    sci.clipped = VK_TRUE;
+    sci.oldSwapchain = swapchain_;
+
+    VkSwapchainKHR new_sc = VK_NULL_HANDLE;
+    if (vk_.create_swapchain(dev_, &sci, nullptr, &new_sc) != VK_SUCCESS) {
+        LOGE("vulkan: vkCreateSwapchainKHR(%ux%u) failed", extent.width, extent.height);
+        return false;
+    }
+    DestroySwapchain();
+    swapchain_ = new_sc;
+    swap_fmt_ = chosen_fmt.format;
+    bb_w_ = extent.width;
+    bb_h_ = extent.height;
+
+    if (present_rp_ != VK_NULL_HANDLE) {
+        vk_.destroy_rp(dev_, present_rp_, nullptr);
+        present_rp_ = VK_NULL_HANDLE;
+    }
+    {
+        VkAttachmentDescription att{};
+        att.format = swap_fmt_;
+        att.samples = VK_SAMPLE_COUNT_1_BIT;
+        att.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        att.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        att.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        att.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+        att.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        att.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        VkAttachmentReference ref{0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+        VkSubpassDescription sub{};
+        sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+        sub.colorAttachmentCount = 1;
+        sub.pColorAttachments = &ref;
+        // Upscaling, fallback blits, and UI can each load/write this attachment in
+        // separate passes without changing its layout. Preserve their memory dependency.
+        VkSubpassDependency dep{};
+        dep.srcSubpass = VK_SUBPASS_EXTERNAL;
+        dep.dstSubpass = 0;
+        dep.srcStageMask = dep.dstStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+        dep.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+        dep.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+        dep.dependencyFlags = VK_DEPENDENCY_BY_REGION_BIT;
+        VkRenderPassCreateInfo rpi{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+        rpi.attachmentCount = 1;
+        rpi.pAttachments = &att;
+        rpi.subpassCount = 1;
+        rpi.pSubpasses = &sub;
+        rpi.dependencyCount = 1;
+        rpi.pDependencies = &dep;
+        if (vk_.create_rp(dev_, &rpi, nullptr, &present_rp_) != VK_SUCCESS) return false;
+    }
+
+    uint32_t sc_cnt = 0;
+    vk_.get_swapchain_images(dev_, swapchain_, &sc_cnt, nullptr);
+    swap_images_.resize(sc_cnt);
+    vk_.get_swapchain_images(dev_, swapchain_, &sc_cnt, swap_images_.data());
+    swap_views_.resize(sc_cnt, VK_NULL_HANDLE);
+    swap_fbs_.resize(sc_cnt, VK_NULL_HANDLE);
+    render_done_sems_.resize(sc_cnt, VK_NULL_HANDLE);
+    for (uint32_t i = 0; i < sc_cnt; ++i) {
+        swap_views_[i] = CreateImageView(swap_images_[i], VK_IMAGE_VIEW_TYPE_2D, swap_fmt_, VK_IMAGE_ASPECT_COLOR_BIT);
+        VkFramebufferCreateInfo fbi{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+        fbi.renderPass = present_rp_;
+        fbi.attachmentCount = 1;
+        fbi.pAttachments = &swap_views_[i];
+        fbi.width = bb_w_;
+        fbi.height = bb_h_;
+        fbi.layers = 1;
+        if (vk_.create_fb(dev_, &fbi, nullptr, &swap_fbs_[i]) != VK_SUCCESS) return false;
+        VkSemaphoreCreateInfo smi{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+        if (vk_.create_sem(dev_, &smi, nullptr, &render_done_sems_[i]) != VK_SUCCESS) return false;
+    }
+    swapchain_dirty_ = false;
+    return true;
+}
+
+void VulkanBackend::DestroySwapchain() {
+    for (auto s : render_done_sems_)
+        if (s != VK_NULL_HANDLE) vk_.destroy_sem(dev_, s, nullptr);
+    render_done_sems_.clear();
+    for (auto fb : swap_fbs_)
+        if (fb != VK_NULL_HANDLE) vk_.destroy_fb(dev_, fb, nullptr);
+    swap_fbs_.clear();
+    for (auto v : swap_views_)
+        if (v != VK_NULL_HANDLE) vk_.destroy_img_view(dev_, v, nullptr);
+    swap_views_.clear();
+    swap_images_.clear();
+    if (swapchain_ != VK_NULL_HANDLE) {
+        vk_.destroy_swapchain(dev_, swapchain_, nullptr);
+        swapchain_ = VK_NULL_HANDLE;
+    }
+}
+
+bool VulkanBackend::CreatePipelineLayout() {
+    // Set 0: b0..b1 (dynamic UBOs 0..1), t0..t3 (sampled images 4..7), s0..s3 (samplers 12..15)
+    VkDescriptorSetLayoutBinding b[10]{};
+    b[0] = {0, VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC, 1, VK_SHADER_STAGE_ALL_GRAPHICS, nullptr};
+    b[1] = {1, VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC, 1, VK_SHADER_STAGE_ALL_GRAPHICS, nullptr};
+    for (uint32_t i = 0; i < 4; ++i)
+        b[2 + i] = {4 + i, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1, VK_SHADER_STAGE_FRAGMENT_BIT, nullptr};
+    for (uint32_t i = 0; i < 4; ++i)
+        b[6 + i] = {12 + i, VK_DESCRIPTOR_TYPE_SAMPLER, 1, VK_SHADER_STAGE_FRAGMENT_BIT, nullptr};
+
+    VkDescriptorSetLayoutCreateInfo dci{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    dci.bindingCount = 10;
+    dci.pBindings = b;
+    if (vk_.create_dsl(dev_, &dci, nullptr, &gfx_dsl_) != VK_SUCCESS) return false;
+
+    VkPipelineLayoutCreateInfo plci{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    plci.setLayoutCount = 1;
+    plci.pSetLayouts = &gfx_dsl_;
+    return vk_.create_pipe_layout(dev_, &plci, nullptr, &gfx_layout_) == VK_SUCCESS;
+}
+
+uint32_t VulkanBackend::FindMemoryType(uint32_t type_bits, VkMemoryPropertyFlags props) const {
+    for (uint32_t i = 0; i < mem_props_.memoryTypeCount; ++i) {
+        if ((type_bits & (1u << i)) && (mem_props_.memoryTypes[i].propertyFlags & props) == props) return i;
+    }
+    return ~0u;
+}
+
+bool VulkanBackend::CreateBuffer(VkDeviceSize size, VkBufferUsageFlags usage, VkMemoryPropertyFlags props,
+                                 VkBuffer& buf, VkDeviceMemory& mem, uint8_t** mapped, bool* coherent) {
+    VkBufferCreateInfo bci{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+    bci.size = size;
+    bci.usage = usage;
+    bci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (vk_.create_buf(dev_, &bci, nullptr, &buf) != VK_SUCCESS) return false;
+    VkMemoryRequirements mr{};
+    vk_.get_buf_mem_req(dev_, buf, &mr);
+    uint32_t mt = FindMemoryType(mr.memoryTypeBits, props);
+    if (mt == ~0u && (props & VK_MEMORY_PROPERTY_HOST_CACHED_BIT)) {
+        mt = FindMemoryType(mr.memoryTypeBits, props & ~VK_MEMORY_PROPERTY_HOST_CACHED_BIT);
+    }
+    if (mt == ~0u && (props & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) {
+        mt = FindMemoryType(mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT);
+    }
+    if (mt == ~0u) {
+        vk_.destroy_buf(dev_, buf, nullptr);
+        buf = VK_NULL_HANDLE;
+        return false;
+    }
+    VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    ai.allocationSize = mr.size;
+    ai.memoryTypeIndex = mt;
+    if (vk_.alloc_mem(dev_, &ai, nullptr, &mem) != VK_SUCCESS || vk_.bind_buf_mem(dev_, buf, mem, 0) != VK_SUCCESS) {
+        vk_.destroy_buf(dev_, buf, nullptr);
+        if (mem != VK_NULL_HANDLE) vk_.free_mem(dev_, mem, nullptr);
+        buf = VK_NULL_HANDLE;
+        mem = VK_NULL_HANDLE;
+        return false;
+    }
+    if (coherent) *coherent = (mem_props_.memoryTypes[mt].propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) != 0;
+    if (mapped) {
+        void* p = nullptr;
+        if (vk_.map_mem(dev_, mem, 0, VK_WHOLE_SIZE, 0, &p) != VK_SUCCESS || !p) return false;
+        *mapped = static_cast<uint8_t*>(p);
+    }
+    return true;
+}
+
+bool VulkanBackend::CreateImage(uint32_t w, uint32_t h, uint32_t depth, uint32_t layers, uint32_t mips, VkFormat fmt,
+                                VkImageType type, VkImageCreateFlags flags, VkImageUsageFlags usage, VkImage& img,
+                                VkDeviceMemory& mem) {
+    VkImageCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    ci.flags = flags;
+    ci.imageType = type;
+    ci.format = fmt;
+    ci.extent = {std::max(w, 1u), std::max(h, 1u), std::max(depth, 1u)};
+    ci.mipLevels = std::max(mips, 1u);
+    ci.arrayLayers = std::max(layers, 1u);
+    ci.samples = VK_SAMPLE_COUNT_1_BIT;
+    ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ci.usage = usage;
+    ci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    ci.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (vk_.create_img(dev_, &ci, nullptr, &img) != VK_SUCCESS) return false;
+
+    VkMemoryRequirements mr{};
+    vk_.get_img_mem_req(dev_, img, &mr);
+    uint32_t mt = FindMemoryType(mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (mt == ~0u) mt = FindMemoryType(mr.memoryTypeBits, 0);
+    if (mt == ~0u) {
+        vk_.destroy_img(dev_, img, nullptr);
+        img = VK_NULL_HANDLE;
+        return false;
+    }
+    VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    ai.allocationSize = mr.size;
+    ai.memoryTypeIndex = mt;
+    if (vk_.alloc_mem(dev_, &ai, nullptr, &mem) != VK_SUCCESS || vk_.bind_img_mem(dev_, img, mem, 0) != VK_SUCCESS) {
+        vk_.destroy_img(dev_, img, nullptr);
+        if (mem != VK_NULL_HANDLE) vk_.free_mem(dev_, mem, nullptr);
+        img = VK_NULL_HANDLE;
+        mem = VK_NULL_HANDLE;
+        return false;
+    }
+    return true;
+}
+
+bool VulkanBackend::AllocTexSlab(uint32_t mem_type, VkDeviceSize size, VkDeviceSize align, uint32_t& out_slab,
+                                 VkDeviceSize& out_off) {
+    if (size == 0 || size > kVkTexSlabMaxAlloc) return false;
+    align = std::max<VkDeviceSize>(align, 256);
+    for (uint32_t si = 0; si < tex_slabs_.size(); ++si) {
+        if (tex_slabs_[si].mem_type != mem_type) continue;
+        auto& fl = tex_slabs_[si].free_list;
+        for (size_t i = 0; i < fl.size(); ++i) {
+            VkDeviceSize aligned = (fl[i].off + align - 1) & ~(align - 1);
+            VkDeviceSize pad = aligned - fl[i].off;
+            if (fl[i].size < pad + size) continue;
+            VkDeviceSize tail_off = aligned + size;
+            VkDeviceSize tail_size = (fl[i].off + fl[i].size) - tail_off;
+            if (pad > 0 && tail_size > 0) {
+                fl[i].size = pad;
+                fl.insert(fl.begin() + ptrdiff_t(i + 1), VkSlabFree{tail_off, tail_size});
+            } else if (pad > 0) {
+                fl[i].size = pad;
+            } else if (tail_size > 0) {
+                fl[i].off = tail_off;
+                fl[i].size = tail_size;
+            } else {
+                fl.erase(fl.begin() + ptrdiff_t(i));
+            }
+            out_slab = si;
+            out_off = aligned;
+            return true;
+        }
+    }
+    VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    ai.allocationSize = kVkTexSlabSize;
+    ai.memoryTypeIndex = mem_type;
+    VkDeviceMemory mem = VK_NULL_HANDLE;
+    if (vk_.alloc_mem(dev_, &ai, nullptr, &mem) != VK_SUCCESS || mem == VK_NULL_HANDLE) return false;
+    uint32_t si = uint32_t(tex_slabs_.size());
+    VkTexSlab slab;
+    slab.mem = mem;
+    slab.mem_type = mem_type;
+    if (kVkTexSlabSize > size) slab.free_list.push_back(VkSlabFree{size, kVkTexSlabSize - size});
+    tex_slabs_.push_back(std::move(slab));
+    out_slab = si;
+    out_off = 0;
+    return true;
+}
+
+void VulkanBackend::FreeSlabRange(uint32_t slab, VkDeviceSize off, VkDeviceSize size) {
+    if (slab >= tex_slabs_.size() || size == 0) return;
+    auto& fl = tex_slabs_[slab].free_list;
+    auto it = std::lower_bound(fl.begin(), fl.end(), off,
+                               [](const VkSlabFree& a, VkDeviceSize b) { return a.off < b; });
+    it = fl.insert(it, VkSlabFree{off, size});
+    if (it + 1 != fl.end() && it->off + it->size == (it + 1)->off) {
+        it->size += (it + 1)->size;
+        fl.erase(it + 1);
+    }
+    if (it != fl.begin()) {
+        auto prev = it - 1;
+        if (prev->off + prev->size == it->off) {
+            prev->size += it->size;
+            fl.erase(it);
+        }
+    }
+}
+
+bool VulkanBackend::CreateTexImage(uint32_t w, uint32_t h, uint32_t depth, uint32_t layers, uint32_t mips, VkFormat fmt,
+                                   VkImageType type, VkImageCreateFlags flags, VkImageUsageFlags usage, Tex& tx) {
+    VkImageCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    ci.flags = flags;
+    ci.imageType = type;
+    ci.format = fmt;
+    ci.extent = {std::max(w, 1u), std::max(h, 1u), std::max(depth, 1u)};
+    ci.mipLevels = std::max(mips, 1u);
+    ci.arrayLayers = std::max(layers, 1u);
+    ci.samples = VK_SAMPLE_COUNT_1_BIT;
+    ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ci.usage = usage;
+    ci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    ci.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (vk_.create_img(dev_, &ci, nullptr, &tx.img) != VK_SUCCESS) return false;
+
+    VkMemoryRequirements mr{};
+    vk_.get_img_mem_req(dev_, tx.img, &mr);
+    uint32_t mt = FindMemoryType(mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (mt == ~0u) mt = FindMemoryType(mr.memoryTypeBits, 0);
+    if (mt == ~0u) {
+        vk_.destroy_img(dev_, tx.img, nullptr);
+        tx.img = VK_NULL_HANDLE;
+        return false;
+    }
+    if (mr.size > 0 && mr.size <= kVkTexSlabMaxAlloc) {
+        uint32_t slab_id = UINT32_MAX;
+        VkDeviceSize slab_off = 0;
+        if (AllocTexSlab(mt, mr.size, mr.alignment, slab_id, slab_off)) {
+            if (vk_.bind_img_mem(dev_, tx.img, tex_slabs_[slab_id].mem, slab_off) == VK_SUCCESS) {
+                tx.slab_id = slab_id;
+                tx.slab_off = slab_off;
+                tx.slab_size = mr.size;
+                tx.needs_aliasing_barrier = true;
+                tx.mem = VK_NULL_HANDLE;
+                return true;
+            }
+            FreeSlabRange(slab_id, slab_off, mr.size);
+        }
+    }
+    VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    ai.allocationSize = mr.size;
+    ai.memoryTypeIndex = mt;
+    if (vk_.alloc_mem(dev_, &ai, nullptr, &tx.mem) != VK_SUCCESS ||
+        vk_.bind_img_mem(dev_, tx.img, tx.mem, 0) != VK_SUCCESS) {
+        vk_.destroy_img(dev_, tx.img, nullptr);
+        if (tx.mem != VK_NULL_HANDLE) vk_.free_mem(dev_, tx.mem, nullptr);
+        tx.img = VK_NULL_HANDLE;
+        tx.mem = VK_NULL_HANDLE;
+        return false;
+    }
+    return true;
+}
+
+void VulkanBackend::RetireTex(Tex& tx) {
+    if (tx.img != VK_NULL_HANDLE || tx.view != VK_NULL_HANDLE || tx.mem != VK_NULL_HANDLE || tx.slab_id != UINT32_MAX) {
+        CurrentFrame().garbage.push_back(
+            DeferredDestroy{tx.img, tx.view, VK_NULL_HANDLE, tx.mem, VK_NULL_HANDLE, tx.slab_id, tx.slab_off, tx.slab_size});
+        tx.img = VK_NULL_HANDLE;
+        tx.view = VK_NULL_HANDLE;
+        tx.mem = VK_NULL_HANDLE;
+        tx.slab_id = UINT32_MAX;
+        tx.slab_off = 0;
+        tx.slab_size = 0;
+    }
+}
