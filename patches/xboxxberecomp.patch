+std::string OsVersion() {
+    std::string distro = "Linux";
+    if (std::ifstream f("/etc/os-release"); f) {
+        std::string line;
+        while (std::getline(f, line)) {
+            if (line.rfind("PRETTY_NAME=", 0) == 0) {
+                distro = line.substr(12);
+                if (distro.size() >= 2 && distro.front() == '"' && distro.back() == '"')
+                    distro = distro.substr(1, distro.size() - 2);
+                break;
+            }
+        }
+    }
+    utsname un{};
+    if (uname(&un) == 0) {
+        distro += std::string(" (") + un.sysname + " " + un.release + " " + un.machine + ")";
+    }
+    if (const char* deck = std::getenv("SteamDeck"); deck && std::strcmp(deck, "1") == 0) distro += " [Steam Deck]";
+    if (std::getenv("GAMESCOPE_WAYLAND_DISPLAY")) distro += " [Gamescope]";
+    return distro;
+}
