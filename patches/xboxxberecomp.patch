+void D3D12Backend::PrewarmBuiltinPipelines() {
+    if (!dev_ || !root_) return;
+    EnsureBlitPipeline(DXGI_FORMAT_B8G8R8A8_UNORM, false);
+    EnsureBlitPipeline(DXGI_FORMAT_B8G8R8A8_UNORM, true);
+    EnsureBlitPipeline(DXGI_FORMAT_R8G8B8A8_UNORM, false);
+    EnsureBlitPipeline(DXGI_FORMAT_R8G8B8A8_UNORM, true);
+    EnsureDepthCopyPipeline();
+    for (uint8_t mask : {uint8_t(0x7), uint8_t(0x8), uint8_t(0x1), uint8_t(0x2), uint8_t(0x4)}) {
+        EnsureClearPipeline(DXGI_FORMAT_B8G8R8A8_UNORM, mask);
+    }
+    uint64_t gh = 0;
+    Compile(PointHlsl(), "main", "gs_5_0", gh);
+    Compile(SpriteHlsl(), "main", "gs_5_0", gh);
+}
