+uint32_t SelectGuestCoreCpu() {
+    static std::once_flag once;
+    static uint32_t cached_cpu = 0;
+    std::call_once(once, [] {
+        cpu_set_t proc_set;
+        CPU_ZERO(&proc_set);
+        if (sched_getaffinity(0, sizeof(proc_set), &proc_set) != 0) {
+            cached_cpu = 0;
+            app::SetGuestCoreInfo(0, 1ull);
+            LOGR("threads: single_core_guest pinned to fallback logical CPU 0 (mask 0x1)");
+            return;
+        }
+        struct Cand {
+            uint32_t cpu = 0;
+            uint64_t max_freq = 0;
+            bool shares_cpu0 = false;
+        };
+        std::vector<Cand> cands;
+        for (uint32_t c = 0; c < CPU_SETSIZE; ++c) {
+            if (!CPU_ISSET(c, &proc_set)) continue;
+            Cand item;
+            item.cpu = c;
+            item.shares_cpu0 = (c == 0);
+            char path[128];
+            std::snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%u/topology/thread_siblings_list", c);
+            if (std::ifstream f(path); f) {
+                std::string line;
+                if (std::getline(f, line) && SiblingListContainsZero(line)) item.shares_cpu0 = true;
+            }
+            std::snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%u/cpufreq/cpuinfo_max_freq", c);
+            if (std::ifstream f(path); f) {
+                f >> item.max_freq;
+            }
+            cands.push_back(item);
+        }
+        if (cands.empty()) {
+            cached_cpu = 0;
+            app::SetGuestCoreInfo(0, 1ull);
+            return;
+        }
+        uint64_t best_freq = 0;
+        for (const Cand& c : cands) best_freq = std::max(best_freq, c.max_freq);
+        std::vector<Cand> top;
+        for (const Cand& c : cands)
+            if (c.max_freq == best_freq) top.push_back(c);
+        bool has_non_cpu0 = false;
+        for (const Cand& c : top)
+            if (!c.shares_cpu0) has_non_cpu0 = true;
+        uint32_t chosen = top.front().cpu;
+        for (const Cand& c : top) {
+            if (has_non_cpu0 && c.shares_cpu0) continue;
+            chosen = c.cpu;
+            break;
+        }
+        cached_cpu = chosen;
+        uint64_t mask = chosen < 64 ? (1ull << chosen) : 0ull;
+        app::SetGuestCoreInfo(chosen, mask);
+        LOGR("threads: single_core_guest pinned to logical CPU %u (mask 0x%llX, max_freq=%llu kHz)",
+             chosen, (unsigned long long)mask, (unsigned long long)best_freq);
+    });
+    return cached_cpu;
+}
