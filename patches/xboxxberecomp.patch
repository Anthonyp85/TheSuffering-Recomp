+bool NoShaderCacheFlag() {
+    if (const char* v = std::getenv("XBE_NO_SHADER_CACHE"); v && *v && std::atoi(v) != 0) return true;
+    for (const auto& a : ReadProcCmdline()) {
+        if (a == "--no-shader-cache") return true;
+    }
+    return false;
+}
