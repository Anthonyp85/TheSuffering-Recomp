+std::string ExtractTitleName(const xbe::Image& img) {
+    if (img.cert < img.base) return {};
+    size_t off = size_t(img.cert - img.base) + 0x0C;
+    if (off + 80 > img.file.size()) return {};
+    std::wstring w;
+    for (size_t i = 0; i < 40; ++i) {
+        uint16_t ch = 0;
+        std::memcpy(&ch, img.file.data() + off + i * 2, 2);
+        if (ch == 0) break;
+        if (ch >= 0x20 && ch != 0x7F) w.push_back(wchar_t(ch));
+    }
+    return WideToUtf8(w);
+}
