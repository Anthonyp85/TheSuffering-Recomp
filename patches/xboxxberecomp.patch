+LinuxMemInfo QueryLinuxMem() {
+    LinuxMemInfo m{};
+    if (std::ifstream f("/proc/self/status"); f) {
+        std::string line;
+        while (std::getline(f, line)) {
+            uint64_t kb = 0;
+            if (line.rfind("VmRSS:", 0) == 0 && std::sscanf(line.c_str() + 6, "%llu", (unsigned long long*)&kb) == 1)
+                m.rss = kb * 1024ull;
+            else if (line.rfind("VmHWM:", 0) == 0 && std::sscanf(line.c_str() + 6, "%llu", (unsigned long long*)&kb) == 1)
+                m.hwm = kb * 1024ull;
+            else if (line.rfind("RssAnon:", 0) == 0 && std::sscanf(line.c_str() + 8, "%llu", (unsigned long long*)&kb) == 1)
+                m.priv = kb * 1024ull;
+        }
+    }
+    rusage ru{};
+    if (getrusage(RUSAGE_SELF, &ru) == 0) {
+        m.page_faults = uint64_t(ru.ru_minflt + ru.ru_majflt);
+        if (!m.hwm && ru.ru_maxrss > 0) m.hwm = uint64_t(ru.ru_maxrss) * 1024ull;
+    }
+    if (!m.priv) m.priv = m.rss;
+    return m;
+}
