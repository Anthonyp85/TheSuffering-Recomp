+    if (FAILED(hr) || !dlg) return false;
+    DWORD opts = 0;
+    if (SUCCEEDED(dlg->GetOptions(&opts))) {
+        dlg->SetOptions(opts | FOS_FILEMUSTEXIST | FOS_PATHMUSTEXIST | FOS_FORCEFILESYSTEM | FOS_NOCHANGEDIR);
+    }
+    const COMDLG_FILTERSPEC filters[] = {
+        {L"Xbox Disc Images (*.xiso.iso; *.iso)", L"*.xiso.iso;*.iso"},
+        {L"All Files (*.*)", L"*.*"},
+    };
+    dlg->SetFileTypes(2, filters);
+    dlg->SetFileTypeIndex(1);
+    std::wstring title = std::wstring(L"Select ") + kGame.title + L" Xbox Disc Image (.xiso.iso / .iso)";
+    dlg->SetTitle(title.c_str());
