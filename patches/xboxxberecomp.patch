+// Persistent on-disk DXBC shader cache (cache/shaders.bin) and D3D12 pipeline library cache (cache/psos.bin)
+namespace {
+
+struct ShaderCacheHeader {
+    char magic[4];
+    uint32_t version;
+    uint32_t ptr_size;
+    uint32_t reserved;
+};
+
+struct PsoCacheHeader {
+    char magic[4];
+    uint32_t version;
+    uint32_t vendor_id;
+    uint32_t device_id;
+    uint32_t subsys_id;
+    uint32_t revision;
+    uint32_t blob_size;
+    uint32_t reserved;
+};
+
+struct PsoMetaHeader {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t sizeof_pso_key;
+    uint32_t vendor_id;
+    uint32_t device_id;
+    uint32_t subsys_id;
+    uint32_t revision;
+    uint32_t src_count;
+    uint32_t pso_count;
+    uint32_t reserved;
+};
+
+constexpr uint32_t kPsoMetaMagic = 0x50534F4Du;
+constexpr uint32_t kPsoMetaVersion = 2u;
+constexpr uint32_t kRecipeCacheMagic = 0x43524258u;  // 'XBRC'
+constexpr uint32_t kRecipeCacheVersion = 2u;
+constexpr uint64_t kTexSlabSize = 32ull << 20;
+constexpr uint64_t kTexSlabMaxAlloc = 8ull << 20;
+
+struct RecipeCacheHeader {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t sizeof_fixed_vs;
+    uint32_t sizeof_pixel_ps;
+    uint32_t fixed_vs_count;
+    uint32_t pixel_ps_count;
+};
+
+uint64_t NowMonoMs() {
+    return uint64_t(
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch())
+            .count());
+}
+
+void WriteAtomicFile(const std::filesystem::path& dst, const std::vector<uint8_t>& bytes) {
+    if (bytes.empty()) return;
+    std::filesystem::path tmp = dst;
+    tmp += ".tmp";
+    if (FILE* f = _wfopen(tmp.c_str(), L"wb")) {
+        bool ok = std::fwrite(bytes.data(), 1, bytes.size(), f) == bytes.size();
+        std::fflush(f);
+        std::fclose(f);
+        if (ok) MoveFileExW(tmp.c_str(), dst.c_str(), MOVEFILE_REPLACE_EXISTING);
+    }
+}
+
+bool NoShaderCacheFlag() {
+    if (const wchar_t* v = _wgetenv(L"XBE_NO_SHADER_CACHE"); v && *v && _wtoi(v) != 0) return true;
+    const wchar_t* cmd = GetCommandLineW();
+    return cmd && std::wcsstr(cmd, L"--no-shader-cache") != nullptr;
+}
+
+std::atomic<bool> g_cache_enabled_stat{false};
+std::atomic<uint32_t> g_cache_shaders_stat{0};
+std::atomic<uint32_t> g_cache_psos_stat{0};
+std::atomic<uint64_t> g_cache_bytes_stat{0};
+std::atomic<bool> g_cache_reset_requested{false};
+
+std::atomic<bool> g_warmup_active{false};
+std::atomic<bool> g_warmup_completed{false};
+std::atomic<uint32_t> g_warmup_done{0};
+std::atomic<uint32_t> g_warmup_total{0};
+std::atomic<uint32_t> g_warmup_compiled_new{0};
+std::atomic<uint64_t> g_warmup_elapsed_us{0};
+std::atomic<uint64_t> g_warmup_completed_ms{0};
+
+std::mutex g_bb_cap_lock;
+std::filesystem::path g_bb_cap_path;
+
+bool TakeBackbufferCapture(std::filesystem::path& out) {
+    std::lock_guard<std::mutex> lock(g_bb_cap_lock);
+    if (g_bb_cap_path.empty()) return false;
+    out = std::move(g_bb_cap_path);
+    g_bb_cap_path.clear();
+    return true;
+}
+
+bool WriteBmp32(const std::filesystem::path& path, uint32_t w, uint32_t h, const std::vector<uint8_t>& px) {
+    if (!w || !h || px.size() < size_t(w) * h * 4) return false;
+    std::error_code ec;
+    if (path.has_parent_path()) std::filesystem::create_directories(path.parent_path(), ec);
+    FILE* f = _wfopen(path.c_str(), L"wb");
+    if (!f) return false;
+    uint8_t hd[54] = {'B', 'M'};
+    auto put = [&](int o, uint32_t v) { std::memcpy(hd + o, &v, 4); };
+    uint32_t img_bytes = uint32_t(size_t(w) * h * 4);
+    put(2, 54u + img_bytes);
+    put(10, 54u);
+    put(14, 40u);
+    put(18, w);
+    put(22, uint32_t(-int32_t(h)));
+    hd[26] = 1;
+    hd[28] = 32;
+    put(34, img_bytes);
+    bool ok = std::fwrite(hd, 1, 54, f) == 54 && std::fwrite(px.data(), 1, img_bytes, f) == img_bytes;
+    std::fclose(f);
+    return ok;
+}
