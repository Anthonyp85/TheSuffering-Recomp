+void Pace() {
+    using clock = std::chrono::steady_clock;
+    auto pace_t0 = perf::Enabled() ? clock::now() : clock::time_point{};
+    static clock::time_point next = clock::now();
+    static clock::time_point last_exit = next;
+    static uint64_t frac_rem = 0;
+    static uint32_t last_cap = 0;
+    uint32_t cap = Get().fps_cap;
+    if (cap == kFpsCapRefresh) cap = RefreshRate();
+    auto now = clock::now();
+    if (!cap) {
+        next = now;
+        last_exit = now;
+        frac_rem = 0;
+        last_cap = 0;
+        kernel::NotifyGuestFrameProgress();
+        return;
+    }
+    if (cap != last_cap) {
+        last_cap = cap;
+        frac_rem = 0;
+        next = now;
+    }
+    uint64_t num = 1000000000ull + frac_rem;
+    uint64_t period_ns = num / cap;
+    frac_rem = num % cap;
+    auto period = std::chrono::nanoseconds(period_ns);
+    auto sleep_until = [&](clock::time_point target) {
+        auto rem = target - clock::now();
+        if (rem > std::chrono::microseconds(1200)) {
+            auto sleep_ns =
+                std::chrono::duration_cast<std::chrono::nanoseconds>(rem - std::chrono::microseconds(1000)).count();
+            if (sleep_ns > 0) {
+                struct timespec ts{};
+                if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0) {
+                    uint64_t target_ns =
+                        uint64_t(ts.tv_sec) * 1000000000ull + uint64_t(ts.tv_nsec) + uint64_t(sleep_ns);
+                    ts.tv_sec = time_t(target_ns / 1000000000ull);
+                    ts.tv_nsec = long(target_ns % 1000000000ull);
+                    while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, nullptr) == EINTR) {
+                    }
+                }
+            }
+        }
+        if (kGame.single_core_guest) {
+            while (clock::now() + std::chrono::microseconds(50) < target) {
+                sched_yield();
+            }
+        }
+        while (clock::now() < target) _mm_pause();
+    };
+    if (g_vsync_pacing_active.load(std::memory_order_relaxed) && !IsReplayOrAutotestActive()) {
+        auto floor_target = last_exit + std::chrono::nanoseconds((period_ns * 3ull) / 4ull);
+        if (now < floor_target) sleep_until(floor_target);
+        last_exit = clock::now();
+        next = last_exit;
+        frac_rem = 0;
+        kernel::NotifyGuestFrameProgress();
+        if (perf::Enabled()) {
+            perf::RecordPace(std::chrono::duration<double, std::milli>(last_exit - pace_t0).count());
+        }
+        return;
+    }
+    next += period;
+    if (next < now - period / 4) next = now;
+    if (next > now) sleep_until(next);
+    last_exit = clock::now();
+    kernel::NotifyGuestFrameProgress();
+    if (perf::Enabled()) {
+        perf::RecordPace(std::chrono::duration<double, std::milli>(last_exit - pace_t0).count());
+    }
+}
