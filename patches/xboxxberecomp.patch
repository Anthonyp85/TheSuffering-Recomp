+const char* SignalName(int sig) {
+    switch (sig) {
+        case SIGSEGV: return "SIGSEGV";
+        case SIGBUS: return "SIGBUS";
+        case SIGILL: return "SIGILL";
+        case SIGFPE: return "SIGFPE";
+        case SIGABRT: return "SIGABRT";
+        default: return "SIGNAL";
+    }
+}
+
+void CrashSignalHandler(int sig, siginfo_t* info, void* /*uctx*/) {
+    if (g_in_crash_handler.test_and_set(std::memory_order_acq_rel)) {
+        _exit(128 + sig);
+    }
+
+    uintptr_t fault_addr = info ? reinterpret_cast<uintptr_t>(info->si_addr) : 0;
+    uintptr_t guest_base = reinterpret_cast<uintptr_t>(kernel::g_base);
+    uint64_t guest_off = (guest_base && fault_addr >= guest_base) ? uint64_t(fault_addr - guest_base) : 0;
+
+    if (kernel::Thread* t = kernel::Current(); t && t->ctx) {
+        LOGE("signal %s (%d) addr=%p guest=%08llX on guest thread %X", SignalName(sig), sig,
+             reinterpret_cast<void*>(fault_addr), (unsigned long long)guest_off, t->id);
+        kernel::LogGuestStack(*t->ctx, 256);
+    } else {
+        LOGE("signal %s (%d) addr=%p", SignalName(sig), sig, reinterpret_cast<void*>(fault_addr));
+    }
+
+    std::error_code ec;
+    fs::path dir = ExeDir() / "CrashDumps";
+    fs::create_directories(dir, ec);
+    std::time_t now = std::time(nullptr);
+    std::tm tm_val{};
+    localtime_r(&now, &tm_val);
+    char fname[128];
+    std::string app_name = WideToUtf8(kGame.name);
+    if (app_name.empty()) app_name = "suffering";
+    std::snprintf(fname, sizeof(fname), "%s.%04d.%02d.%02d_%02d.%02d.%02d.crash.log", app_name.c_str(),
+                  tm_val.tm_year + 1900, tm_val.tm_mon + 1, tm_val.tm_mday, tm_val.tm_hour, tm_val.tm_min,
+                  tm_val.tm_sec);
+    fs::path crash_path = dir / fname;
+    int fd = ::open(crash_path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd >= 0) {
+        char hdr[512];
+        int n = std::snprintf(hdr, sizeof(hdr),
+                              "Signal: %s (%d)\nFaultAddr: %p\nGuestBase: %p\nGuestOffset: 0x%08llX\nBacktrace:\n",
+                              SignalName(sig), sig, reinterpret_cast<void*>(fault_addr),
+                              reinterpret_cast<void*>(guest_base), (unsigned long long)guest_off);
+        if (n > 0) (void)::write(fd, hdr, size_t(n));
+        void* frames[64];
+        int nframes = backtrace(frames, 64);
+        if (nframes > 0) backtrace_symbols_fd(frames, nframes, fd);
+        ::close(fd);
+    }
+
+    logx::Flush();
+    ::signal(sig, SIG_DFL);
+    ::raise(sig);
+}
+
+void InstallCrashHandlers() {
+    ::signal(SIGPIPE, SIG_IGN);
+    struct sigaction sa{};
+    sa.sa_sigaction = CrashSignalHandler;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = SA_SIGINFO | SA_RESETHAND;
+    sigaction(SIGSEGV, &sa, nullptr);
+    sigaction(SIGBUS, &sa, nullptr);
+    sigaction(SIGILL, &sa, nullptr);
+    sigaction(SIGFPE, &sa, nullptr);
+    sigaction(SIGABRT, &sa, nullptr);
+}
