+            // Feed ImGui on the main thread under UiLock(), skipping pointer/key events while relative mouse capture is active.
+            bool is_window_ev = (ev.type >= SDL_EVENT_WINDOW_FIRST && ev.type <= SDL_EVENT_WINDOW_LAST);
+            bool rel_mouse = app::g_window && SDL_GetWindowRelativeMouseMode(app::g_window);
+            if (!rel_mouse || is_window_ev) {
