+# XDK 5788 (1.0.5788.1) library data layouts the runtime reads or writes.
+# Every value is binary-verified against The Suffering (USA) default.xbe (XDK 1.0.5788.1, Retail, non-LTCG)
+# at the exact virtual addresses cited below. Identical across all 45/45 keys to XDK 5659 and XDK 5849.
+[layout]
+# D3D8 CDevice, the static device D3D__pDevice (0x216878 -> 0x216880) points at
+CDevice_Push          = 0x0     # D3DDevice_SetTexture 0x208322 reads [ebp+0x0], D3DDevice_SetRenderState_Simple 0x205C30 reads [0x216880]
+CDevice_PushThreshold = 0x4     # D3DDevice_SetTexture 0x208325 compares with [ebp+0x4], D3DDevice_SetRenderState_Simple 0x205C38 compares with [0x216884]
+CDevice_BaseVertex    = 0x1C    # D3DDevice_SetIndices 0x208569 / 0x20857B / 0x20858D stores BaseVertexIndex at [esi+0x1C]
+CDevice_IndexBuffer   = 0x7A0   # D3DDevice_SetIndices 0x20853A reads old [esi+0x7A0], 0x208562 / 0x208574 / 0x208586 stores new
+CDevice_ZScale        = 0x948   # D3DDevice_GetViewportOffsetAndScale 0x205D84 / 0x205D94 scales Z range by [eax+0x948]
+CDevice_SuperSampleX  = 0x95C   # D3DDevice_GetViewportOffsetAndScale 0x205CDE / 0x205D43 scales viewport X by [eax+0x95C]
+CDevice_SuperSampleY  = 0x960   # D3DDevice_GetViewportOffsetAndScale 0x205D00 / 0x205D68 scales viewport Y by [eax+0x960]
+CDevice_Transforms    = 0xC60   # D3DDevice_SetTransform 0x2073F6 copies 16 dwords to [ecx+ebx+0xC60] (type * 64)
+CDevice_Textures      = 0xF88   # D3DDevice_SetTexture 0x2082E0 reads [ebp+esi*4+0xF88], 0x208319 stores [stage]
+CDevice_Palettes      = 0xF98   # D3DDevice_SetPalette 0x20848D reads [esi+edi*4+0xF98], 0x2084C5 stores [stage]
+CDevice_RenderTarget  = 0x1A04  # D3DDevice_GetRenderTarget2 0x207C46 returns [eax+0x1A04]
+CDevice_Depth         = 0x1A08  # D3DDevice_GetDepthStencilSurface2 0x207C66 returns [eax+0x1A08], StencilEnable 0x206F68 reads [esi+0x1A08]
+CDevice_BackBuffer    = 0x1A14  # D3DDevice_GetBackBuffer2 0x207BF0 returns [ecx+0x1A14] for index 0
+CDevice_FrontBuffer   = 0x1A18  # D3DDevice_GetBackBuffer2 0x207BF0 returns [ecx+4+0x1A14] for index -1, GetDisplayMode 0x207787 reads [esi+0x1A18]
+CDevice_SwapCount     = 0x2478  # D3DDevice_Swap 0x20ADC0 increments [esi+0x2478], 0x20ADFB returns it
+CDevice_Size          = 0x24A0  # Direct3D_CreateDevice 0x209E9B clears 0x928 dwords (0x928 * 4 = 0x24A0) on failure
+CDevice_Flags             = 0x8    # Direct3D_CreateDevice 0x209E73 ORs BehaviorFlags & 0x10 into 0x216888 (+0x8), SetVertexShaderConstantNotInline 0x2095C2 tests [0x216888]
+CDevice_Time              = 0x2C   # D3D_BlockOnNonSurfaceResource 0x20C499 reads [edx+0x2C], SetTexture 0x2082F3 & SetStreamSource 0x20962A read +0x2C
+CDevice_PixelShader       = 0x784  # D3DDevice_SetPixelShader 0x209BC8 reads / 0x209BD8 stores [ebx+0x784]
+CDevice_VertexShader      = 0x794  # CDevice::Init 0x20DC2B stores FVF shader 0x218F10 at [ebx+0x794], D3DDevice_SetVertexShader 0x209A11 / 0x209A8E
+CDevice_BackBufferScale   = 0x96C  # frame buffer init 0x20D35B stores X scale float at [esi+0x96C], 0x20D374 Y scale at [esi+0x970]
+CDevice_Viewport          = 0xEE0  # D3DDevice_GetViewport 0x207509 copies 6 dwords from [eax+0xEE0], GetViewportOffsetAndScale 0x205CC5 reads +0xEE0..+0xEF4
+CDevice_ScreenSpaceOffset = 0xEF8  # D3DDevice_SetScreenSpaceOffset 0x208B03 stores x + 0.53125 at [esi+0xEF8], 0x208B13 y + 0.53125 at [esi+0xEFC]
+CDevice_AutoDepth         = 0x1A20 # frame buffer init 0x20D45A / 0x20D743 stores [esi+0x1A20], CDevice::Init 0x20DC59 reads [ebx+0x1A20]
+CDevice_VBlankCallback    = 0x1DB8 # VBlank ISR 0x20EE9E calls [miniport+0x190], miniport is at +0x1C28 (0x20D897 / 0x207333): 0x1C28 + 0x190 = 0x1DB8
+CDevice_VBlankEvent       = 0x1DBC # D3DDevice_BlockUntilVerticalBlank 0x207647 waits on +0x1DBC (0x20763B clears +0x1DC0), VBlank ISR 0x20EE91 signals [miniport+0x194]
+CDevice_DisplayFlags      = 0x1DDC # D3DDevice_GetDisplayFieldStatus 0x2086E2 tests [eax+0x1DDC], VBlank ISR 0x20EE3D tests [miniport+0x1B4]
+CDevice_VBlankCount       = 0x1DE8 # D3DDevice_GetDisplayFieldStatus 0x2086D5 reads [eax+0x1DE8], VBlank ISR 0x20EEA8 reads [miniport+0x1C0]
+CDevice_Field             = 0x1DF8 # D3DDevice_GetDisplayFieldStatus 0x2086EF reads [eax+0x1DF8], VBlank ISR 0x20EE64 reads [miniport+0x1D0]
+CDevice_GammaRamps        = 0x1E04 # D3DDevice_GetGammaRamp 0x2073C7 reads +0x1E04, D3DDevice_SetGammaRamp 0x207363 copies to [miniport+0x1DC]
+CDevice_GammaPending      = 0x2404 # D3DDevice_SetGammaRamp 0x207391 sets [miniport+0x7DC + index*4]: 0x1C28 + 0x7DC = 0x2404
+# D3D8 globals
+DirtyFlags_Texture     = 0x4800 # D3DDevice_SetTexture 0x208357 and D3DDevice_SetPixelShader 0x209BE6 OR 0x4800 into D3D_DirtyFlags (0x2163D8)
+TextureState_Stage     = 32     # D3DDevice_SetTextureStageStateNotInline 0x2066BB: shl ecx, 5 -> [stage * 32 + type] dwords at 0x2163E0
+Stream_Size            = 12     # D3DDevice_SetStreamSource 0x20961A: lea esi, [eax+eax*2]; shl esi, 2 -> n * 12 bytes
+Stream_Stride          = 0x0    # D3DDevice_SetStreamSource 0x209662 stores Stride at [esi+0x218D38] (+0x0 from D3D_Streams)
+Stream_Buffer          = 0x8    # D3DDevice_SetStreamSource 0x209668 stores vertex buffer at [esi+0x218D40] (+0x8 from D3D_Streams)
+PixelShader_Definition = 0x8    # D3DDevice_CreatePixelShader 0x209B91 stores definition pointer at [eax+0x8]
+# DSOUND
+CDirectSoundStream_Vtable  = 0x0   # XDK 5659/5849 invariant (all 29 linked DSOUND methods incl. CDirectSoundStream_Pause 0x249216 & FlushEx 0x249267 match 5849 byte-for-byte; ctor not linked in default.xbe)
+CDirectSoundStream_Vtable2 = 0x4   # XDK 5659/5849 invariant (secondary vtable at +0x4; ctor not linked in default.xbe)
