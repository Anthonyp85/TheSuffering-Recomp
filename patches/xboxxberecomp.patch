+struct WRange {
+    float near_w;
+    float far_w;
+};
+
+WRange ProjectionWRange(const float* m) {
+    float m33 = m[10], m34 = m[11], m43 = m[14], m44 = m[15];
+    if (m33 == m34 || m33 == 0) return {0, 1};
+    return {m44 - m43 / m33 * m34, (m44 - m43) / (m33 - m34) * m34 + m44};
+}
+
+WRange DrawWRange(const State& s, bool program) {
+    WRange r{0, s.zscale};
+    if (!program) {
+        r = ProjectionWRange(s.transforms[3].data());
+    } else if (SimpleState(s, 0x398)) {
+        r.near_w = Bits(SimpleState(s, 0x394));
+    }
+    if (r.near_w <= 0 || r.near_w >= r.far_w) r.near_w = r.far_w * (1.0f / 65536.0f);
+    return r;
+}
+
+// Per stage (4 bits each, input register 1..15, 0 when transformed or unwritten): the vertex input register an NV2A
+// vertex program copies straight into oT0..oT3.xy without scaling, scrolling, swizzling, negation, or projection.
+uint16_t PassthroughTexcoords(const std::vector<uint32_t>& prog) {
+    auto field = [](const uint32_t* t, int sub, int bit, int len) -> uint32_t {
+        return (t[sub] >> bit) & ((1u << len) - 1u);
+    };
+    bool bad[4] = {};
+    uint8_t wrote_xy[4] = {};
+    int src_reg[4] = {-1, -1, -1, -1};
+    for (size_t n = 0; n + 4 <= prog.size(); n += 4) {
+        const uint32_t* t = &prog[n];
+        uint32_t mac = field(t, 1, 21, 4);
+        uint32_t ilu = field(t, 1, 25, 3);
+        uint32_t omask = field(t, 3, 12, 4);
+        bool use_ilu = field(t, 3, 2, 1) == 1u;
+        if (omask && field(t, 3, 11, 1) && ((use_ilu && ilu) || (!use_ilu && mac && mac != 13u))) {
+            uint32_t o = field(t, 3, 3, 8) & 0xFu;
+            if (o >= 9u && o <= 12u) {
+                uint32_t s = o - 9u;
+                bool is_mov = use_ilu ? (ilu == 1u) : (mac == 1u);
+                uint32_t mux = use_ilu ? field(t, 3, 28, 2) : field(t, 2, 26, 2);
+                uint32_t neg = use_ilu ? field(t, 2, 10, 1) : field(t, 1, 8, 1);
+                uint32_t sw0 = use_ilu ? field(t, 2, 8, 2) : field(t, 1, 6, 2);
+                uint32_t sw1 = use_ilu ? field(t, 2, 6, 2) : field(t, 1, 4, 2);
+                uint32_t sw2 = use_ilu ? field(t, 2, 4, 2) : field(t, 1, 2, 2);
+                uint32_t sw3 = use_ilu ? field(t, 2, 2, 2) : field(t, 1, 0, 2);
+                uint32_t vin = field(t, 1, 9, 4);
+                bool ok = is_mov && mux == 2u && neg == 0u && vin >= 1u && vin <= 15u &&
+                          (!(omask & 8u) || sw0 == 0u) && (!(omask & 4u) || sw1 == 1u) &&
+                          (!(omask & 2u) || sw2 == 2u) && (!(omask & 1u) || sw3 == 3u) &&
+                          (src_reg[s] < 0 || src_reg[s] == int(vin));
+                if (!ok) {
+                    bad[s] = true;
+                } else {
+                    src_reg[s] = int(vin);
+                    wrote_xy[s] |= uint8_t(omask & 0xCu);
+                }
+            }
+        }
+        if (field(t, 3, 0, 1)) break;
+    }
+    uint16_t out = 0;
+    for (int s = 0; s < 4; ++s) {
+        if (!bad[s] && wrote_xy[s] == 0xCu && src_reg[s] > 0) {
+            out |= uint16_t(uint32_t(src_reg[s]) << (s * 4));
+        }
+    }
+    return out;
+}
+
+uint16_t UnitTexcoordRegs(const Assembled& a) {
+    constexpr float kLo = -1e-4f, kHi = 1.0001f;
+    constexpr uint32_t kSmallDrawVertices = 4096;
+    if (!a.vertices.empty() || !a.vertex_count || a.vertex_count > kSmallDrawVertices) return 0;
+    uint16_t mask = 0;
+    for (int r = 1; r < 16; r++) {
+        const VertexElement& e = a.elements[size_t(r)];
+        if (!(a.regs >> r & 1) || e.format != DXGI_FORMAT_R32G32_FLOAT) continue;
+        const VertexBuffer& vb = a.buffers[e.buffer];
+        if (!vb.src || !vb.stride || uint64_t(a.vertex_count) * vb.stride > vb.bytes) continue;
+        bool unit = true;
+        for (uint32_t v = 0; v < a.vertex_count; v++) {
+            float uv[2];
+            std::memcpy(uv, vb.src + size_t(v) * vb.stride + e.offset, sizeof(uv));
+            if (!(uv[0] >= kLo && uv[0] <= kHi && uv[1] >= kLo && uv[1] <= kHi)) {
+                unit = false;
+                break;
+            }
+        }
+        if (unit) mask |= uint16_t(1u << r);
+    }
+    return mask;
+}
+
+bool AnyStageWraps(const State& s) {
+    for (const auto& t : s.tss)
+        if (t[kTssAddressU] == kTaddressWrap || t[kTssAddressV] == kTaddressWrap) return true;
+    return false;
+}
+
+uint8_t StageClampMask(const State& s, const Assembled& a, const DrawShaders& sh, uint16_t pass_tc) {
+    if (!AnyStageWraps(s)) return 0;
+    uint16_t unit_regs = UnitTexcoordRegs(a);
+    if (!unit_regs) return 0;
+    uint8_t mask = 0;
+    if (sh.prog) {
+        if (sh.sprite) return 0;
+        for (int i = 0; i < 4; ++i) {
+            uint32_t r = (pass_tc >> (i * 4)) & 0xFu;
+            if (r && ((unit_regs >> r) & 1u)) mask |= uint8_t(1u << i);
+        }
+        return mask;
+    }
+    for (int i = 0; i < 4; ++i) {
+        const auto& t = s.tss[size_t(i)];
+        bool transformed = !a.pretransformed && (((t[kTssTexCoordIndex] >> 16) & 7u) || (t[kTssTextureTransformFlags] & 7u));
+        uint32_t r = 9u + (t[kTssTexCoordIndex] & 3u);
+        if (!transformed && ((unit_regs >> r) & 1u)) mask |= uint8_t(1u << i);
+    }
+    return mask;
+}
+
+bool SpriteOnStage3(const State& s, uint32_t prim) {
+    bool prog = (s.vs_handle & 1) && s.vs && !s.vs->program.empty();
+    bool stage3 = s.tss[kSpriteStage][kTssColorOp] != kTopDisable;
+    return prim == kPointList && prog && !s.ps && s.rs[kRsPointSpriteEnable] && stage3;
+}
+
+State SpriteStageZero(const State& s) {
+    State moved = s;
+    moved.tss[0] = s.tss[kSpriteStage];
+    moved.textures[0] = s.textures[kSpriteStage];
+    moved.palettes[0] = s.palettes[kSpriteStage];
+    for (int i = 1; i < 4; i++) {
+        moved.tss[i][kTssColorOp] = kTopDisable;
+        moved.tss[i][kTssAlphaOp] = kTopDisable;
+        moved.textures[i] = 0;
+    }
+    return moved;
+}
