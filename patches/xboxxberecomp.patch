+        std::ifstream f(game.dir / name, std::ios::binary);
+        if (f) {
+            out.assign(std::istreambuf_iterator<char>(f), {});
+            return true;
+        }
+    }
+    const kernel::Disc* disc = kernel::MountedDisc();
+    return disc && disc->Load(name, out);
+}
+
+std::vector<Target> StaleTargets(const GameFiles& game, std::vector<Image>& images) {
+    std::vector<Target> stale;
+    for (Image& image : images) {
+        Target target{&image, {}, {}};
+        if (!ReadXbe(game, image.xbe.c_str(), target.xbe)) {
+            LOGR("Game code: no %s in the game files, %s is not built", image.xbe.c_str(), image.exe.c_str());
+            continue;
+        }
+        image.config = ConfigFor(image.xbe, target.xbe);
+        if (!StampFor(image, target.xbe, target.stamp) || Current(target)) continue;
+        stale.push_back(std::move(target));
+    }
+    return stale;
+}
+
+struct Job {
+    fs::path source;
+    fs::path object;
+    uint64_t bytes = 0;
+};
+
+uint32_t PartitionCount(const Image& image) {
+    try {
+        toml::table t = toml::parse_file(image.config.string());
+        return uint32_t(t["xbe"]["partitions"].value_or(int64_t(0)));
+    } catch (const toml::parse_error&) {
+        return 0;
+    }
+}
+
+fs::file_time_type SharedInputsTime(const Image& image) {
+    std::error_code ec;
+    fs::file_time_type newest = fs::last_write_time(WorkDir(image) / "x86_recomp_shared.h", ec);
+    newest = std::max(newest, fs::last_write_time(CompilerDir() / "clang", ec));
+    for (auto& e : fs::recursive_directory_iterator(CompilerDir() / "include", ec))
+        newest = std::max(newest, e.last_write_time(ec));
+    return newest;
+}
+
+void AddJobs(const Image& image, std::vector<Job>& jobs) {
+    fs::path work = WorkDir(image);
+    std::vector<std::string> names{"x86_func_mapping"};
+    for (uint32_t i = 0; i < PartitionCount(image); ++i) names.push_back("x86_recomp." + std::to_string(i));
+    fs::file_time_type shared = SharedInputsTime(image);
+    for (const std::string& name : names) {
+        Job job{work / (name + ".cpp"), work / (name + ".o")};
+        std::error_code ec;
+        job.bytes = fs::file_size(job.source, ec);
+        fs::file_time_type built = fs::last_write_time(job.object, ec);
+        if (!ec && built > shared && built > fs::last_write_time(job.source, ec)) continue;
+        jobs.push_back(std::move(job));
+    }
+}
+
+void ReadMemInfo(uint64_t& total_bytes, uint64_t& avail_bytes) {
+    total_bytes = 0;
+    avail_bytes = 0;
+    std::ifstream f("/proc/meminfo");
+    std::string line;
+    while (std::getline(f, line)) {
+        unsigned long long kb = 0;
+        if (line.rfind("MemTotal:", 0) == 0 && std::sscanf(line.c_str() + 9, "%llu", &kb) == 1)
+            total_bytes = kb * 1024ull;
+        else if (line.rfind("MemAvailable:", 0) == 0 && std::sscanf(line.c_str() + 13, "%llu", &kb) == 1)
+            avail_bytes = kb * 1024ull;
+    }
+    if (!total_bytes) total_bytes = 8ull << 30;
+    if (!avail_bytes) avail_bytes = total_bytes / 2;
+}
+
+size_t CliOrEnvCompileJobs() {
+    if (const char* v = std::getenv("XBE_COMPILE_JOBS"); v && *v) {
+        int n = std::atoi(v);
+        if (n > 0) return size_t(n);
+    }
+    auto args = ReadCmdline();
+    for (size_t i = 1; i < args.size(); ++i) {
+        if (args[i] == "--compile-jobs" && i + 1 < args.size()) {
+            int n = std::atoi(args[i + 1].c_str());
+            if (n > 0) return size_t(n);
+        } else if (args[i].rfind("--compile-jobs=", 0) == 0) {
+            int n = std::atoi(args[i].c_str() + 15);
+            if (n > 0) return size_t(n);
+        }
+    }
+    return 0;
+}
+
+size_t ComputeCompileSlots() {
+    if (size_t ov = CliOrEnvCompileJobs(); ov > 0) return std::clamp<size_t>(ov, 1, 64);
+    uint64_t total = 0, avail = 0;
+    ReadMemInfo(total, avail);
+    uint64_t reserve = std::clamp<uint64_t>(total / 4, 512ull << 20, kMaxOsReserve);
+    uint64_t usable = avail > reserve ? (avail - reserve) : 0;
+    size_t by_memory = std::max<size_t>(1, size_t(usable / kJobMemory));
+    long ncpu = sysconf(_SC_NPROCESSORS_ONLN);
+    size_t cpus = ncpu > 0 ? size_t(ncpu) : 1;
+    size_t by_cpu = cpus <= 2 ? 1 : (cpus <= 6 ? cpus - 1 : cpus - 2);
+    return std::clamp<size_t>(std::min(by_memory, by_cpu), 1, kMaxCompileSlots);
+}
+
+class Processes {
+public:
+    Processes() {
+        std::error_code ec;
+        fs::create_directories(CompileLog().parent_path(), ec);
+        log_fd_ = ::open(CompileLog().c_str(), O_CREAT | O_WRONLY | O_TRUNC | O_APPEND | O_CLOEXEC, 0644);
+    }
+    ~Processes() {
+        Cancel();
+        if (log_fd_ >= 0) ::close(log_fd_);
+    }
+
+    pid_t Start(const std::vector<std::string>& argv, const fs::path& dir) {
+        if (argv.empty()) return -1;
+        pid_t pid = ::fork();
+        if (pid < 0) {
+            LOGE("game code: fork() failed for %s (%d)", argv[0].c_str(), errno);
+            return -1;
+        }
+        if (pid == 0) {
+            (void)::setpgid(0, 0);
+            (void)::nice(5);
+            if (!dir.empty() && ::chdir(dir.c_str()) != 0) _exit(126);
+            if (log_fd_ >= 0) {
+                (void)::dup2(log_fd_, STDOUT_FILENO);
+                (void)::dup2(log_fd_, STDERR_FILENO);
+                ::close(log_fd_);
+            }
+            std::vector<char*> ptrs;
+            ptrs.reserve(argv.size() + 1);
+            for (const std::string& a : argv) ptrs.push_back(const_cast<char*>(a.c_str()));
+            ptrs.push_back(nullptr);
+            ::execv(argv[0].c_str(), ptrs.data());
+            _exit(127);
+        }
+        (void)::setpgid(pid, pid);
+        active_.push_back(pid);
+        return pid;
+    }
+
+    void Forget(pid_t pid) {
+        active_.erase(std::remove(active_.begin(), active_.end(), pid), active_.end());
+    }
+
+    bool WaitAll(const std::vector<pid_t>& pids, std::vector<int>& exit_codes) {
+        exit_codes.assign(pids.size(), -1);
+        size_t remaining = pids.size();
+        while (remaining > 0) {
+            if (g_progress.cancel) return Cancel();
+            bool any = false;
+            for (size_t i = 0; i < pids.size(); ++i) {
+                if (exit_codes[i] != -1) continue;
+                int st = 0;
+                pid_t r = ::waitpid(pids[i], &st, WNOHANG);
+                if (r == pids[i]) {
+                    exit_codes[i] = WIFEXITED(st) ? WEXITSTATUS(st) : 128 + WTERMSIG(st);
+                    Forget(pids[i]);
+                    remaining--;
+                    any = true;
+                }
+            }
+            if (!any && remaining > 0) std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        }
+        return true;
+    }
+
+    bool Cancel() {
+        for (pid_t p : active_) (void)::kill(-p, SIGKILL);
+        for (pid_t p : active_) {
+            int st = 0;
+            while (::waitpid(p, &st, 0) < 0 && errno == EINTR) {
+            }
+        }
+        active_.clear();
+        return false;
+    }
+
+private:
+    int log_fd_ = -1;
+    std::vector<pid_t> active_;
+};
+
+bool Translate(std::vector<Target>& targets, Processes& run) {
+    std::vector<pid_t> pids;
+    for (Target& target : targets) {
+        fs::path work = WorkDir(*target.image);
+        fs::path xbe = work / target.image->xbe;
+        std::ofstream(xbe, std::ios::binary).write(reinterpret_cast<const char*>(target.xbe.data()), target.xbe.size());
+        std::vector<std::string> argv = {
+            (CompilerDir() / "xbe_recomp").string(),
+            target.image->config.string(),
+            xbe.string(),
+            work.string(),
+            "--xdk",
+            (CompilerDir() / "xdk").string(),
+        };
+        pid_t pid = run.Start(argv, work);
+        if (pid < 0) return RecordFailure("xbe_recomp could not be started.");
+        pids.push_back(pid);
+    }
+    std::vector<int> codes;
+    if (!run.WaitAll(pids, codes)) return false;
+    bool ok = true;
+    for (size_t i = 0; i < codes.size(); ++i) {
+        if (codes[i] != 0) ok = RecordFailure("Translating " + targets[i].image->xbe + " failed.");
+    }
+    return ok;
+}
+
+std::vector<std::string> CompileArgv(const Job& job) {
+    fs::path include = CompilerDir() / "include";
+    return {
+        (CompilerDir() / "clang").string(),
+        "--target=x86_64-unknown-linux-gnu",
+        "-std=c++20",
+        "-O2",
+        "-march=x86-64-v2",
+        "-fPIC",
+        "-fsemantic-interposition",
+        "-fno-strict-aliasing",
+        "-DNDEBUG",
+        "-DX86_GAME_CODE",
+        "-nostdinc",
+        "-nostdinc++",
+        "-w",
+        "-isystem",
+        (include / "freestanding").string(),
+        "-I" + include.string(),
+        "-c",
+        job.source.filename().string(),
+        "-o",
+        job.object.filename().string() + ".tmp",
+    };
+}
+
+bool FinishJob(const Job& job, int exit_code) {
+    std::string name = job.source.parent_path().filename().string() + "/" + job.source.filename().string();
+    if (exit_code != 0) return RecordFailure("Compiling " + name + " failed.");
+    fs::path temp = job.object;
+    temp += ".tmp";
+    std::error_code ec;
+    fs::rename(temp, job.object, ec);
+    if (ec) return RecordFailure("Saving the compiled " + name + " failed.");
+    g_progress.bytes_done += job.bytes;
+    g_progress.files_done++;
+    return true;
+}
+
+bool Compile(std::vector<Job>& jobs, Processes& run) {
+    std::sort(jobs.begin(), jobs.end(), [](const Job& a, const Job& b) { return a.bytes > b.bytes; });
+    size_t slots = ComputeCompileSlots();
+    uint64_t total_mem = 0, avail_mem = 0;
+    ReadMemInfo(total_mem, avail_mem);
+    LOGR("Game code: compiling %zu files, %zu at a time (avail_mem=%llu MB)", jobs.size(), slots,
+         (unsigned long long)(avail_mem >> 20));
+    for (const Job& job : jobs) g_progress.bytes_total += job.bytes;
+    g_progress.files_total = uint32_t(jobs.size());
+    g_progress.first_wave = uint32_t(std::min(slots, jobs.size()));
+    g_progress.compile_start = NowMs();
+    g_progress.stage = Stage::Compiling;
+
+    std::vector<pid_t> running;
+    std::vector<const Job*> running_jobs;
+    size_t next = 0;
+    while (next < jobs.size() || !running.empty()) {
+        for (; running.size() < slots && next < jobs.size(); ++next) {
+            if (!running.empty()) {
+                uint64_t t = 0, a = 0;
+                ReadMemInfo(t, a);
+                if (a < (1024ull << 20)) break;
+            }
+            pid_t pid = run.Start(CompileArgv(jobs[next]), jobs[next].source.parent_path());
+            if (pid < 0) {
+                RecordFailure("clang could not be started.");
+                return run.Cancel();
+            }
+            running.push_back(pid);
+            running_jobs.push_back(&jobs[next]);
+        }
+        if (g_progress.cancel) return run.Cancel();
+        bool any = false;
+        for (size_t i = 0; i < running.size();) {
+            int st = 0;
+            pid_t r = ::waitpid(running[i], &st, WNOHANG);
+            if (r == running[i]) {
+                int code = WIFEXITED(st) ? WEXITSTATUS(st) : 128 + WTERMSIG(st);
+                run.Forget(running[i]);
+                if (!FinishJob(*running_jobs[i], code)) return run.Cancel();
+                running.erase(running.begin() + ptrdiff_t(i));
+                running_jobs.erase(running_jobs.begin() + ptrdiff_t(i));
+                any = true;
+            } else {
+                ++i;
+            }
+        }
+        if (!any) std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
+    return true;
+}
+
+bool Link(const Target& target, Processes& run) {
+    const Image& image = *target.image;
+    fs::path work = WorkDir(image);
+    fs::path out_so = CodeLib(image);
+    std::vector<std::string> argv = {
+        (CompilerDir() / "ld.lld").string(),
+        "-shared",
+        "-m",
+        "elf_x86_64",
+        "--eh-frame-hdr",
+        "--allow-shlib-undefined",
+        "--icf=none",
+        "-o",
+        out_so.string(),
+        "x86_func_mapping.o",
+    };
+    for (uint32_t i = 0; i < PartitionCount(image); ++i)
+        argv.push_back("x86_recomp." + std::to_string(i) + ".o");
+    pid_t pid = run.Start(argv, work);
+    if (pid < 0) return RecordFailure("ld.lld could not be started.");
+    std::vector<int> codes;
+    if (!run.WaitAll({pid}, codes)) return false;
+    if (codes[0] != 0) return RecordFailure("Linking " + out_so.filename().string() + " failed.");
+    std::ofstream(StampFile(image)) << target.stamp << "\n";
+    return true;
+}
+
+bool Build(std::vector<Target>& targets) {
+    Processes run;
+    if (!Translate(targets, run)) return false;
+    std::vector<Job> jobs;
+    for (const Target& target : targets) AddJobs(*target.image, jobs);
+    if (!Compile(jobs, run)) return false;
+    g_progress.stage = Stage::Linking;
+    for (const Target& target : targets)
+        if (!Link(target, run)) return false;
+    return true;
+}
+
+std::string Blocker(const std::vector<Target>& targets) {
+    for (const char* tool : {"clang", "ld.lld", "xbe_recomp"}) {
+        std::error_code ec;
+        if (!fs::exists(CompilerDir() / tool, ec))
+            return std::string("The compiler folder is missing ") + tool + ". Extract the whole release again, then start the game.";
+    }
+    for (const Target& target : targets) {
+        if (target.image->config.empty())
+            return "The compiler folder is missing config files. Extract the whole release again, then start the game.";
+        std::error_code ec;
+        fs::create_directories(WorkDir(*target.image), ec);
+        if (ec)
+            return "The game's folder cannot be written to. Move it somewhere writable.";
+    }
+    std::error_code ec;
+    auto sp = fs::space(CompilerDir(), ec);
+    if (!ec && sp.available < kDiskNeeded)
+        return "Preparing the game needs 1 GB of free space on the drive it is on.";
+    return {};
+}
+
+std::string StageText() {
+    switch (g_progress.stage.load()) {
+        case Stage::Translating:
+            return "Translating the game's code";
+        case Stage::Compiling:
+            return "Compiling the game's code, file " +
+                   std::to_string(std::min(g_progress.files_done.load() + 1, g_progress.files_total.load())) +
+                   " of " + std::to_string(g_progress.files_total.load());
+        case Stage::Linking:
+            return "Linking the game's code";
+        default:
+            return "Start the game now?";
+    }
+}
+
+std::string TimeLeftText() {
+    if (g_progress.stage != Stage::Compiling) return {};
+    uint64_t done = g_progress.bytes_done;
+    if (g_progress.files_done < g_progress.first_wave || !done) return "Working out the time left...";
+    double elapsed = double(NowMs() - g_progress.compile_start);
+    double left = elapsed * double(g_progress.bytes_total - done) / double(done);
+    int minutes = int(left / 60000.0 + 0.5);
+    if (minutes < 1) return "Less than a minute left";
+    return "About " + std::to_string(minutes) + (minutes == 1 ? " minute left" : " minutes left");
+}
+
+float Fraction() {
+    switch (g_progress.stage.load()) {
+        case Stage::Translating:
+            return 0.0f;
+        case Stage::Compiling:
+            return g_progress.bytes_total ? float(g_progress.bytes_done) / float(g_progress.bytes_total) : 0.0f;
+        default:
+            return 1.0f;
+    }
+}
+
+uint64_t CompilerBytes() {
+    uint64_t bytes = 0;
+    std::error_code ec;
+    for (auto& e : fs::recursive_directory_iterator(CompilerDir(), ec))
+        if (e.is_regular_file(ec)) bytes += e.file_size(ec);
+    return bytes;
+}
+
+void DeleteCompiler() {
+    std::error_code ec;
+    fs::remove_all(CompilerDir(), ec);
+    if (ec) LOGE("Game code: deleting the compiler folder failed: %s", ec.message().c_str());
+    else LOGR("Game code: compiler folder deleted");
+}
+
+std::string CompileLogTail() {
+    constexpr size_t kTailBytes = 1500;
+    std::ifstream f(CompileLog(), std::ios::binary | std::ios::ate);
+    if (!f) return {};
+    std::streamoff size = f.tellg();
+    std::streamoff start = size > std::streamoff(kTailBytes) ? size - std::streamoff(kTailBytes) : 0;
+    std::string tail(size_t(size - start), '\0');
+    f.seekg(start);
+    f.read(tail.data(), std::streamsize(tail.size()));
+    if (start) tail.erase(0, tail.find('\n') + 1);
+    return tail;
+}
+
+void ShowFailure(bool interactive) {
+    std::string text = "Preparing the game failed. " + g_failure;
+    if (std::string tail = CompileLogTail(); !tail.empty()) text += "\n\nThe last lines of the log:\n\n" + tail;
+    text += "\n\nThe full details are in logs/compile.log.";
+    LOGE("%s", text.c_str());
+    if (interactive) {
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, WideToUtf8Simple(kGame.title).c_str(), text.c_str(), nullptr);
+    }
+}
+
+bool BuildWithWindow(std::vector<Target>& targets) {
+    const bool auto_start = AutoStartRequested();
+    const bool headless = auto_start || !HasDisplay();
+    if (std::string blocker = Blocker(targets); !blocker.empty()) {
+        LOGE("Game code: %s", blocker.c_str());
+        if (!headless) {
+            SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, WideToUtf8Simple(kGame.title).c_str(), blocker.c_str(), nullptr);
+        }
+        return false;
+    }
+
+    if (headless) {
+        LOGR("Game code: building headless (auto_start=%d)", auto_start ? 1 : 0);
+        bool ok = Build(targets);
+        if (!ok && !g_progress.cancel) ShowFailure(false);
+        return ok;
+    }
+
+    bool temp_video = false;
+    if (!SDL_WasInit(SDL_INIT_VIDEO)) {
+        if (!SDL_InitSubSystem(SDL_INIT_VIDEO)) {
+            bool ok = Build(targets);
+            if (!ok && !g_progress.cancel) ShowFailure(false);
+            return ok;
+        }
+        temp_video = true;
+    }
+    input::Init();
+    SDL_DisableScreenSaver();
+
+    std::string title = WideToUtf8Simple(kGame.title);
+    SDL_Window* win = SDL_CreateWindow(title.c_str(), 600, 190, SDL_WINDOW_HIGH_PIXEL_DENSITY);
+    SDL_Renderer* ren = win ? SDL_CreateRenderer(win, nullptr) : nullptr;
+    if (!ren && win) ren = SDL_CreateRenderer(win, "software");
+    if (!win || !ren) {
+        if (ren) SDL_DestroyRenderer(ren);
+        if (win) SDL_DestroyWindow(win);
+        SDL_EnableScreenSaver();
+        if (temp_video) SDL_QuitSubSystem(SDL_INIT_VIDEO);
+        bool ok = Build(targets);
+        if (!ok && !g_progress.cancel) ShowFailure(false);
+        return ok;
+    }
+
+    IMGUI_CHECKVERSION();
+    ImGuiContext* ctx = ImGui::CreateContext();
+    ImGui::SetCurrentContext(ctx);
+    ImGui::StyleColorsDark();
+    ImGuiStyle& st = ImGui::GetStyle();
+    st.Colors[ImGuiCol_WindowBg] = ImVec4(10.0f / 255.0f, 11.0f / 255.0f, 10.0f / 255.0f, 1.0f);
+    st.Colors[ImGuiCol_PlotHistogram] = ImVec4(145.0f / 255.0f, 158.0f / 255.0f, 130.0f / 255.0f, 1.0f);
+    st.Colors[ImGuiCol_FrameBg] = ImVec4(28.0f / 255.0f, 33.0f / 255.0f, 26.0f / 255.0f, 1.0f);
+    ImGui_ImplSDL3_InitForSDLRenderer(win, ren);
+    ImGui_ImplSDL3_SetGamepadMode(ImGui_ImplSDL3_GamepadMode_Manual, nullptr, 0);
+    ImGui_ImplSDLRenderer3_Init(ren);
+
+    std::atomic<bool> done{false};
+    bool ok = false;
+    std::thread worker([&] {
+        ok = Build(targets);
+        if (ok) {
+            g_compiler_bytes = CompilerBytes();
+            g_progress.stage = Stage::Ready;
+        }
+        done.store(true, std::memory_order_release);
+    });
+
+    bool running = true;
+    bool start_game = false;
+    uint16_t prev_pad = 0;
+    while (running) {
+        SDL_Event ev;
+        while (SDL_PollEvent(&ev)) {
+            ImGui_ImplSDL3_ProcessEvent(&ev);
+            if (ev.type == SDL_EVENT_QUIT || ev.type == SDL_EVENT_WINDOW_CLOSE_REQUESTED) {
+                if (g_progress.stage == Stage::Ready) {
+                    start_game = false;
+                    running = false;
+                } else {
+                    g_progress.cancel = true;
+                }
+            } else if (ev.type == SDL_EVENT_KEY_DOWN && g_progress.stage == Stage::Ready) {
+                if (ev.key.key == SDLK_RETURN || ev.key.key == SDLK_KP_ENTER) {
+                    start_game = true;
+                    running = false;
+                } else if (ev.key.key == SDLK_ESCAPE) {
+                    start_game = false;
+                    running = false;
+                } else if (ev.key.key == SDLK_SPACE) {
+                    g_delete_compiler = !g_delete_compiler;
+                }
+            }
+        }
+
+        if (done.load(std::memory_order_acquire) && !ok) {
+            running = false;
+            break;
+        }
+        if (g_progress.stage == Stage::Ready) {
+            uint16_t now_pad = input::HeldOnAnyController();
+            uint16_t pressed = now_pad & ~prev_pad;
+            prev_pad = now_pad;
+            if (pressed & 0x4000u) g_delete_compiler = !g_delete_compiler;  // X
+            if (pressed & 0x1000u) {
+                start_game = true;
+                running = false;
+            } else if (pressed & 0x2000u) {
+                start_game = false;
+                running = false;
+            }
+        }
+
+        ImGui_ImplSDLRenderer3_NewFrame();
+        ImGui_ImplSDL3_NewFrame();
+        ImGui::NewFrame();
+
+        int w = 0, h = 0;
+        SDL_GetWindowSize(win, &w, &h);
+        ImGui::SetNextWindowPos(ImVec2(0, 0));
+        ImGui::SetNextWindowSize(ImVec2(float(w), float(h)));
+        ImGui::Begin("##GameCodeProgress", nullptr,
