+constexpr uint64_t kPrewarmDeclSalt = 0x10000;
+constexpr uint64_t kPrewarmPretransSalt = 0x5A5A;
+constexpr uint64_t kPrewarmQuadSalt = 0xC3C30000;
+
+uint64_t ProgVsKey(uint64_t prog_hash, uint16_t regs, uint64_t decode, bool quad) {
+    uint64_t vkey = Hash(&decode, 8, prog_hash ^ regs);
+    if (quad) vkey ^= kPrewarmQuadSalt;
+    return vkey;
+}
+
+uint64_t FixedVsKey(uint32_t vs_handle, uint16_t regs, uint64_t decode, bool pretransformed, bool quad,
+                    const FixedKey& fk) {
+    uint64_t seed = Hash(&vs_handle, 4, regs | kPrewarmDeclSalt);
+    uint64_t vkey = Hash(&decode, 8, seed);
+    if (pretransformed) vkey ^= kPrewarmPretransSalt;
+    if (quad) vkey ^= kPrewarmQuadSalt;
+    return Hash(&fk, sizeof(fk), vkey);
+}
+
+void ApplyPsDefToState(State& s, const std::shared_ptr<PixelShader>& ps) {
+    s.ps = ps;
+    const uint32_t* d = ps->def;
+    for (int i = 0; i < 8; ++i) {
+        s.simple[(kMPsAlphaInputs + i * 4) >> 2] = d[0 + i];
+        s.simple[(kMPsConstant0 + i * 4) >> 2] = d[10 + i];
+        s.simple[(kMPsConstant1 + i * 4) >> 2] = d[18 + i];
+        s.simple[(kMPsAlphaOutputs + i * 4) >> 2] = d[26 + i];
+        s.simple[(kMPsRgbInputs + i * 4) >> 2] = d[34 + i];
+        s.simple[(kMPsRgbOutputs + i * 4) >> 2] = d[45 + i];
+    }
+    s.simple[kMPsFinalAbcd >> 2] = d[8];
+    s.simple[kMPsFinalEfgh >> 2] = d[9];
+    s.simple[kMPsCompareMode >> 2] = d[42];
+    s.simple[kMPsFinalConstant0 >> 2] = d[43];
+    s.simple[kMPsFinalConstant1 >> 2] = d[44];
+    s.simple[kMPsCombinerCount >> 2] = d[53];
+    s.simple[kMPsDotMapping >> 2] = d[55];
+    s.simple[kMPsInputTexture >> 2] = d[56];
+    s.rs[kRsPsTextureModes] = d[54];
+}
+
+}  // namespace
+
+std::vector<ShaderPrewarmItem> BuildGuestShaderPrewarmBatch(const std::vector<VertexShader>& vs_list,
+                                                            const std::vector<PixelShader>& ps_list,
+                                                            uint64_t pixel_key_salt) {
+    std::vector<ShaderPrewarmItem> out;
+    std::unordered_set<uint64_t> seen;
+    auto push_vs = [&](uint64_t prog_hash, const std::vector<uint32_t>& prog, uint16_t regs, uint64_t decode,
+                       bool also_quad) {
+        if (!regs || prog.empty()) return;
+        uint64_t k0 = ProgVsKey(prog_hash, regs, decode, false);
+        std::string base;
+        if (seen.insert(k0).second) {
+            base = ReversedDepthHlsl(VertexProgramHlsl(prog, regs, decode));
+            out.push_back(ShaderPrewarmItem{k0, false, base});
+        }
+        if (also_quad) {
+            uint64_t kq = ProgVsKey(prog_hash, regs, decode, true);
+            if (seen.insert(kq).second) {
+                if (base.empty()) base = ReversedDepthHlsl(VertexProgramHlsl(prog, regs, decode));
+                out.push_back(ShaderPrewarmItem{kq, false, QuadHlsl(base)});
+            }
+        }
+    };
+
+    for (const auto& vs : vs_list) {
+        if (vs.program.empty()) continue;
+        uint64_t prog_hash = vs.hash ? vs.hash : (Hash(vs.program.data(), vs.program.size() * 4) | 1ull);
+        uint16_t regs = 0, s0_regs = 0;
+        uint64_t raw_dec = 0, s0_dec = 0;
+        bool can_raw = false;
+        GuestVertexDecode(vs, regs, raw_dec, can_raw, &s0_regs, &s0_dec);
+        if (!regs) continue;
+        bool may_quad = std::popcount(regs) <= 2;
+        bool single_stream = (s0_regs == 0 || s0_regs == regs);
+        if (can_raw) {
+            push_vs(prog_hash, vs.program, regs, raw_dec, may_quad);
+        }
+        if (!can_raw || (raw_dec != 0 && single_stream && std::popcount(regs) <= 2)) {
+            push_vs(prog_hash, vs.program, regs, 0ull, may_quad);
+        }
+        if (s0_regs != 0 && s0_regs != regs) {
+            push_vs(prog_hash, vs.program, s0_regs, s0_dec, false);
+        }
+    }
+
+    for (const auto& ps_val : ps_list) {
+        auto ps_ptr = std::make_shared<PixelShader>(ps_val);
+        State s{};
+        ApplyPsDefToState(s, ps_ptr);
+        uint32_t tmodes = ps_val.def[54];
+        TexInfo t_swiz[4]{};
+        TexInfo t_rect0[4]{};
+        int active_stages = 0;
+        for (int i = 0; i < 4; ++i) {
+            uint32_t m = (tmodes >> (i * 5)) & 0x1Fu;
+            bool uses_2d = (m != 0 && m != 4 && m != 5 && m != 0xAu && m != 0x11u);
+            if (uses_2d) {
+                t_swiz[i].kind = (m == 2u) ? kTexCube : (m == 3u ? kTex3D : kTex2D);
+                t_rect0[i] = t_swiz[i];
+                ++active_stages;
+            }
+        }
+        if (t_rect0[0].kind == kTex2D) {
+            t_rect0[0].rect = 1;
+            t_rect0[0].flags = kTexTarget;
+        }
+        auto emit_pk = [&](const TexInfo ti[4], bool atest, bool quad) {
+            s.simple[kMAlphaTestEnable >> 2] = atest ? 1u : 0u;
+            PixelKey pk = MakePixelKey(s, ti);
+            pk.quad = quad ? 1u : 0u;
+            uint64_t key = Hash(&pk, sizeof(pk)) ^ pixel_key_salt;
+            if (seen.insert(key).second) {
+                out.push_back(ShaderPrewarmItem{key, true, PixelHlsl(pk)});
+            }
+        };
+        emit_pk(t_swiz, false, false);
+        emit_pk(t_swiz, true, false);
+        if (active_stages <= 2) {
+            emit_pk(t_swiz, false, true);
+            if (t_rect0[0].rect) {
+                emit_pk(t_rect0, false, true);
+                emit_pk(t_rect0, false, false);
+            }
+        }
+    }
+    return out;
+}
+
+std::vector<ShaderPrewarmItem> BuildCommonFixedShaderPrewarmBatch(uint64_t pixel_key_salt) {
+    std::vector<ShaderPrewarmItem> out;
+    std::unordered_set<uint64_t> seen;
+
+    // 1. Common D3D8 FVF fixed-function vertex shaders (2D UI/HUD/FMV XYZRHW + 3D unlit/lit geometry)
+    struct FvfSeed {
+        uint32_t fvf;
+        bool pretrans;
+        bool quad;
+        uint32_t light_flags;
+        uint32_t light_types;
+    };
+    static constexpr FvfSeed kFvfSeeds[] = {
+        {0x044u, true, true, 0u, 0u},    // XYZRHW | DIFFUSE (2D fades/boxes)
+        {0x144u, true, true, 0u, 0u},    // XYZRHW | DIFFUSE | TEX1 (2D UI, fonts, HUD, FMV)
+        {0x144u, true, false, 0u, 0u},   // XYZRHW | DIFFUSE | TEX1 (non-quad sprites/HUD strips)
+        {0x104u, true, true, 0u, 0u},    // XYZRHW | TEX1 (fullscreen blits/FMV)
+        {0x244u, true, true, 0u, 0u},    // XYZRHW | DIFFUSE | TEX2
+        {0x042u, false, false, 0u, 0u},  // XYZ | DIFFUSE (debug/lines/particles)
+        {0x142u, false, false, 0u, 0u},  // XYZ | DIFFUSE | TEX1 (unlit 3D decals/particles/sky)
+        {0x142u, false, true, 0u, 0u},   // XYZ | DIFFUSE | TEX1 (quad)
+        {0x102u, false, false, 0u, 0u},  // XYZ | TEX1
+        {0x242u, false, false, 0u, 0u},  // XYZ | DIFFUSE | TEX2 (lightmapped 3D)
+        {0x112u, false, false, 0u, 0u},  // XYZ | NORMAL | TEX1 (unlit)
+        {0x112u, false, false, 9u, 3u},  // XYZ | NORMAL | TEX1 (directional lit)
+        {0x152u, false, false, 0u, 0u},  // XYZ | NORMAL | DIFFUSE | TEX1 (unlit)
+        {0x152u, false, false, 0x109u, 3u},  // XYZ | NORMAL | DIFFUSE | TEX1 (lit vertex diffuse)
+    };
+    for (const auto& fs : kFvfSeeds) {
+        VertexShader vs{};
+        FvfInputs(fs.fvf, vs);
+        uint16_t regs = 0;
+        uint64_t dec = 0;
+        bool can_raw = false;
+        GuestVertexDecode(vs, regs, dec, can_raw);
+        if (!regs) continue;
+        State st{};
+        st.vs_handle = fs.fvf;
+        FixedKey fk = MakeFixedKey(st);
+        fk.light = fs.light_flags;
+        fk.types = fs.light_types;
+        uint64_t vk = FixedVsKey(fs.fvf, regs, can_raw ? dec : 0ull, fs.pretrans, fs.quad, fk);
+        if (seen.insert(vk).second) {
+            std::string hlsl = ReversedDepthHlsl(FixedVertexHlsl(regs, fs.pretrans, can_raw ? dec : 0ull, fk));
+            out.push_back(ShaderPrewarmItem{vk, false, fs.quad ? QuadHlsl(std::move(hlsl)) : std::move(hlsl)});
+        }
+    }
+
+    // 2. Common D3D8 fixed-function TextureStageState pixel shaders (UI, FMV, decals, opaque/alphatest 3D)
+    struct StageSeed {
+        uint32_t cop0, ca1_0, ca2_0, aop0, aa1_0, aa2_0;
+        uint8_t kind0, rect0;
+        uint32_t cop1, aop1;
+        bool alphatest;
+        bool quad;
+    };
+    // D3DTOP: 1=DISABLE, 2=SELECTARG1, 4=MODULATE, 5=MODULATE2X, 7=ADD; D3DTA: 0=DIFFUSE, 1=CURRENT, 2=TEXTURE, 3=TFACTOR
+    static constexpr StageSeed kPsSeeds[] = {
+        {2, 0, 1, 2, 0, 1, kTexNone, 0, 1, 1, false, true},   // Solid vertex diffuse quad (fades/bars)
+        {2, 0, 1, 2, 0, 1, kTexNone, 0, 1, 1, false, false},  // Solid vertex diffuse 3D
+        {2, 3, 1, 2, 3, 1, kTexNone, 0, 1, 1, false, true},   // Solid tfactor quad
+        {2, 2, 1, 2, 2, 1, kTex2D, 0, 1, 1, false, true},     // Texture-only 2D quad
+        {2, 2, 1, 2, 2, 1, kTex2D, 1, 1, 1, false, true},     // Linear/YUY2 FMV texture-only quad
+        {4, 2, 0, 4, 2, 0, kTex2D, 0, 1, 1, false, true},     // Modulate(tex, diffuse) 2D UI/HUD quad
+        {4, 2, 0, 4, 2, 0, kTex2D, 0, 1, 1, true, true},      // Modulate(tex, diffuse) alphatest UI/font quad
+        {4, 2, 0, 4, 2, 0, kTex2D, 1, 1, 1, false, true},     // Modulate(linear_tex, diffuse) splash/menu quad
+        {4, 2, 0, 4, 2, 0, kTex2D, 0, 1, 1, false, false},    // Modulate(tex, diffuse) standard 3D mesh/particles
+        {4, 2, 0, 4, 2, 0, kTex2D, 0, 1, 1, true, false},     // Modulate(tex, diffuse) alphatest 3D foliage/grates
+        {4, 2, 0, 2, 2, 0, kTex2D, 0, 1, 1, false, false},    // RGB modulate, Alpha = tex
+        {4, 2, 0, 2, 0, 0, kTex2D, 0, 1, 1, false, false},    // RGB modulate, Alpha = diffuse
+        {5, 2, 0, 4, 2, 0, kTex2D, 0, 1, 1, false, false},    // Modulate2X(tex, diffuse) 3D lit
+        {5, 2, 0, 4, 2, 0, kTex2D, 0, 1, 1, true, false},     // Modulate2X(tex, diffuse) alphatest
+        {4, 2, 3, 4, 2, 3, kTex2D, 0, 1, 1, false, true},     // Modulate(tex, tfactor) quad
+        {4, 2, 0, 4, 2, 0, kTex2D, 0, 4, 1, false, false},    // 2-stage Modulate lightmap
+        {4, 2, 0, 4, 2, 0, kTex2D, 0, 5, 1, false, false},    // 2-stage Modulate2X lightmap
+        {4, 2, 0, 4, 2, 0, kTex2D, 0, 7, 1, false, false},    // 2-stage Add detail/glow
+    };
+    for (const auto& ps : kPsSeeds) {
+        State st{};
+        st.tss[0][kTssColorOp] = ps.cop0;
+        st.tss[0][kTssColorArg1] = ps.ca1_0;
