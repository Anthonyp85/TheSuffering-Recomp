+                if (app::g_window && (scaled_ev.type == SDL_EVENT_MOUSE_MOTION ||
+                                      scaled_ev.type == SDL_EVENT_MOUSE_BUTTON_DOWN ||
+                                      scaled_ev.type == SDL_EVENT_MOUSE_BUTTON_UP)) {
+                    int lw = 0, lh = 0, pw = 0, ph = 0;
+                    SDL_GetWindowSize(app::g_window, &lw, &lh);
+                    SDL_GetWindowSizeInPixels(app::g_window, &pw, &ph);
+                    if (lw > 0 && lh > 0 && pw > 0 && ph > 0 && (lw != pw || lh != ph)) {
+                        float sx = float(pw) / float(lw);
+                        float sy = float(ph) / float(lh);
+                        if (scaled_ev.type == SDL_EVENT_MOUSE_MOTION) {
+                            scaled_ev.motion.x *= sx;
+                            scaled_ev.motion.y *= sy;
+                        } else {
+                            scaled_ev.button.x *= sx;
+                            scaled_ev.button.y *= sy;
+                        }
+                    }
+                }
+                std::lock_guard<std::recursive_mutex> lock(app::UiLock());
+                if (ImGui::GetCurrentContext()) {
+                    ImGui_ImplSDL3_ProcessEvent(&scaled_ev);
+                }
+            }
+
+            uintptr_t wp = (ev.type == SDL_EVENT_USER) ? static_cast<uintptr_t>(ev.user.code) : 0;
+            intptr_t result = 0;
+            bool handled = app::kGame.message &&
+                           app::kGame.message(app::g_window, ev.type, wp, reinterpret_cast<intptr_t>(&ev), &result);
+
+            if (is_close) {
+                quit = true;
+                break;
+            }
+            if (handled) continue;
+
+            if (ev.type >= SDL_EVENT_DISPLAY_FIRST && ev.type <= SDL_EVENT_DISPLAY_LAST) {
+                app::UpdateCachedRefreshHz();
+            } else if (app::g_refresh_dirty.load(std::memory_order_acquire)) {
+                app::UpdateCachedRefreshHz();
+            }
+            switch (ev.type) {
+                case SDL_EVENT_KEY_DOWN:
+                    if (ev.key.key == SDLK_F3 && !ev.key.repeat) app::DumpThreads();
+                    break;
+                case SDL_EVENT_WINDOW_FOCUS_LOST:
+                    audio::SetFocusMuted(app::Get().mute_unfocused);
+                    break;
+                case SDL_EVENT_WINDOW_FOCUS_GAINED:
+                    audio::SetFocusMuted(false);
+                    break;
+                case SDL_EVENT_WINDOW_MOVED:
+                case SDL_EVENT_WINDOW_RESIZED:
+                case SDL_EVENT_WINDOW_DISPLAY_CHANGED:
+                case SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED:
+                    app::UpdateCachedRefreshHz();
+                    break;
+                default:
+                    break;
+            }
+        } while (!quit && SDL_PollEvent(&ev));
+    }
+
+    app::g_running.store(false, std::memory_order_release);
+    d3d::FlushCaches();
+    perf::Shutdown();
+    logx::Flush();
+    if (app::g_window) {
+        SDL_SetWindowRelativeMouseMode(app::g_window, false);
+        SDL_DestroyWindow(app::g_window);
+        app::g_window = nullptr;
+    }
+    kernel::Shutdown(0);
+}
