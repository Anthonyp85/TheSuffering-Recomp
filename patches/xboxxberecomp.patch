+uint32_t Disc::ReadAt(uint64_t at, void* out, uint32_t len) const {
+    auto t0 = perf::Enabled() ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+    if (len == 0 || (size_ > 0 && at >= size_)) {
+        if (perf::Enabled()) {
+            double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+            perf::RecordDiscRead(0, ms);
+        }
+        return 0;
+    }
+    if (size_ > 0 && uint64_t(len) > size_ - at) len = uint32_t(size_ - at);
+
+    uint32_t total_got = 0;
+    if (!cache_ || len >= kCacheBypassBytes) {
+        total_got = ReadRawAt(at, out, len);
+    } else {
+        thread_local std::array<uint8_t, kCacheBlockSize> scratch;
+        auto* dst = static_cast<uint8_t*>(out);
+        uint64_t cur_at = at;
+        uint32_t rem = len;
+        while (rem > 0) {
+            const uint64_t block_idx = cur_at >> kCacheBlockShift;
+            const uint32_t off_in_block = uint32_t(cur_at & (kCacheBlockSize - 1u));
+            const uint32_t chunk = std::min<uint32_t>(rem, kCacheBlockSize - off_in_block);
+            BlockCache::Stripe& stripe = cache_->stripes[size_t(block_idx & (kCacheStripes - 1u))];
+
+            bool hit = false;
+            uint32_t avail = 0;
+            {
+                std::lock_guard<std::mutex> lock(stripe.mtx);
+                for (BlockCache::Slot& slot : stripe.slots) {
+                    if (slot.block_idx == block_idx) {
+                        slot.last_used = ++stripe.clock;
+                        if (off_in_block < slot.valid_len) {
+                            avail = std::min<uint32_t>(chunk, slot.valid_len - off_in_block);
+                            std::memcpy(dst + total_got, slot.data + off_in_block, avail);
+                        }
+                        hit = true;
+                        break;
+                    }
+                }
+            }
+            if (hit) {
+                total_got += avail;
+                if (avail < chunk) break;
+                cur_at += avail;
+                rem -= avail;
+                continue;
+            }
+
+            // Perform OS I/O outside the stripe mutex so concurrent threads never block on disk reads.
+            const uint64_t block_off = block_idx << kCacheBlockShift;
+            const uint32_t to_read =
+                (size_ > block_off) ? uint32_t(std::min<uint64_t>(kCacheBlockSize, size_ - block_off)) : kCacheBlockSize;
+            const uint32_t got_block = ReadRawAt(block_off, scratch.data(), to_read);
+            if (got_block == 0) break;
+
+            {
+                std::lock_guard<std::mutex> lock(stripe.mtx);
+                BlockCache::Slot* target = nullptr;
+                for (BlockCache::Slot& slot : stripe.slots) {
+                    if (slot.block_idx == block_idx) {
+                        target = &slot;
+                        break;
+                    }
+                }
+                if (!target) {
+                    target = &stripe.slots[0];
+                    for (BlockCache::Slot& slot : stripe.slots) {
+                        if (slot.block_idx == ~uint64_t(0)) {
+                            target = &slot;
+                            break;
+                        }
+                        if (slot.last_used < target->last_used) target = &slot;
+                    }
+                    std::memcpy(target->data, scratch.data(), got_block);
+                    target->block_idx = block_idx;
+                    target->valid_len = got_block;
+                }
+                target->last_used = ++stripe.clock;
+            }
+
+            if (off_in_block < got_block) {
+                avail = std::min<uint32_t>(chunk, got_block - off_in_block);
+                std::memcpy(dst + total_got, scratch.data() + off_in_block, avail);
+            }
+            total_got += avail;
+            if (avail < chunk) break;
+            cur_at += avail;
+            rem -= avail;
+        }
+    }
+
+    if (perf::Enabled()) {
+        double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        perf::RecordDiscRead(total_got, ms);
+    }
+    return total_got;
 }
 
