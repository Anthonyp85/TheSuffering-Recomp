+    std::string exports;
+    std::string aliases;
+    for (const char* table : {"X86FuncMappings", "X86Continuations", "X86CodeBase", "X86CodeEnd", "X86EntryPoint"})
+        exports += fmt("    %s DATA\n", table);
+    if (cfg.named) exports += "    X86Symbols DATA\n";
+    for (const std::string& name : export_funcs) {
+        exports += fmt("    __imp__%s\n", name.c_str());
+        aliases += fmt("    %s == __imp__%s\n", name.c_str(), name.c_str());
+    }
+    WriteIfChangedFile(out_dir / "imports.def", library + exports + aliases);
+    std::fprintf(stderr, "headers-only: wrote image_symbols.h, hook_exports.h, imports.def (%zu functions)\n",
+                 export_funcs.size());
+    return true;
+}
