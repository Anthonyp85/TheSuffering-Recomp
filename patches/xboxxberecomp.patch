+        st.tss[1][kTssColorArg1] = 2;
+        st.tss[1][kTssColorArg2] = 1;
+        st.tss[1][kTssAlphaOp] = ps.aop1;
+        st.tss[1][kTssAlphaArg1] = 2;
+        st.tss[1][kTssAlphaArg2] = 1;
+        st.tss[2][kTssColorOp] = 1;
